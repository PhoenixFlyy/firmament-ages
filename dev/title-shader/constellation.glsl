#if DATA_FROM_TEXTURE
vec4 nodeData(int i) {
    vec4 t = texelFetch(iChannel0, ivec2(i % 64, i / 64), 0) * 255.0;
    return vec4(t.x - 32.0, t.y, t.z - 32.0, t.w);
}
ivec2 edgeData(int e) {
    vec4 t = texelFetch(iChannel0, ivec2(e % 64, 4 + e / 64), 0) * 255.0;
    return ivec2(int(t.x + 0.5), int(t.y + 0.5));
}
#else
vec4 nodeData(int i) { return NODES[i]; }
ivec2 edgeData(int e) { return EDGES[e]; }
#endif
// vertical exaggeration: the shrine is 21 wide but only 5 high
vec3 nodePos(vec4 nd) { return nd.xyz * vec3(1.0, 1.9, 1.0); }

// ring k ignites at 8 + 9k s, holds, everything fades at 102..112 s, dark till 120 s
float ringLit(int k, float phase) {
    float t0 = 8.0 + 9.0 * float(k);
    return smoothstep(t0, t0 + 2.5, phase) * (1.0 - smoothstep(102.0, 112.0, phase));
}
float ringFlash(int k, float phase) {
    float dt = phase - (8.0 + 9.0 * float(k));
    return dt > 0.0 ? exp(-dt * 0.7) : 0.0;
}

const vec3 GOLD  = vec3(0.957, 0.839, 0.549);
const vec3 GHOST = vec3(0.70, 0.76, 1.00);
const vec3 HEART = vec3(1.00, 0.48, 0.10);
const float FOCAL = 1.55;
const float CAM_R = 52.0;
const float CAM_H = 20.0;

// ------------------------------------------------------------------ hashing / noise
float hash1(vec3 p) {
    p = fract(p * 0.1031);
    p += dot(p, p.yzx + 33.33);
    return fract((p.x + p.y) * p.z);
}
vec3 hash3(vec3 p) {
    p = vec3(dot(p, vec3(127.1, 311.7, 74.7)), dot(p, vec3(269.5, 183.3, 246.1)), dot(p, vec3(113.5, 271.9, 124.6)));
    return fract(sin(p) * 43758.5453123);
}
float vnoise(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float n000 = hash1(i), n100 = hash1(i + vec3(1, 0, 0)), n010 = hash1(i + vec3(0, 1, 0)), n110 = hash1(i + vec3(1, 1, 0));
    float n001 = hash1(i + vec3(0, 0, 1)), n101 = hash1(i + vec3(1, 0, 1)), n011 = hash1(i + vec3(0, 1, 1)), n111 = hash1(i + vec3(1, 1, 1));
    return mix(mix(mix(n000, n100, f.x), mix(n010, n110, f.x), f.y),
               mix(mix(n001, n101, f.x), mix(n011, n111, f.x), f.y), f.z);
}
float fbm(vec3 p) {
    float a = 0.5, s = 0.0;
    for (int i = 0; i < 5; i++) { s += a * vnoise(p); p = p * 2.03 + 11.7; a *= 0.5; }
    return s;
}

// ------------------------------------------------------------------ camera
vec3 g_cam, g_right, g_up, g_fwd;
void setupCamera(float t) {
    float a = t * 6.2831853 / ORBIT;
    g_cam = vec3(cos(a) * CAM_R, CAM_H + 1.6 * sin(t * 0.083), sin(a) * CAM_R);
    vec3 target = vec3(0.0, 2.5, 0.0);
    g_fwd = normalize(target - g_cam);
    g_right = normalize(cross(g_fwd, vec3(0.0, 1.0, 0.0)));
    g_up = cross(g_right, g_fwd);
}
// returns screen xy (uv units, height = 1) and view depth z
vec3 project(vec3 p) {
    vec3 v = p - g_cam;
    vec3 q = vec3(dot(v, g_right), dot(v, g_up), dot(v, g_fwd));
    return vec3(q.xy * (FOCAL / max(q.z, 0.1)), q.z);
}
float segDist(vec2 p, vec2 a, vec2 b, out float h) {
    vec2 pa = p - a, ba = b - a;
    h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-6), 0.0, 1.0);
    return length(pa - ba * h);
}

// ------------------------------------------------------------------ sky
vec3 rotY(vec3 v, float a) { float c = cos(a), s = sin(a); return vec3(c * v.x + s * v.z, v.y, -s * v.x + c * v.z); }

float starLayer(vec3 rd, float scale, float density, float t, float seed) {
    vec3 p = rd * scale;
    vec3 cell = floor(p);
    vec3 h = hash3(cell + seed);
    if (h.z > density) return 0.0;
    vec3 star = cell + 0.25 + 0.5 * h;                 // star direction inside its cell
    float d = length(normalize(star) - rd) * scale;    // angular distance in cell units
    float twinkle = 0.72 + 0.28 * sin(t * (1.5 + 3.0 * h.x) + h.y * 6.2831);
    float size = 0.035 + 0.075 * h.y * h.y * h.y;
    float core = smoothstep(size, 0.0, d);
    float halo = exp(-d * 12.0) * 0.10 * h.y;
    return (core + halo) * twinkle * (0.35 + 0.65 * h.x * h.x);
}

vec3 sky(vec3 rd, float t) {
    float up = clamp(rd.y, -1.0, 1.0);
    vec3 col = mix(vec3(0.075, 0.045, 0.15), vec3(0.015, 0.025, 0.075), smoothstep(-0.25, 0.55, up));
    // nebula: slow drifting fbm bands, violet and blue
    vec3 np = rd * 2.6 + vec3(t * 0.006, t * 0.004, 0.0);
    float n = fbm(np);
    float n2 = fbm(np * 1.7 + 4.0);
    float band = smoothstep(0.42, 0.75, n) * (0.35 + 0.65 * smoothstep(0.35, 0.7, n2));
    col += vec3(0.30, 0.14, 0.52) * band * 0.55 * (1.0 - 0.5 * smoothstep(0.1, 0.7, up));
    col += vec3(0.08, 0.22, 0.55) * smoothstep(0.5, 0.85, n2) * 0.30;
    // three star layers, each drifting at its own rate on top of the camera orbit
    float s = 0.0;
    s += starLayer(rotY(rd, t * 0.0030), 40.0, 0.16, t, 1.0) * 1.00;
    s += starLayer(rotY(rd, t * 0.0012), 80.0, 0.18, t, 2.0) * 0.55;
    s += starLayer(rotY(rd, -t * 0.0007), 140.0, 0.20, t, 3.0) * 0.30;
    col += vec3(0.9, 0.94, 1.0) * s;
    return col;
}

// ------------------------------------------------------------------ main
void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    float t = iTime;
#if PHASE_FROM_CLOCK
    float phase = float(fmUnixTimeSeconds % 120) + float(fmUnixTimeMilliseconds) * 0.001;
#else
    float phase = mod(t, CYCLE);
#endif
    vec2 uv = (fragCoord - 0.5 * iResolution.xy) / iResolution.y;
    uv.x -= 0.21;                                      // shrine sits right of the button column
    setupCamera(t);
    vec3 rd = normalize(g_fwd * FOCAL + g_right * uv.x + g_up * uv.y);
    vec3 col = sky(rd, t);

    // the shrine graph, ring by ring; a ring's loops only run for pixels inside its bounding circle
    vec3 graph = vec3(0.0);
    for (int k = 0; k < 9; k++) {
        vec3 ck = project(vec3(0.0, RING_BOUND[k].x, 0.0));
        float rk = RING_BOUND[k].y * FOCAL / ck.z + 0.05;
        if (length(uv - ck.xy) > rk) continue;
        float L = ringLit(k, phase), F = ringFlash(k, phase);
        vec3 lc = mix(GOLD, mix(GOLD, RING_COL[k], 0.35), L);
        float egain = 0.11 + 0.70 * L + 0.5 * F;
        vec3 nc = mix(GHOST, RING_COL[k], L);
        float ngain = 0.30 + 0.85 * L + 0.8 * F;
        for (int e = RING_EDGE_START[k]; e < RING_EDGE_START[k + 1]; e++) {
            ivec2 ed = edgeData(e);
            vec3 a = project(nodePos(nodeData(ed.x))), b = project(nodePos(nodeData(ed.y)));
            float h;
            float d = segDist(uv, a.xy, b.xy, h);
            float z = mix(a.z, b.z, h);
            float w = 0.0011 * (CAM_R / z);
            float line = smoothstep(w, w * 0.25, d);
            float glow = exp(-d / (w * 4.5)) * 0.35;
            graph += lc * (line + glow) * egain * clamp(CAM_R / z, 0.6, 1.4);
        }
        for (int i = RING_NODE_START[k]; i < RING_NODE_START[k + 1]; i++) {
            vec4 nd = nodeData(i);
            vec3 s = project(nodePos(nd));
            vec2 d = uv - s.xy;
            float dd = dot(d, d);
            float depth = CAM_R / s.z;
            float base = (i == 0) ? 0.0105 : (nd.y > 0.5 ? 0.0062 : 0.0046);
            float sz = base * depth;
            float core = exp(-dd / (sz * sz));
            float halo = exp(-sqrt(dd) / (sz * 4.0)) * 0.22;
            if (i == 0) {   // the heart
                graph += HEART * (core + halo * 2.0) * (1.2 + 0.35 * sin(t * 2.1) + 1.0 * F) * clamp(depth, 0.6, 1.4);
            } else {
                graph += nc * (core + halo) * ngain * clamp(depth, 0.6, 1.4);
            }
        }
    }
    col += graph;

    // ignition beam from the heart, in the ring's colour; steady soft beam while the shrine is complete
    {
        vec3 hb = project(vec3(0.0, 1.9, 0.0));
        vec3 ht = project(vec3(0.0, 30.0, 0.0));
        float h;
        float d = segDist(uv, hb.xy, ht.xy, h);
        float w = 0.018 * (CAM_R / hb.z);
        float prof = exp(-d * d / (w * w)) + 0.25 * exp(-d / (w * 3.0));
        float topFade = 1.0 - 0.75 * h;
        vec3 beam = vec3(0.0);
        for (int k = 0; k < 9; k++) beam += RING_COL[k] * ringFlash(k, phase);
        float complete = ringLit(8, phase) * smoothstep(84.0, 92.0, phase);
        beam += vec3(0.75, 0.70, 1.0) * 0.28 * complete * (0.85 + 0.15 * sin(t * 1.3));
        col += beam * prof * topFade;
    }

    // vignette + dither
    vec2 vq = (fragCoord / iResolution.xy - 0.5) * vec2(1.0, 1.1);
    col *= 1.0 - 0.55 * smoothstep(0.35, 0.95, length(vq));
    col += (hash1(vec3(fragCoord, t)) - 0.5) / 255.0;
    fragColor = vec4(clamp(col, 0.0, 1.0), 1.0);
}
