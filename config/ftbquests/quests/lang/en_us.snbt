	chapter.079BA6A3BF85646D.chapter_subtitle: ["Ore tripled, one network, the End."]
	chapter.079BA6A3BF85646D.title: "Information Age"
	chapter.12AE834BF6E07368.chapter_subtitle: ["High voltage, oil and aluminium."]
	chapter.12AE834BF6E07368.title: "Electric Age"
	chapter.172FAEFD3F2102E6.chapter_subtitle: ["Fission, rockets and draconium."]
	chapter.172FAEFD3F2102E6.title: "Space Age"
	chapter.1A21A4720E938BB6.chapter_subtitle: [
		"A Great Work of the Space Age: a rocket that rises from the ground."
	]
	chapter.1A21A4720E938BB6.title: "The Silo"
	chapter.1D01936AE318F34B.chapter_subtitle: ["The map opens. Iron veins become visible."]
	chapter.1D01936AE318F34B.title: "Iron Age"
	chapter.1ECA2119E26A0A06.chapter_subtitle: ["Clay, pit kilns and the first cast copper."]
	chapter.1ECA2119E26A0A06.title: "Stone Age"
	chapter.35C833E070507663.chapter_subtitle: ["A Great Work of the Iron Age: a house that moves for you."]
	chapter.35C833E070507663.title: "The Living House"
	chapter.40102C7AF88CF371.chapter_subtitle: [
		"A Great Work of the Bronze Age: a gate that shuts on its own."
	]
	chapter.40102C7AF88CF371.title: "The Gatehouse"
	chapter.40D4D715E3F4DB36.chapter_subtitle: ["Spirits, source and alchemy. The Nether opens."]
	chapter.40D4D715E3F4DB36.title: "Arcane Age"
	chapter.4472107CE8ED9B80.chapter_subtitle: ["Chaos, the Singularity and the gate."]
	chapter.4472107CE8ED9B80.title: "Singularity Age"
	chapter.544197C921D77FCB.chapter_subtitle: ["Prologue: stone, straw and the first spark."]
	chapter.544197C921D77FCB.title: "Dawn"
	chapter.5546E96FD2574ABB.chapter_subtitle: ["The first alloys. New veins can be found."]
	chapter.5546E96FD2574ABB.title: "Bronze Age"
	chapter.66BF343917FA056F.chapter_subtitle: ["Coke, black steel and the first FE."]
	chapter.66BF343917FA056F.title: "Industrial Age"
	chapter.795C8B99823402E1.chapter_subtitle: ["Fusion, antimatter and the inner planets."]
	chapter.795C8B99823402E1.title: "Quantum Age"
	chapter.7D0742BC787AAFAC.chapter_subtitle: [
		"Read me first. Then the whole road, from the first spark to the last."
	]
	chapter.7D0742BC787AAFAC.title: "The Firmament"
	chapter_group.7E30DFE764CF3EDD.title: "Great Works"
