// JourneyMap server configuration file. Modify at your own risk!
// Firmament Ages (round G1, Felix M1A 2026-10-17): no radar (players, villagers, animals, mobs) and no player
// tracking beyond render distance; every other value is JourneyMap's default and is written here on the first start.
// The map itself waits for the Iron Age on each client (firmages-core, firmages-client.toml [ui] mapFromAge).
{
  "radarEnabled": "NONE",
  "playerRadarEnabled": "false",
  "playerRadarNamesEnabled": "false",
  "villagerRadarEnabled": "false",
  "animalRadarEnabled": "false",
  "mobRadarEnabled": "false",
  "worldPlayerRadar": "NONE",
  "caveMapping": "ALL"
}
