		"X - - - X"
		"X - - - X"
		"X - - - X"
		"X X X X X"
		"- X X X -"
		""
		"Bowls, four at once:"
		"X - - - X"
		"- X X X -"
		"- - - - -"
		"X - - - X"
		"- X X X -"
		""
		"Large vessel, keeps food when sealed:"
		"X - - - X"
		"X - - - X"
		"X - - - X"
		"X - - - X"
		"X X X X X"
	]
	quest.6A272A1F4193488A.title: "Clay Patterns"
	quest.6A2C745F47AF776B.quest_desc: [
		"Set magnetite in wrought iron and right-click with the compass. It names the way to the nearest cold forge."
	]
	quest.6A2C745F47AF776B.title: "Frontier Compass"
	quest.6ABCB02049FE872B.quest_desc: ["Knap and fire a crucible. It mixes metals into alloys."]
	quest.6ABCB02049FE872B.title: "The Crucible"
	quest.6B502DAD3EAE52D5.quest_desc: [
		"The apprentice spellbook holds the stronger glyphs you need against the Wilden Chimera."
	]
	quest.6B502DAD3EAE52D5.title: "Apprentice Spellbook"
	quest.6B60917A5984A799.quest_desc: [
		"Fuse the awakened core. It is the catalyst of the Quantum Core."
	]
	quest.6B60917A5984A799.title: "Awakened Core"
	quest.6C112D72835F57BD.quest_desc: [
		"Crushing wheels turn ore pieces into dust for more metal per ore."
	]
	quest.6C112D72835F57BD.title: "Crushing Wheels"
	quest.6C6E95AB6ABD2B3E.quest_desc: ["The packager boxes items for the package network."]
	quest.6C6E95AB6ABD2B3E.title: "Packager"
	quest.6C89D8CCD3EEFE88.quest_desc: [
		"A gearbox with steel and precision mechanisms from the mechanical crafter, or with source gems by magic. Reinforced blast bricks and Pressure Cores need it."
	]
	quest.6C89D8CCD3EEFE88.title: "Arcane Gearbox"
	quest.6CBAA83920DDC925.quest_desc: [
		"Build the tier 3 rocket from ostrum. It reaches Venus and Mercury."
	]
	quest.6CBAA83920DDC925.title: "Tier 3 Rocket"
	quest.6DC5BE16C605C596.quest_desc: [
		"Make blue steel, the metal of the Information Age. Four sheets go into the Data Matrix, more into the inscriber presses."
	]
	quest.6DC5BE16C605C596.title: "Blue Steel"
	quest.6DE0808A3F92C2E7.quest_desc: [
		"Put the head on a stick. Your first pickaxe: now you can mine."
	]
	quest.6DE0808A3F92C2E7.title: "Copper Pickaxe"
	quest.6DE17D691978916D.quest_desc: [
		"Soak a hide in limewater, scrape it, then soak it in tannin."
	]
	quest.6DE17D691978916D.title: "Genuine Leather"
	quest.6E4438CCF1A5BF3D.quest_desc: [
		"Finish the shard on the deployer and the press. The Steel Heart needs the relic."
	]
	quest.6E4438CCF1A5BF3D.title: "Frontier Relic"
	quest.6F0E9B4D0BD4227A.quest_desc: [
		"Build a crusher and feed it ore pieces. It returns twice the metal as powder and dust, plus a by-product."
	]
	quest.6F0E9B4D0BD4227A.title: "Crusher"
	quest.6F9493CFB1887C79.quest_desc: [
		"Mine 16 raw desh on the Moon. It is the metal of the next rocket."
	]
	quest.6F9493CFB1887C79.title: "Desh"
	quest.71013FE9F62EC68E.quest_desc: [
		"Craft four chaotic injectors. Chaotic fusion, the highest tier, needs them."
	]
	quest.71013FE9F62EC68E.title: "Chaotic Injectors"
	quest.7124AA6401C814BF.quest_desc: ["Build the Dial Home Device. It dials the gate."]
	quest.7124AA6401C814BF.title: "Dial Home Device"
	quest.713ED981D14D9A4D.quest_desc: [
		"Build a fusion crafting core. It is the one pedestal crafting of the tech Ages."
	]
	quest.713ED981D14D9A4D.title: "Fusion Crafting Core"
	quest.716420BDBE218479.quest_desc: [
		"Fuse 16 awakened draconium from draconium blocks, a dragon heart and Nether Stars. Draconic gear and the reactor are made of it."
	]
	quest.716420BDBE218479.title: "Awakened Draconium"
	quest.71A054B30C7FB195.quest_desc: [
		"Train a data model to tier 3 (Superior) and keep it running in a simulation chamber."
	]
	quest.71A054B30C7FB195.title: "Data Model: Tier 3"
	quest.71AC4F9CCF7E6538.quest_desc: ["Certus quartz comes from its own vein."]
	quest.71AC4F9CCF7E6538.title: "Certus Quartz"
	quest.71B6B8FAE5353DAB.quest_desc: [
		"Build a charcoal forge:"
		"- Make a hole one block deep, lined with stone on its four sides and below."
		"- Right-click into it with charcoal until the pile is seven or eight layers high."
		"- Keep the sky open above it and light it with a firestarter."
		""
		"Right-click the forge: fuel goes below, the metal to heat above."
	]
	quest.71B6B8FAE5353DAB.title: "Forging"
	quest.724BED62EE9DF8FB.quest_desc: [
		"Craft a firestarter from two sticks. Throw a log, three sticks and some straw on one block and hold right-click on it with the firestarter until the firepit lights."
		""
		"Fire opens the Stone Age for all of you: clay, pit kilns and the first copper."
	]
	quest.724BED62EE9DF8FB.quest_subtitle: "Goal of Dawn: grants the Stone Age"
	quest.724BED62EE9DF8FB.title: "The First Spark"
	quest.72A1265F53716B52.quest_desc: [
		"The fabricator turns matrices into mob drops, boss drops included."
	]
	quest.72A1265F53716B52.title: "Loot Fabricator"
	quest.72A754A7D51FBA06.quest_desc: ["Galena veins are visible now. Lead goes into capacitors."]
	quest.72A754A7D51FBA06.title: "Lead"
	quest.72DBAB3B1C9E0AD4.quest_desc: ["Electrum wire carries medium voltage."]
	quest.72DBAB3B1C9E0AD4.title: "MV Wire"
	quest.72E155A942A5A2F6.quest_desc: ["Vacuum tubes are the first electronics."]
	quest.72E155A942A5A2F6.title: "Vacuum Tubes"
	quest.7317EE63A824831B.quest_desc: ["Craft a jetpack. It flies on compressed air from its tank."]
	quest.7317EE63A824831B.title: "Air Jetpack"
	quest.73CDE4A02F764C5D.quest_desc: [
		"Make 16 draconium ingots. The ore lies deep in granite, diorite and gabbro. Every fusion part is made of it."
	]
	quest.73CDE4A02F764C5D.title: "Draconium"
	quest.73D3949D8DE47C1A.quest_desc: [
		"Make four awakened draconium blocks. They are the reactor's first fuel."
	]
	quest.73D3949D8DE47C1A.title: "Reactor Fuel"
	quest.7448E77754C5FDAD.quest_desc: [
		"Till soil with a hoe and plant the seeds. Crops need water and time."
	]
	quest.7448E77754C5FDAD.title: "First Field"
	quest.7479AAADAC50C431.quest_desc: [
		"Write the Marid's name into a book of binding. Without it the Marid will not come."
	]
	quest.7479AAADAC50C431.title: "Book of Binding: Marid"
	quest.750293899E6D4B62.quest_desc: ["Silicon is printed into every processor."]
	quest.750293899E6D4B62.title: "Silicon"
	quest.7544B0CD7D29A814.quest_desc: ["Build the tier 4 rocket from calorite. It reaches Glacio."]
	quest.7544B0CD7D29A814.title: "Tier 4 Rocket"
	quest.7594B03DF7F3FE55.quest_desc: [
		"Build a bloomery from bronze double sheets and stone bricks."
	]
	quest.7594B03DF7F3FE55.title: "Ironworks"
	quest.759550A45990B3C8.quest_desc: [
		"Take the vessel out while it glows and right-click it. Put a fired mold in the slot; the copper pours in. Ten small pieces make one ingot."
		""
		"When the mold has cooled, right-click it to take the ingot out."
	]
	quest.759550A45990B3C8.title: "Copper Ingot"
	quest.7633534E257B8AD8.quest_desc: [
		"The alternator turns rotation into FE. It is the only bridge from SU to FE."
	]
	quest.7633534E257B8AD8.title: "Alternator"
	quest.77217628E2664B69.quest_desc: ["A black steel anvil works black steel double sheets."]
	quest.77217628E2664B69.title: "Black Steel Anvil"
	quest.772B64FC091E11AB.quest_desc: [
		"Two HV capacitors: one buffers your grid, one goes into the Humming Core."
	]
	quest.772B64FC091E11AB.title: "Grid Online"
	quest.774C554B16ACE98C.quest_desc: [
		"A classic Stargate takes one base block, nine chevron blocks and fourteen ring blocks. The Ultimate Singularity goes into the base block."
	]
	quest.774C554B16ACE98C.title: "Stargate Blocks"
	quest.7755ECDE0FFE3821.quest_desc: [
		"Craft it from a Hearth Idol (H), cobblestone (S) and charcoal (C):"
		"- C -"
		"S H S"
		"- S -"
		""
		"Leave 21 by 21 blocks free: each Age adds a ring."
	]
	quest.7755ECDE0FFE3821.title: "The Shrine Heart"
	quest.7794323527566501.quest_desc: ["Put a fired ceramic pot on the firepit and cook a soup."]
	quest.7794323527566501.title: "A Pot of Soup"
	quest.7883DC5AF7968152.quest_desc: [
		"Pray at the complete shrine with your fellowship. Caelum gives back the nine relics for the chaotic fusion."
	]
	quest.7883DC5AF7968152.title: "The Gathering"
	quest.7997DC1DFF73EA36.quest_desc: [
		"Make charcoal in a charcoal pit:"
		"- Sneak and right-click the ground with logs: a log pile. Right-click it with more logs."
		"- Cover every side with dirt, leave the top open and light it with a firestarter."
		"- Close the gap with dirt."
		""
		"When the smoke stops, dig the charcoal out with a shovel. The Shrine Heart and the Hearthstone need it."
	]
	quest.7997DC1DFF73EA36.title: "A Better Fuel"
	quest.79BD86B5CD663079.quest_desc: ["The alloy kiln alloys two metals in the right ratios."]
	quest.79BD86B5CD663079.title: "Alloy Kiln"
	quest.79DA4E6D4518762C.quest_desc: [
		"Mix deuterium and tritium into fusion fuel. It keeps the reactor burning."
	]
	quest.79DA4E6D4518762C.title: "Fusion Fuel"
	quest.7B0276B3AACDABA7.quest_desc: [
		"Craft four awakened injectors. Fusion at draconic level needs them."
	]
	quest.7B0276B3AACDABA7.title: "Awakened Injectors"
	quest.7CDF23C64D3D4961.quest_desc: [
		"Food rots. Sealed large vessels, salting, drying and cooking slow it down. Eat from every food group: grain, fruit, vegetables, protein and dairy."
	]
	quest.7CDF23C64D3D4961.title: "Food Decay and Nutrition"
	quest.7E2D0099177BFBE8.quest_desc: [
		"Every head goes above a stick in the crafting grid. X = leave standing, - = knock away. Mirrored shapes work too."
		""
		"Knife blades, two from one rock:"
		"X - - X -"
		"X X - X X"
		"X X - X X"
		"X X - X X"
		"X X - X X"
		""
