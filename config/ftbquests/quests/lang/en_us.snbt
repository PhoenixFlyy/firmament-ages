		"X X X X -"
		"X X X X X"
		"- X X X -"
		"- - X - -"
		""
		"There is no stone pickaxe. The first pickaxe is cast in copper in the Stone Age."
	]
	quest.7E2D0099177BFBE8.title: "Knapping Patterns"
	quest.7E4228F48F8BE9EF.quest_desc: [
		"Knap five clay into a vessel, a jug, a bowl or a mold (see \"Clay Patterns\")."
	]
	quest.7E4228F48F8BE9EF.title: "Clay Forming"
	quest.7ECFFB6EEDF1B9FB.quest_desc: ["Steel wire carries high voltage over long distances."]
	quest.7ECFFB6EEDF1B9FB.title: "HV Wire"
