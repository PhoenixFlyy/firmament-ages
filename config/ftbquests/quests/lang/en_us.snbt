	chapter_group.7E67E59034114849.title: "Ages"
	file.0000000000000001.title: "Firmament Ages"
	quest.0025DE3687DD8D07.quest_desc: [
		"Build a barrel with a saw and lumber. Barrels brine, pickle and tan."
	]
	quest.0025DE3687DD8D07.title: "Do a Barrel Roll!"
	quest.00276F8FDCF146F5.quest_desc: [
		"A storage terminal shows every connected chest in one screen."
	]
	quest.00276F8FDCF146F5.title: "Tom's Storage"
	quest.002A92F3E9C8D81F.quest_desc: ["Grow inferium and the resource seeds of unlocked materials."]
	quest.002A92F3E9C8D81F.title: "Mystical Agriculture"
	quest.00DEC03D1B329588.quest_desc: [
		"A Gateway in the Nether calls the Netherite Monstrosity. Its horn goes into the Pressure Core."
		"If the Gateway fails, the Summoning Rituals altar can call it too."
	]
	quest.00DEC03D1B329588.title: "Netherite Monstrosity"
	quest.00DFEEA122BF8999.quest_desc: [
		"The Draconic reactor can explode. Watch temperature and field strength and keep the shields"
		"fed. Refuel it only while it is cold."
	]
	quest.00DFEEA122BF8999.title: "The Reactor"
	quest.01630DB64B717FB5.quest_desc: [
		"Create Aeronautics builds flying machines. A propeller is the first part."
	]
	quest.01630DB64B717FB5.title: "Airship"
	quest.018153F3C0E3E923.quest_desc: ["The controller powers an ME network."]
	quest.018153F3C0E3E923.title: "ME Controller"
	quest.018A77CF29560891.quest_desc: [
		"Split water into hydrogen and oxygen. Hydrogen burns in the gas-burning generator."
	]
	quest.018A77CF29560891.title: "Electrolytic Separator"
	quest.01A60C077F4FEDFD.quest_desc: [
		"A spirit attuned crystal and iesnium: the proof of the Spirits strand."
		"Next, Dimensional Storage and the Mineshaft with a Djinni miner, which gives rich TFC ore pieces"
		"of every unlocked metal."
	]
	quest.01A60C077F4FEDFD.title: "Spirit Proof"
	quest.022B6F2B50E24B10.quest_desc: [
		"Build the Data Nave around the Tesla Crown: a 17 by 17 border of certus quartz blocks, steel"
		"casing bases, quartz glass two high and fluix block caps, with the seventh plinth in the"
		"middle of the north side."
	]
	quest.022B6F2B50E24B10.quest_subtitle: "Optional: the shrine ring of this Age"
	quest.022B6F2B50E24B10.title: "Raise the Data Nave"
	quest.02BAEBC0675BF246.quest_desc: [
		"Craft the Arcane Keystone in the Djinni crafting pentacle (bound Djinni book):"
		"a spirit attuned crystal, an iesnium ingot, the Wilden Tribute, the mercury catalyst,"
		"a TFC steel ingot and a source gem block."
		""
		"Grow the shrine by its fourth ring, the Spirit Circle: an 11 by 11 border of sourcestone,"
		"otherstone corner pillars with source gem block caps and eight candles on the border."
		"Use the heart with an empty hand to see the missing blocks."
		"Lay the Keystone on the new plinth, light the eight candles and pray at the heart."
		""
		"Caelum keeps the Arcane Keystone as a relic and opens the Industrial Age for the whole team."
	]
	quest.02BAEBC0675BF246.quest_subtitle: "Goal of the Arcane Age: Caelum opens the Industrial Age"
	quest.02BAEBC0675BF246.title: "Offer the Arcane Keystone at the Shrine"
	quest.03032ECD8B1864DC.quest_desc: [
		"The digital miner mines a whole area by filter. It is the way to the Naquadah of Age 9."
	]
	quest.03032ECD8B1864DC.title: "Digital Miner"
	quest.03A410CC86110162.quest_desc: [
		"Weak steel with nickel and black bronze, worked on the anvil: black steel, the Age 4 metal."
	]
	quest.03A410CC86110162.title: "Black Steel"
	quest.0416219650D02993.quest_desc: ["Summon the Wilden Chimera with its ritual and defeat it."]
	quest.0416219650D02993.title: "Wilden Chimera"
	quest.046444D7885EFB7E.quest_desc: [
		"Alternating Flux wire carries very high power with little loss."
	]
	quest.046444D7885EFB7E.title: "Alternating Flux"
	quest.04722DE2A3532A26.quest_desc: [
		"Datura fruit becomes Demon's Dream essence. It opens your third eye to the spirit world."
	]
	quest.04722DE2A3532A26.title: "Demon's Dream"
	quest.049A5B04B3B800F6.quest_desc: [
		"The MekaSuit and the Meka-Tool are trophies: they unlock only after the final boss falls."
	]
	quest.049A5B04B3B800F6.title: "After the Battle"
	quest.04AB34FB1FD2E8B6.quest_desc: [
		"Every Age chapter has one entry quest, three or four required strands and one goal."
		"Each strand ends in a keystone (the larger quests). The goal needs every keystone."
		"Round quests are side missions: optional, with a comfort reward."
		"Diamonds mark the optional ring quest: look at the shrine heart once the Age's ring stands."
		"Gears are explanations: tick them once you have read them."
	]
	quest.04AB34FB1FD2E8B6.title: "Reading a Chapter"
	quest.04DAC1D51AABFF20.quest_desc: [
		"The signature item of Age 1: Bronze Age. Details appear when the Age before it is done."
	]
	quest.04DAC1D51AABFF20.quest_subtitle: "Goal of Age 1: Bronze Age"
	quest.04DAC1D51AABFF20.title: "Sky Disc"
	quest.055D1D227906CC81.quest_desc: ["The LV capacitor stores FE and evens out the grid."]
	quest.055D1D227906CC81.title: "LV Capacitor"
	quest.05C4B3AE61613A9B.quest_desc: [
		"Iron veins are visible now, the map opens and the Twilight Forest can be reached."
		""
		"Four strands lead to the Steel Heart: Metallurgy, Power & Motion, Survival and Frontier."
	]
	quest.05C4B3AE61613A9B.quest_subtitle: "Age 2"
	quest.05C4B3AE61613A9B.title: "Welcome to the Iron Age"
	quest.06055D169B0CC629.quest_desc: [
		"Iesnium ore lies in the Nether. Smelt it into ingots; the Djinni rituals need it."
	]
	quest.06055D169B0CC629.title: "Iesnium"
	quest.063D45434D0281D0.quest_desc: [
		"A circuit board with a spirit attuned crystal: the magic tail of the Electric Age."
		"Let the assembler make them."
	]
	quest.063D45434D0281D0.title: "Attuned Circuits"
	quest.063F1A5EA37B6B16.quest_desc: [
		"Smith a prospector's pick on an anvil (Smithing strand). It finds ore through stone."
	]
	quest.063F1A5EA37B6B16.title: "Prospector"
	quest.0672AC049845AEE4.quest_desc: [
		"Your own tanned leather makes the first armor. Wear it before the first winter trip."
	]
	quest.0672AC049845AEE4.title: "Leather Armor"
	quest.06EDA9E3C94958CB.quest_desc: ["Evolved Mekanism adds the tiers above ultimate."]
	quest.06EDA9E3C94958CB.title: "Evolved Mekanism"
	quest.06FEAB3BC2EA4431.quest_desc: [
		"Theurgy heats its apparatus with a pyromantic brazier. Read the Hermetica as you go."
	]
	quest.06FEAB3BC2EA4431.title: "Pyromantic Brazier"
	quest.07205F9A9FA4E721.quest_desc: [
		"TFC has no strongholds. Your team builds its own End portal."
	]
	quest.07205F9A9FA4E721.title: "Eyes of Ender"
	quest.0725F0C2566548FA.quest_desc: ["The distiller makes mercury shards, the third principle."]
	quest.0725F0C2566548FA.title: "Distiller"
	quest.077BFA2D599B1A4B.quest_desc: [
		"The signature item of Age 3: Arcane Age. Details appear when the Age before it is done."
	]
	quest.077BFA2D599B1A4B.quest_subtitle: "Goal of Age 3: Arcane Age"
	quest.077BFA2D599B1A4B.title: "Arcane Keystone"
	quest.078E1C7A5241C1E9.quest_desc: [
		"The wyvern core is the heart of wyvern gear and of the Star Chart."
	]
	quest.078E1C7A5241C1E9.title: "Wyvern Core"
	quest.078F36B103C471CF.quest_desc: [
		"Drives hold the storage cells. AE2 is now the one storage network."
	]
	quest.078F36B103C471CF.title: "ME Drive"
	quest.07D42ECD95337D7C.quest_desc: [
		"Power a millstone from a water wheel. It grinds what the quern grinds by hand."
	]
	quest.07D42ECD95337D7C.title: "First Mill"
	quest.0869D302C86C0C86.quest_desc: ["One Evolved Mekanism alloy binds the relics together."]
	quest.0869D302C86C0C86.title: "Singular Alloy"
	quest.08C127DFAFB1D00D.quest_desc: ["Pump crude oil into tanks."]
	quest.08C127DFAFB1D00D.title: "Crude Oil"
	quest.08FA57541FB57841.quest_desc: [
		"Wire an alternator through LV connectors to a capacitor and run your machines from it."
	]
	quest.08FA57541FB57841.title: "Grid Online (LV)"
	quest.092749BAB246E72D.quest_desc: [
		"Feed the crusher by machine and collect 64 iron dust from the line."
	]
	quest.092749BAB246E72D.title: "Automated Ore Line"
	quest.0A55EE1E0335D077.quest_desc: [
		"Use a stone hammer on raw igneous rock to make a stone anvil."
	]
	quest.0A55EE1E0335D077.title: "Hammer Time"
	quest.0A81ED2F8A5BB2AE.quest_desc: [
		"Tin and zinc veins are visible now. Anvils, alloys and the first Create machines follow."
