	quest.00117100B6828250.quest_desc: [
		"Wear the robes of the elemancer. All four elements answer to the one who wears them."
	]
	quest.00117100B6828250.title: "Elemancer Robes"
	quest.001477EB265CFAF8.quest_desc: [
		"{image:firmages:textures/quests/device/firepit.png width:128 height:128 align:center}"
		""
		"Drop one log, three sticks and some straw on one block. Hold right-click on it with a firestarter (two sticks) until the firepit lights."
		""
		"Heat a stick in the firepit's right slot: it becomes two torches. A torch lights your way in hand; a placed torch burns about 36 minutes. Zombies and spiders walk at night."
	]
	quest.001477EB265CFAF8.title: "Before Dark"
	quest.00276F8FDCF146F5.quest_desc: [
		"Build a storage terminal and connect your chests. Every chest shows in one screen."
	]
	quest.00276F8FDCF146F5.title: "Storage Terminal"
	quest.00DFEEA122BF8999.quest_desc: [
		"The draconic reactor can explode. Watch temperature and field strength and keep the shields fed. Refuel it only while it is cold."
	]
	quest.00DFEEA122BF8999.title: "The Reactor"
	quest.0107BC143F361DE9.quest_desc: ["Grow a control crystal. Devices of the gate answer to it."]
	quest.0107BC143F361DE9.title: "Control Crystal"
	quest.01630DB64B717FB5.quest_desc: ["Craft a propeller, the first part of a ship that flies."]
	quest.01630DB64B717FB5.title: "Airship"
	quest.018153F3C0E3E923.quest_desc: ["The controller powers an ME network."]
	quest.018153F3C0E3E923.title: "ME Controller"
	quest.018A77CF29560891.quest_desc: [
		"Split water into hydrogen and oxygen. Hydrogen burns in the gas-burning generator."
	]
	quest.018A77CF29560891.title: "Electrolytic Separator"
	quest.019EA9CBCB2A6326.quest_desc: [
		"Something landed on Mars before you. Its temple keeps the record. The Star Chart needs it."
	]
	quest.019EA9CBCB2A6326.title: "The Mars Temple"
	quest.01A60C077F4FEDFD.quest_desc: [
		"A spirit attuned crystal and iesnium: the proof of the Spirits strand. Next, Dimensional Storage and the Mineshaft with a Djinni miner, which gives rich ore pieces of every metal your Age allows."
	]
	quest.01A60C077F4FEDFD.title: "Spirit Proof"
	quest.01F190E25E2952F2.quest_desc: [
		"Forge a chestplate of refined glowstone. Armor from the factory itself frees you from the old forge."
	]
	quest.01F190E25E2952F2.title: "Glowstone Armor"
	quest.022B6F2B50E24B10.quest_desc: [
		"{image:firmages:textures/gui/quests/shrine/ring_6.png width:180 height:114 align:center click_action:open_quest:0CDFA3FE518F620D text:Open%20the%20build%20guide}"
		"Raise the Data Nave around the Tesla Crown: certus quartz blocks, steel casing bases, quartz glass and fluix block caps. The heart shows every missing block."
	]
	quest.022B6F2B50E24B10.quest_subtitle: "The shrine ring of this Age"
	quest.022B6F2B50E24B10.title: "Raise the Data Nave"
	quest.02A403EB69A87F9E.quest_desc: [
		"Hammer constantan into a sheet. Its resistance stays the same whatever the heat."
	]
	quest.02A403EB69A87F9E.title: "Constantan Sheet"
	quest.02BAEBC0675BF246.quest_desc: [
		"Bind the Arcane Keystone in the Djinni's crafting pentacle (a spirit attuned crystal, an iesnium ingot, the Wilden Tribute, the mercury catalyst, Starlit Iron and a source gem block), or fill a Hollow Keystone on the machine line."
		""
		"Raise the Spirit Circle; the heart shows what is missing. Lay the Keystone on the new plinth, light the eight candles and pray."
		""
		"Caelum keeps the Keystone and opens the Industrial Age."
	]
	quest.02BAEBC0675BF246.quest_subtitle: "Goal of the Arcane Age: Caelum opens the Industrial Age"
	quest.02BAEBC0675BF246.title: "Offer the Arcane Keystone at the Shrine"
	quest.02EA35E9BD1F97D5.quest_desc: [
		"Lay 16 flux coils end to end. The grid reaches the far shaft and the far mill."
	]
	quest.02EA35E9BD1F97D5.title: "Long Haul"
	quest.02F9ECC9D5A253E9.quest_desc: [
		"Set a flux transformer where flux wire meets the old grid. It joins both without a waste of power."
	]
	quest.02F9ECC9D5A253E9.title: "Flux Transformer"
	quest.03032ECD8B1864DC.quest_desc: [
		"The digital miner clears a whole area by filter. Keep it: a later Age needs it."
	]
	quest.03032ECD8B1864DC.title: "Digital Miner"
	quest.03A410CC86110162.quest_desc: [
		"Work weak steel with nickel and black bronze on the anvil into black steel, the metal of the Industrial Age."
	]
	quest.03A410CC86110162.title: "Black Steel"
	quest.03C78EEE9599C6D7.quest_desc: [
		"Fly to the Drifting Isles at height 228 to 272 by airship or jetpack. Firmament crystal grows only there."
	]
	quest.03C78EEE9599C6D7.title: "Above the Clouds"
	quest.0437D41886A4BCD6.quest_desc: [
		"Put a shear pin in the line. It breaks before the machines do when the network is overstressed."
	]
	quest.0437D41886A4BCD6.title: "Shear Pin"
	quest.046444D7885EFB7E.quest_desc: [
		"Alternating Flux wire carries the strongest current with little loss."
	]
	quest.046444D7885EFB7E.title: "Alternating Flux"
	quest.047078AF7D44EC7D.quest_desc: [
		"Set a MEGA energy cell. The network keeps a deep reserve for the long nights of the launch."
	]
	quest.047078AF7D44EC7D.title: "MEGA Energy Cell"
	quest.04722DE2A3532A26.quest_desc: [
		"Datura fruit becomes Demon's Dream essence. It opens your third eye to the spirit world."
	]
	quest.04722DE2A3532A26.title: "Demon's Dream"
	quest.049DBB559FB718EA.quest_desc: [
		"{image:firmages:textures/gui/quests/shrine/ring_8_build.apng.png width:220 height:135 align:center}"
		"Raise the Quantum Ring round the Star Spire. 88 new blocks in three layers:"
		"- 75 calorite blocks"
		"- eight SPS casings or fusion reactor frames"
		"- four awakened draconium blocks"
		"- the Offering Plinth"
		""
		"Right-click the heart with an empty hand: it shows every missing block as a ghost."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_8_layer_1.png width:220 height:135 align:center}"
		"Layer one of three, level with the heart: 75 calorite blocks, four SPS casings or fusion reactor frames, the Offering Plinth."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_8_layer_2.png width:220 height:135 align:center}"
		"Layer two of three, one block up: four SPS casings or fusion reactor frames."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_8_layer_3.png width:220 height:135 align:center}"
		"Layer three of three, two blocks up: four awakened draconium blocks."
		"{@pagebreak}"
		"Lay the Quantum Core on the plinth. Your Tally Chutes must have taken 3,584 calorite ingots in this Age."
		""
		"The rite:"
		"- At least two of you pray together."
		"- Caelum wants to see the stars: pray at night, under an open sky, without rain."
		"- The lent Awakened Keystone rests on its plinth again."
		"- Feed 100,000,000 FE into the heart; Caelum takes it."
		""
		"Then sneak and hold right-click on the heart with an empty hand. Caelum opens the Singularity Age."
	]
	quest.049DBB559FB718EA.quest_subtitle: "The shrine ring of the Quantum Age"
	quest.049DBB559FB718EA.title: "Quantum Ring"
	quest.04C1F441EE627382.quest_desc: [
		"Imbue a lesser focus and wear it. Spells of its element strike harder."
	]
	quest.04C1F441EE627382.title: "Lesser Focus"
	quest.04DAC1D51AABFF20.quest_desc: [
		"The offering of the Bronze Age. Its build guide stands beside it."
	]
	quest.04DAC1D51AABFF20.quest_subtitle: "Goal of the Bronze Age"
	quest.04DAC1D51AABFF20.title: "Sky Disc"
	quest.051BA54888A28667.quest_desc: [
		"Raise a large antiprotonic nucleosynthesizer. It spends antimatter on matter at a pace the plain machine cannot match."
	]
	quest.051BA54888A28667.title: "Nucleosynthesizer"
	quest.053A6F68FCEB62A5.quest_desc: [
		"Darken framed glass with coal for the walls of the spawner hall. You watch the stock without opening a door."
	]
	quest.053A6F68FCEB62A5.title: "Dark Glass"
	quest.055D1D227906CC81.quest_desc: ["The LV capacitor stores FE and evens out the grid."]
	quest.055D1D227906CC81.title: "LV Capacitor"
	quest.05A433B227D1F928.quest_desc: [
		"Craft a draconic necklace. It holds more modules and more power than the wyvern one."
	]
	quest.05A433B227D1F928.title: "Draconic Necklace"
	quest.05C4B3AE61613A9B.quest_desc: [
		"Iron veins wake."
		""
		"Five strands lead to the Steel Heart: Metallurgy, Power & Motion, Survival, Frontier and Sky. The Sky strand readies the Lens Crown of the next Age."
	]
	quest.05C4B3AE61613A9B.quest_subtitle: "The third Age"
	quest.05C4B3AE61613A9B.title: "The Iron Age Dawns"
	quest.060324F8DBF5D65D.quest_desc: [
		"Build a clay oven. Bread and pies bake in its heat, set in and taken out with a peel."
	]
	quest.060324F8DBF5D65D.quest_subtitle: "Pantry, off \"Kitchen\""
	quest.060324F8DBF5D65D.title: "Clay Oven"
	quest.06055D169B0CC629.quest_desc: [
		"Iesnium ore lies in the Nether. Smelt it into ingots; the Djinni rituals need it."
	]
	quest.06055D169B0CC629.title: "Iesnium"
	quest.0610CB3104268435.quest_desc: [
		"Build a Storm Rod with a meteoric iron tip and fill it with sand. In any rain, lightning strikes it and fuses the sand."
	]
	quest.0610CB3104268435.title: "Storm Rod"
	quest.063D45434D0281D0.quest_desc: [
		"A circuit board tuned by quartz, with two advanced electronic components and electrum wire. With magic, a spirit attuned crystal tunes it alone. Let the assembler make them."
	]
	quest.063D45434D0281D0.title: "Attuned Circuits"
	quest.063F1A5EA37B6B16.quest_desc: [
		"Smith a prospector's pick on an anvil (Smithing strand). It finds ore through stone; a mineral prospector shows the direction and size of the vein."
	]
	quest.063F1A5EA37B6B16.title: "Prospector"
	quest.0663C990B303E311.quest_desc: [
		"{image:firmages:textures/gui/quests/works/gatehouse_open.png width:200 height:179 align:center click_action:custom_event:firmages:ponder/create/rope_pulley text:Watch%20it%20built}"
		"Build a gate that shuts on its own: towers of rock, a bridge over the ditch, a grate that drops and a bridge that lifts."
		""
		"Click the picture to watch the grate built, step by step."
		"{@pagebreak}"
		"{image:firmages:textures/quests/build/gatehouse.png width:128 height:128 align:center}"
		""
		"The plan: towers, ditch and bridge, the grate on its pulley, the drawbridge on its bearing."
	]
	quest.0663C990B303E311.quest_subtitle: "A Great Work of the Bronze Age"
	quest.0663C990B303E311.title: "The Gatehouse"
	quest.0672AC049845AEE4.quest_desc: [
		"Make all four pieces of leather armor from your own tanned hides. Wear them before the first winter trip."
	]
	quest.0672AC049845AEE4.title: "Winter Gear"
	quest.06A8D76480AD9075.quest_desc: [
		"Gather the food of a wild crop. Wild grain and roots ripen in summer, hidden in the tall grass."
	]
	quest.06A8D76480AD9075.title: "Wild Harvest"
	quest.06ED97F3737EE971.quest_desc: [
		"Crush a ruby into dust, or draw cinnabar from its ore. Gems pass through the machines like metal here."
	]
	quest.06ED97F3737EE971.title: "Cinnabar"
	quest.06FEAB3BC2EA4431.quest_desc: [
		"Build a pyromantic brazier. It heats every alchemical apparatus; read the Hermetica as you go."
	]
	quest.06FEAB3BC2EA4431.title: "Pyromantic Brazier"
	quest.0725F0C2566548FA.quest_desc: [
		"Build the distiller and the incubator. Mercury shards, salt and sulfur incubate into a metal dust. Melt it in a vessel."
	]
	quest.0725F0C2566548FA.title: "The Three Principles"
	quest.076861BC7E065BAB.quest_desc: [
		"Bind an AE bridge to a frogport address. The network can then order from your stores, and your stores from the network."
	]
	quest.076861BC7E065BAB.title: "Stock Bridge"
	quest.077BFA2D599B1A4B.quest_desc: [
		"The offering of the Arcane Age. Its build guide stands beside it."
	]
	quest.077BFA2D599B1A4B.quest_subtitle: "Goal of the Arcane Age"
	quest.077BFA2D599B1A4B.title: "Arcane Keystone"
	quest.078E1C7A5241C1E9.quest_desc: [
		"Fuse a wyvern core. It is the heart of wyvern gear and of the Star Chart."
	]
	quest.078E1C7A5241C1E9.title: "Wyvern Core"
	quest.078F36B103C471CF.quest_desc: [
		"Build an ME drive and a 1k storage cell. The drive holds the cells; the network reads them all."
	]
	quest.078F36B103C471CF.title: "ME Drive"
	quest.07D0E5C2A9206383.quest_desc: [
		"Set an Arcane Catalyst against a processing machine, a factory or an electric multiblock. It needs a Source jar within six blocks and a turning shaft at 64 RPM or more beside it."
		""
		"The machine works 50 % faster and pays the power of each extra tick once more. Generators and miners do not take it."
	]
	quest.07D0E5C2A9206383.title: "Arcane Catalyst"
	quest.07D42ECD95337D7C.quest_desc: [
		"Power a millstone from a water wheel and grind 32 flux in it. A chute under the mill drops the flux into a vessel: your first running line."
	]
	quest.07D42ECD95337D7C.title: "Flux Mill"
	quest.07E5B8AC74E7E2A4.quest_desc: [
		"Set a basic laser and power it. The beam crosses a hall in a straight line."
	]
	quest.07E5B8AC74E7E2A4.quest_subtitle: "Laser Lines, off \"Energy Upgrades\""
	quest.07E5B8AC74E7E2A4.title: "Basic Laser"
	quest.084B1FF3C902B47A.quest_desc: [
		"Catch a blaze in the Nether with an empty blaze burner. It fires the mixers of your line superheated."
	]
	quest.084B1FF3C902B47A.title: "Blaze Burner"
	quest.0869D302C86C0C86.quest_desc: [
		"Make the singular alloy. The full Lens Crown forges it into the Firmament Alloy, which binds the nine relics into one."
	]
	quest.0869D302C86C0C86.title: "Singular Alloy"
	quest.08A7A60782C22367.quest_desc: [
		"Mine cursecoal from the netherrack above Y 80 in the deep. It is a fuel far stronger than charcoal."
	]
	quest.08A7A60782C22367.title: "Cursecoal"
	quest.08FA57541FB57841.quest_desc: [
		"Hang copper wire on LV connectors from the alternator to the capacitor and run your machines from it."
	]
	quest.08FA57541FB57841.title: "Grid Online (LV)"
	quest.092749BAB246E72D.quest_desc: [
		"Feed the crusher by machine and collect 64 iron dust from the line."
	]
	quest.092749BAB246E72D.title: "Automated Ore Line"
	quest.09EDA4DD21F093AA.quest_desc: [
		"One link opens the hatch. A delayed link wakes the pad once the leaves are clear."
	]
	quest.09EDA4DD21F093AA.title: "One Signal"
	quest.0A0E25D00C88B31A.quest_desc: [
		"Mine galena, a grey vein with a heavy shine. It is the only ore of lead."
	]
	quest.0A0E25D00C88B31A.quest_subtitle: "Veins of the Crossing, off \"Constantan\""
	quest.0A0E25D00C88B31A.title: "Galena"
	quest.0A44DADC27787AEE.quest_desc: [
		"Feed 512 aluminium ingots into Tally Chutes in this Age. They keep what they take; a chute or the heart shows the count."
	]
	quest.0A44DADC27787AEE.title: "Proof of Work"
	quest.0A81ED2F8A5BB2AE.quest_desc: [
		"Tin and zinc veins wake. Anvils, alloys and the first kinetic machines follow."
		""
		"Four strands lead to the Sky Disc: Smithing, Prospecting, Alloys and Kinetics."
	]
	quest.0A81ED2F8A5BB2AE.quest_subtitle: "The second Age"
	quest.0A81ED2F8A5BB2AE.title: "The Bronze Age Dawns"
	quest.0ABF4F27145CD228.quest_desc: [
		"Pick up twigs under trees with an empty hand; each makes a stick on the ground. Leaves cut with a stone knife drop sticks too."
	]
	quest.0ABF4F27145CD228.title: "A Bundle of Sticks"
	quest.0AF4168528180400.quest_desc: [
		"Fill a bucket with diesel or kerosene from your distillation tower. Tier 1 and 2 rockets burn either."
	]
	quest.0AF4168528180400.title: "Rocket Fuel"
	quest.0B222390EB21C8E3.quest_desc: [
		"Craft a universal terminal. One slot of your pack opens the network, the crafting grid and patterns."
	]
	quest.0B222390EB21C8E3.title: "Universal Terminal"
	quest.0B2B6BE451DD1912.quest_desc: ["Sixteen buckets of diesel from your own refinery."]
	quest.0B2B6BE451DD1912.title: "Refined Diesel"
	quest.0B2CE763E15475FA.quest_desc: [
		"Clay lies under grass near water. Athyrium fern, canna, goldenrod, pampas grass, perovskia and water canna grow above it."
	]
	quest.0B2CE763E15475FA.title: "Locating Clay"
	quest.0B455ABB4422F847.quest_desc: [
		"Carry a cinder focus. Two elements fused burn hotter than either alone."
	]
	quest.0B455ABB4422F847.title: "Cinder Focus"
	quest.0B4C781BE87EF3D3.quest_desc: [
		"Feed 2,880 desh ingots into Tally Chutes in this Age. They keep what they take; a chute or the heart shows the count."
	]
	quest.0B4C781BE87EF3D3.title: "Proof of Work"
	quest.0B6E6399C2A3149B.quest_desc: [
		"Slay monsters until one drops a gem. Each carries one power for the gear it is set in."
	]
	quest.0B6E6399C2A3149B.title: "A Gem"
	quest.0B920DA5835D008C.quest_desc: [
		"Forge a shield of refined obsidian. It turns blows that would split a wooden one."
	]
	quest.0B920DA5835D008C.title: "Refined Shield"
	quest.0BA4D1B6A66D0C59.quest_desc: [
		"Imbue amethyst or lapis lazuli. Source gems are the base of all source magic."
	]
	quest.0BA4D1B6A66D0C59.title: "Source Gems"
	quest.0C271F72FE0B4376.quest_desc: ["Mine bauxite. Its ore is the only source of aluminium."]
	quest.0C271F72FE0B4376.title: "Bauxite"
	quest.0C3426C69CCC9AFB.quest_desc: [
		"Build a grist mill. Grain goes in and flour comes out, with no quern and no hand to turn it."
	]
	quest.0C3426C69CCC9AFB.title: "Grist Mill"
	quest.0C379E8319A22836.quest_desc: [
		"Keep the chunks your lines run in loaded, or they stop when you leave."
	]
	quest.0C379E8319A22836.title: "Chunk Claims"
	quest.0C522194B14B71CC.quest_desc: ["A backpack carries a second inventory."]
	quest.0C522194B14B71CC.title: "Pack Mule"
	quest.0CDFA3FE518F620D.quest_desc: [
		"{image:firmages:textures/gui/quests/shrine/ring_6_build.apng.png width:220 height:140 align:center}"
		"Raise the Data Nave round the Tesla Crown. 76 new blocks in four layers:"
		"- 59 quartz blocks"
		"- eight quartz glass"
		"- four fluix blocks"
		"- four steel casings"
		"- the Offering Plinth"
		""
		"Right-click the heart with an empty hand: it shows every missing block as a ghost."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_6_layer_1.png width:220 height:140 align:center}"
		"Layer one of four, level with the heart: 59 quartz blocks, four steel casings, the Offering Plinth."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_6_layer_2.png width:220 height:140 align:center}"
		"Layer two of four, one block up: four quartz glass."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_6_layer_3.png width:220 height:140 align:center}"
		"Layer three of four, two blocks up: four quartz glass."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_6_layer_4.png width:220 height:140 align:center}"
		"Layer four of four, three blocks up: four fluix blocks."
		"{@pagebreak}"
		"Lay the Data Matrix on the plinth. Your Tally Chutes must have taken 1,024 osmium ingots in this Age."
		""
		"The rite:"
		"- At least two of you pray together."
		"- Feed 10,000,000 FE into the heart; Caelum takes it."
		""
		"Then sneak and hold right-click on the heart with an empty hand. Caelum opens the Space Age."
	]
	quest.0CDFA3FE518F620D.quest_subtitle: "The shrine ring of the Information Age"
	quest.0CDFA3FE518F620D.title: "Data Nave"
	quest.0D0AB1CA40800F5A.quest_desc: ["Break a wild crop to get its seeds."]
	quest.0D0AB1CA40800F5A.title: "Gatherer"
	quest.0D406931BD8899E4.quest_desc: [
		"Raise an overclocked cube to a quantum energy cube. The reactor and the gate drink from a store this deep."
	]
	quest.0D406931BD8899E4.title: "Quantum Energy Cube"
	quest.0D7A39FE4D5A01B4.quest_desc: [
		"Wear a psimetal exosuit chestplate. Add a controller and sensors, and the suit casts for you."
	]
	quest.0D7A39FE4D5A01B4.title: "Exosuit"
	quest.0D99128B070FE166.quest_desc: [
		"The chaotic chestpiece has a direct recipe. Wear it into the final battle."
	]
	quest.0D99128B070FE166.title: "Chaotic Armor"
	quest.0DD300C809C84163.quest_desc: [
		"Make hypercharged alloy and fuse it with antimatter into two subatomic alloys. The Quantum Core and the Awakened Keystone each want one."
	]
	quest.0DD300C809C84163.title: "Subatomic Alloy"
	quest.0E11167D545AFC02.quest_desc: [
		"Pair two redstone links. The gate obeys a lever from across the yard."
	]
	quest.0E11167D545AFC02.title: "One Signal"
	quest.0E19FEB2C2B7231D.quest_desc: [
		"Hang a flux relay between poles. It carries the current across a valley with hardly a loss."
	]
	quest.0E19FEB2C2B7231D.quest_subtitle: "Flux Without Loss, off \"Alternating Flux\""
	quest.0E19FEB2C2B7231D.title: "Flux Relay"
	quest.0E20210FC1A9FDD3.quest_desc: [
		"Raise a pump pipe, a narrow flue. Right-click it with more pipe to stack up to eight at once."
	]
	quest.0E20210FC1A9FDD3.quest_subtitle: "Flue and Lift, off \"Ironworks\""
	quest.0E20210FC1A9FDD3.title: "Flue Pipe"
	quest.0E48C0E43D256E7D.quest_desc: [
		"Fuse a Nether Star in the arc furnace. The Humming Core needs it; the Wither drops one too."
	]
	quest.0E48C0E43D256E7D.title: "Nether Star"
	quest.0E6A3550C87835D7.quest_desc: [
		"Stand a wooden pole between floors. Hold on and slide down; there is no ladder faster."
	]
	quest.0E6A3550C87835D7.title: "Slide Pole"
	quest.0EDED5D6837D3002.quest_desc: [
		"Set a clock block on a wall. It tells the hour of the sun to the whole house."
	]
	quest.0EDED5D6837D3002.title: "Clock Block"
	quest.0EEEF839B7D015F2.quest_desc: [
		"Build a beamhouse. Hides are limed, washed and tanned in it by machine; the scraping waits for the fleshing machine."
	]
	quest.0EEEF839B7D015F2.title: "Beamhouse"
	quest.0F1AE784BF392A25.quest_desc: [
		"Ore triples, the ME network stores and crafts, and the End can be reached. Veins of certus quartz, inferium, prosperity and soulstone wake."
		""
		"Four strands lead to the Data Matrix: Digital, Factory, Mob Data and Sky. The End is a side path."
		""
		"Caelum asks for proof of work this time: 1,024 osmium ingots fed into Tally Chutes in this Age."
	]
	quest.0F1AE784BF392A25.quest_subtitle: "The seventh Age"
	quest.0F1AE784BF392A25.title: "The Information Age Dawns"
	quest.0F521229482D3C64.quest_desc: [
		"Plant copper or iron seeds on inferium farmland and let them ripen. The crop is a bundle of essence."
	]
	quest.0F521229482D3C64.title: "Metal Seeds"
	quest.0F533D23E29FB489.quest_desc: [
		"Fill a bucket with blaze spawn fluid. Blaze rods no longer need a fortress."
	]
	quest.0F533D23E29FB489.title: "Blaze Fluid"
	quest.0F76089092EB0D28.quest_desc: [
		"Set eight basic and eight wyvern injectors around the core. The wyvern injector fills eight basic ones, the awakened core eight wyvern ones."
	]
	quest.0F76089092EB0D28.title: "Injectors"
	quest.0F97073C5BDEA813.quest_desc: ["Transformers step the voltage between wire tiers."]
	quest.0F97073C5BDEA813.title: "Transformers"
	quest.0FBE04E270216ADA.quest_desc: [
		"Build the liquefaction cauldron and a digestion vat. Ore pieces of every grade digest into alchemical sulfur, where spagyrics begin."
	]
	quest.0FBE04E270216ADA.title: "Liquefaction Cauldron"
	quest.0FEADDD76E0ED422.quest_desc: [
		"Build a quantum washing factory. Ore of every Age comes out clean at a pace no basic factory reaches."
	]
	quest.0FEADDD76E0ED422.title: "Quantum Washing Factory"
	quest.0FF697E3625FD70E.quest_desc: [
		"The engineering machines are multiblocks: build the shape from the Engineer's Manual, then hit the marked block with the Engineer's Hammer. Projector blueprints show the shape in the world."
	]
	quest.0FF697E3625FD70E.title: "Multiblocks"
	quest.1006400444BCC185.quest_desc: [
		"Pipe or bucket the aurora light out of your Aurora Nets. Nothing else makes it."
	]
	quest.1006400444BCC185.title: "Aurora Light"
	quest.102A4D2C50AB6948.quest_desc: [
		"Craft a jetpack and fill it with hydrogen from the separator."
	]
	quest.102A4D2C50AB6948.title: "Hydrogen Jetpack"
	quest.10708C5D853308E7.quest_desc: [
		"Craft the reactor controller. It sits in the top of the reactor."
	]
	quest.10708C5D853308E7.title: "Reactor Controller"
	quest.10D18EB5418E22F1.quest_desc: ["Copper and nickel in the alloy kiln."]
	quest.10D18EB5418E22F1.title: "Constantan"
	quest.10E81DCA65CCD6C7.quest_desc: [
		"Lay up 32 ostrum plates. Two go into the Star Chart; the rest become the engine and tanks of the rocket to Venus."
	]
	quest.10E81DCA65CCD6C7.title: "Ostrum Plates"
	quest.10F7B6A8850E3BCE.quest_desc: ["Mine 16 raw ostrum on Mars. It builds the rocket to Venus."]
	quest.10F7B6A8850E3BCE.title: "Ostrum"
	quest.11192A33C7008995.quest_desc: [
		"Set an ambient gas collector. It draws gas from the air itself and wants nothing but power."
	]
	quest.11192A33C7008995.title: "Ambient Gas Collector"
	quest.1164F7391DDF80C9.quest_desc: [
		"{image:firmages:textures/gui/quests/works/gatehouse_shut.png width:180 height:161 align:center click_action:custom_event:firmages:ponder/create/rope_pulley text:Watch%20it%20built}"
		"Throw the lever on the gearshift of the pulley. The grate drops, the bridge rises, and the night stays outside."
	]
	quest.1164F7391DDF80C9.quest_subtitle: "The gate holds"
	quest.1164F7391DDF80C9.title: "Shut the Gate"
	quest.11C69E0E52468453.quest_desc: [
		"Build a chemical storage cell. Gases and slurries enter the network like items."
	]
	quest.11C69E0E52468453.quest_subtitle: "Bridges of the Network, off \"Autocrafting Online\""
	quest.11C69E0E52468453.title: "Chemical Cell"
	quest.11D75C261FA24AE3.quest_desc: ["A wrought iron anvil can work steel."]
	quest.11D75C261FA24AE3.title: "Iron Anvil"
	quest.11F575AA30F154A5.quest_desc: [
		"{image:firmages:textures/gui/quests/shrine/ring_2.png width:180 height:127 align:center click_action:open_quest:2AD10B433A5BEAFD text:Open%20the%20build%20guide}"
		"Raise the Iron Sanctum around the Bronze Sanctum: smooth rock pillars with wrought iron bars and four wrought iron lamps. The heart shows every missing block."
	]
	quest.11F575AA30F154A5.quest_subtitle: "The shrine ring of this Age"
	quest.11F575AA30F154A5.title: "Raise the Iron Sanctum"
	quest.124DDC9853158E78.quest_desc: [
		"Build a thresher from steel sheet metal, light engineering blocks, a redstone engineering block and a hopper, and form it with the Engineer's Hammer like the crusher. It ends threshing by hand."
		""
		"The grist mill, beamhouse, power loom and fleshing machine follow and end the rest of the hand work."
	]
	quest.124DDC9853158E78.title: "The Thresher"
	quest.12AA975B971EC62B.quest_desc: [
		"Smelt eight osmium ingots from the vein that woke in the Electric Age. The steel casing needs them."
	]
	quest.12AA975B971EC62B.title: "Osmium"
	quest.12E398160E3E3975.quest_desc: [
		"Build a brass chute. It moves up to 64 items at a time, for lines that must not clog."
	]
	quest.12E398160E3E3975.title: "Brass Chute"
	quest.12F2B758B0EC78AC.quest_desc: [
		"The arc furnace melts, alloys and makes steel with graphite electrodes."
	]
	quest.12F2B758B0EC78AC.title: "Arc Furnace"
	quest.136A6DB3C34D16EB.quest_desc: [
		"Steam engines on a boiler give far more force than water wheels."
	]
	quest.136A6DB3C34D16EB.title: "Steam Engine"
	quest.1446D5F0DD3F4985.quest_desc: [
		"Find chromite in the rock. Its metal is the last ingredient of stainless steel."
	]
	quest.1446D5F0DD3F4985.quest_subtitle: "Jars and Stainless, off \"Black Steel\""
	quest.1446D5F0DD3F4985.title: "Chromite"
	quest.147A87428E5CADF3.quest_desc: [
		"Cut acorns from oak leaves with the long secateurs. Out of their season the leaves give nothing."
	]
	quest.147A87428E5CADF3.title: "Acorns"
	quest.14A493C9A2F06B38.quest_desc: [
		"Fit a turbocharger. The engine runs twice as fast and burns twice as much."
	]
	quest.14A493C9A2F06B38.title: "Turbocharger"
	quest.14D3023FFD9CCED8.quest_desc: [
		"Craft an advanced electrolysis core, the heart of the large gas generator. Each fission port holds one later."
	]
	quest.14D3023FFD9CCED8.title: "Electrolysis Core"
	quest.15070FF77006AFB6.quest_desc: [
		"Draw 24 polonium pellets from your reactor waste. One is the catalyst of the Star Chart; the fusion frames and SPS casings of the next Age take the rest."
	]
	quest.15070FF77006AFB6.title: "Reactor Online"
	quest.153E204EC2BA3ACA.quest_desc: [
		"Right-click two thatch blocks side by side with a large raw hide: a thatch bed. It sets your spawn but does not skip the night."
	]
	quest.153E204EC2BA3ACA.title: "Shelter"
	quest.15673B5A9807871D.quest_desc: [
		"The excavator digs the mineral mix under a chunk. A core sample shows which one lies there."
	]
	quest.15673B5A9807871D.title: "Excavator"
	quest.157E197DE71E5ECA.quest_desc: [
		"Weld copper double ingots into a copper anvil. Tools and sheets are smithed on it."
	]
	quest.157E197DE71E5ECA.title: "Copper Anvil"
	quest.15841564A71DE8DE.quest_desc: [
		"Lay a navigation table and give it a compass or a map. Its redstone signal points toward the goal."
	]
	quest.15841564A71DE8DE.title: "Navigation Table"
	quest.15AD3FABD5A6F24F.quest_desc: [
		"Process uraninite ore into yellow cake, the start of fission fuel."
	]
	quest.15AD3FABD5A6F24F.title: "Yellow Cake"
	quest.15C1854EDB24AD7F.quest_desc: [
		"Build a library. Enchanted books dropped in become stored levels, and you draw out any enchantment you saved."
	]
	quest.15C1854EDB24AD7F.title: "Library"
	quest.15E3FB7395A86F61.quest_desc: [
		"Soak planks in creosote. Treated wood is the frame of every engineering machine."
	]
	quest.15E3FB7395A86F61.title: "Treated Wood"
	quest.1628C003B7759E11.quest_desc: [
		"Land on Glacio, the frozen world. Ice shards are mined there."
	]
	quest.1628C003B7759E11.title: "Glacio"
	quest.1662CE1A9F311C34.quest_desc: [
		"Gather a loose rock of each family: igneous extrusive, igneous intrusive, metamorphic and sedimentary. Hover over a rock to read its family."
	]
	quest.1662CE1A9F311C34.title: "Loose and Found"
	quest.166C4569CC75A30A.quest_desc: [
		"Build a drying mat, the first piece of a real kitchen. Ovens, cheese and dried food follow."
	]
	quest.166C4569CC75A30A.title: "Kitchen"
	quest.168E732D468D0F98.quest_desc: [
		"Train a Wither data model and print four Nether Stars in the loot fabricator. Awakened draconium wants them later."
	]
	quest.168E732D468D0F98.title: "Wither on Demand"
	quest.16C0C0C37BE144E7.quest_desc: [
		"Forge a shield of wrought iron and carry it against the dummy. A blow you catch is a blow not taken."
	]
	quest.16C0C0C37BE144E7.title: "A Shield"
	quest.16D1C406E00151F0.quest_desc: [
		"{image:firmages:textures/gui/quests/shrine/ring_4_build.apng.png width:220 height:152 align:center}"
		"Raise the Foundry Nave round the Spirit Circle. 64 new blocks in five layers:"
		"- 43 coke bricks"
		"- twelve steel scaffolding"
		"- four electric lanterns"
		"- four heavy engineering blocks"
		"- the Offering Plinth"
		""
		"Right-click the heart with an empty hand: it shows every missing block as a ghost."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_4_layer_1.png width:220 height:152 align:center}"
		"Layer one of five, level with the heart: 43 coke bricks, four heavy engineering blocks, the Offering Plinth."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_4_layer_2.png width:220 height:152 align:center}"
		"Layer two of five, one block up: four steel scaffolding."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_4_layer_3.png width:220 height:152 align:center}"
		"Layer three of five, two blocks up: four steel scaffolding."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_4_layer_4.png width:220 height:152 align:center}"
		"Layer four of five, three blocks up: four steel scaffolding."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_4_layer_5.png width:220 height:152 align:center}"
		"Layer five of five, four blocks up: four electric lanterns."
		"{@pagebreak}"
		"Lay the Pressure Core on the plinth. Your Tally Chutes must have taken 384 steel ingots in this Age."
		""
		"The rite:"
		"- Power the four electric lanterns on the pillars."
		""
		"Then sneak and hold right-click on the heart with an empty hand. Caelum opens the Electric Age."
	]
	quest.16D1C406E00151F0.quest_subtitle: "The shrine ring of the Industrial Age"
	quest.16D1C406E00151F0.title: "Foundry Nave"
	quest.175259B58F7782F8.quest_desc: [
		"{image:firmages:textures/quests/ponder/clockwork_bearing.png width:128 height:128 align:center click_action:custom_event:firmages:ponder/create/clockwork_bearing text:Click%20to%20watch}"
		"Set a clockwork bearing in the gable and give it hands. The house keeps the hours of the sun."
	]
	quest.175259B58F7782F8.quest_subtitle: "The house is awake"
	quest.175259B58F7782F8.title: "The House Keeps Time"
	quest.17A29F90313EDA66.quest_desc: [
		"A garden cloche grows crops under glass with power and water."
	]
	quest.17A29F90313EDA66.title: "Garden Cloche"
	quest.17A6DF62A27B20B3.quest_desc: [
		"Build a CAD assembler. Its frame takes two control circuits from the factory line."
	]
	quest.17A6DF62A27B20B3.quest_subtitle: "Programming Magic, off \"Archmage\""
	quest.17A6DF62A27B20B3.title: "CAD Assembler"
	quest.17C422C791C0C955.quest_desc: [
		"Build a hand cart. It carries stacks of goods, and you pull it yourself, no beast needed."
	]
	quest.17C422C791C0C955.title: "Hand Cart"
	quest.17D565AAFDDF8749.quest_desc: [
		"Place an ME proxy. Belts and funnels reach into the network through it as into a chest."
	]
	quest.17D565AAFDDF8749.title: "ME Proxy"
	quest.188B8BAD88328299.quest_desc: [
		"Magic wakes: spirits, source and alchemy. It gives the best ore yield of this Age."
		""
		"The Arcane Keystone takes one of two routes. The Spirit Route binds it from the Spirits, Source and Alchemy strands. The Machine Route fills a Hollow Keystone on your machine line. Both need Starlit Iron from the Lens Crown: the Sky strand."
	]
	quest.188B8BAD88328299.quest_subtitle: "The fourth Age"
	quest.188B8BAD88328299.title: "The Arcane Age Dawns"
	quest.189EECC0C6A48A7B.quest_desc: [
		"Set a level emitter on the network. It gives a redstone signal that follows the count of an item."
	]
	quest.189EECC0C6A48A7B.title: "Level Emitter"
	quest.18D83559159A93C7.quest_desc: [
		"Cap a chimney with a metal vent. The smoke leaves through its slots."
	]
	quest.18D83559159A93C7.title: "Metal Vent"
	quest.193395E7E30FE028.quest_desc: [
		"Right-click the glowing vessel, the pickaxe head mold in the slot. The cooled head on a stick is your first pickaxe."
	]
	quest.193395E7E30FE028.title: "Copper Pickaxe"
	quest.1A05AE87B72A9F8F.quest_desc: [
		"Link a toggleable laser to a remote control. A switch across the base turns a whole line on and off."
	]
	quest.1A05AE87B72A9F8F.title: "Remote Control"
	quest.1A281872B94741FF.quest_desc: [
		"Break gilded blackstone in the bastions of the deep. One block in four gives up a chunk of gold."
	]
	quest.1A281872B94741FF.title: "Gold Chunks"
	quest.1A7B308A025FA2CD.quest_desc: [
		"Put hot metal in the anvil and hold a hammer. Pick the plan from the scroll. Strike until the green marker meets the red one; your last three strikes must match the rules shown on top."
	]
	quest.1A7B308A025FA2CD.title: "Anvil Work"
	quest.1A85B2B291F401B5.quest_desc: [
		"Make eight rope bridges of one wood, any tree. They span the ditch before your gate."
	]
	quest.1A85B2B291F401B5.title: "A Bridge Over the Ditch"
	quest.1AA3DA7FC73C7765.quest_desc: [
		"Set a station on your track. A train that reaches it stops, loads and leaves by its schedule."
	]
	quest.1AA3DA7FC73C7765.quest_subtitle: "Steam on Rails, off \"Blaze Burner\""
	quest.1AA3DA7FC73C7765.title: "Train Station"
	quest.1AE489B1F3638BC0.quest_desc: [
		"Craft the encyclopedia. It shows what spirits do for a machine and where chalk and gears meet."
	]
	quest.1AE489B1F3638BC0.quest_subtitle: "Spirits at Work, off \"Bind a Djinni\""
	quest.1AE489B1F3638BC0.title: "Encyclopedia of Souls"
	quest.1B12D746242380A4.quest_desc: ["Aluminium comes only from the arc furnace."]
	quest.1B12D746242380A4.title: "Aluminium"
	quest.1B193EBB6445A940.quest_desc: [
		"Craft a sigil of socketing. At the smithing table it opens a socket in a blade or a helm."
	]
	quest.1B193EBB6445A940.title: "Sigil of Socketing"
	quest.1B1F800A08B9A66B.quest_desc: [
		"Set a growth accelerator under the farmland. It hastens the crop above it with no one to tend it."
	]
	quest.1B1F800A08B9A66B.title: "Growth Accelerator"
	quest.1B74C0B3BA4F7609.quest_desc: [
		"Build a crystallizer and a naquadah liquidizer. The gate's 32 crystals grow in the crystallizer from gems, a crystal base and liquid naquadah."
	]
	quest.1B74C0B3BA4F7609.title: "Crystallizer"
	quest.1BBF74D29B1896AB.quest_desc: [
		"Upgrade the pack to diamond. It carries far more, and the upgrade slots grow with it."
	]
	quest.1BBF74D29B1896AB.title: "Diamond Pack"
	quest.1BC2A62B4D301274.quest_desc: [
		"Hot items glow. Hover over one to read its heat; each metal melts at its own."
	]
	quest.1BC2A62B4D301274.title: "Heat Colors"
	quest.1BDBAA8EB6E2DA83.quest_desc: [
		"Factory gauges keep a production line stocked by themselves."
	]
	quest.1BDBAA8EB6E2DA83.title: "Factory Gauge"
	quest.1BDF51DA8C6CA794.quest_desc: [
		"The metal press makes sheets from two ingots, rods and wire."
	]
	quest.1BDF51DA8C6CA794.title: "Metal Press"
	quest.1BF2818DC437F21D.quest_desc: [
		"Work weak red steel on the anvil, then into a sheet. Red steel is the metal of the Electric Age."
	]
	quest.1BF2818DC437F21D.title: "Red Steel"
	quest.1C074E3001752190.quest_desc: [
		"Hammer lead into a sheet on the anvil. It lines the tanks and shields the cables."
	]
	quest.1C074E3001752190.title: "Lead Sheet"
	quest.1C0F00ABF4E17A0E.quest_desc: [
		"Set a junction where the tubes fork. You choose the branch as you pass through."
	]
	quest.1C0F00ABF4E17A0E.title: "Tube Junction"
	quest.1CC29E163A94FCE6.quest_desc: [
		"{image:firmages:textures/quests/device/pit_kiln.png width:128 height:128 align:center}"
		""
		"Knap five clay into a vessel, a jug, a bowl or a mold (see \"Clay Patterns\"). Fire it in a pit kiln:"
		"- Dig a hole one block deep. Hold an unfired piece, look at the floor of the hole and press V. Up to four pieces fit."
		"- Right-click the pile with eight straw, then with eight logs."
		"- Light the top with a firestarter."
		""
		"After about six minutes the fire is out and the pottery is fired."
	]
	quest.1CC29E163A94FCE6.title: "Potter"
	quest.1CC36C2772C8BF13.quest_desc: [
		"Make a Wixie charm at the enchanting apparatus with conjuration essence. Use it on a cauldron: the Wixie crafts or brews what you show it."
	]
	quest.1CC36C2772C8BF13.title: "Wixie Charm"
	quest.1CE33853BEFBE413.quest_desc: [
		"Stack modular diesel engines in a row. They work like the small one, and each module adds its share of stress."
	]
	quest.1CE33853BEFBE413.title: "Large Engine"
	quest.1CE3C9737EEF224F.quest_desc: [
		"Set a loot collector at the spawn point of a spawner. The drops come straight into it, and no beast walks out."
	]
	quest.1CE3C9737EEF224F.title: "Loot Collector"
	quest.1CEE5246AF1BDCB2.quest_desc: [
		"Render fat into tallow and make candles. Light without fire hazards."
	]
	quest.1CEE5246AF1BDCB2.title: "Tallow and Candles"
	quest.1D238635FCC5C642.quest_desc: [
		"Build a crafting CPU and let the network craft four 64k storage components: your first autocrafting order."
	]
	quest.1D238635FCC5C642.title: "Autocrafting Online"
	quest.1D5C854562BD6F58.quest_desc: [
		"Dial The Origin and step through the gate. Gather at the altar, all of you, and The Primordial wakes. Its veil opens only when you answer its attacks."
		""
		"Its fall completes the Firmament. The MekaSuit and the Meka-Tool can then be made."
	]
	quest.1D5C854562BD6F58.quest_subtitle: "Goal of the Singularity Age: the end of the road"
	quest.1D5C854562BD6F58.title: "Beyond the Firmament"
	quest.1D6DEDC4D88B70A2.quest_desc: [
		"Sew a sack and fill it. It keeps a small hoard in the space of a single item."
	]
	quest.1D6DEDC4D88B70A2.title: "Sack"
	quest.1D842B40E0C51F06.quest_desc: [
		"The sky opens upward. Uranium and fission, rockets to the Moon and Mars, and draconium from the End."
		""
		"Five strands lead to the Star Chart: Atomic, Rocketry & Moon, Mars, Draconium and Sky."
		""
		"Caelum asks for proof of work this time: 2,880 desh ingots fed into Tally Chutes in this Age."
	]
	quest.1D842B40E0C51F06.quest_subtitle: "The eighth Age"
	quest.1D842B40E0C51F06.title: "The Space Age Dawns"
	quest.1D924EC74CBF936E.quest_desc: [
		"Set an entrance at the end of a hypertube. Step in and you are carried off along the line."
	]
	quest.1D924EC74CBF936E.quest_subtitle: "Parcel Roads, off \"Hypertubes\""
	quest.1D924EC74CBF936E.title: "Tube Entrance"
	quest.1DC6FC26B0415CF5.quest_desc: [
		"Find pale crusts on the stones of a hot spring. Each spring field grows its own mineral; break salt from one."
	]
	quest.1DC6FC26B0415CF5.quest_subtitle: "Fire Mountain, off \"Native Copper\""
	quest.1DC6FC26B0415CF5.title: "Crust of Salt"
	quest.1E05714D0F44B25C.quest_desc: [
		"The diesel generator is the one FE generator of this Age. Feed it diesel from the Oil strand."
	]
	quest.1E05714D0F44B25C.title: "Diesel Generator"
	quest.1E1F3E3E6C4E81FD.quest_desc: [
		"A core sample drill shows what lies under a chunk, oil included."
	]
	quest.1E1F3E3E6C4E81FD.title: "Core Sample"
	quest.1E229C10455C4605.quest_desc: [
		"Build a mechanical chamber. It stands in for the sacrificial bowl at any ritual that needs no offering."
	]
	quest.1E229C10455C4605.title: "Mechanical Chamber"
	quest.1E2B67282F83843D.quest_desc: [
		"Three ways give more metal per ore:"
		"- Crushing wheels: about 1.5 times."
		"- Spagyrics: twice the metal, every grade."
		"- The Dimensional Mineshaft: rich pieces without end."
		""
		"The spirit crusher grinds no ore."
	]
	quest.1E2B67282F83843D.title: "Ore in the Arcane Age"
	quest.1E2C418E80F1ED83.quest_desc: [
		"Wear lava robes. Two elements are woven into one cloth, and the caster draws on both."
	]
	quest.1E2C418E80F1ED83.title: "Lava Robes"
	quest.1EBE873E5DBB12CD.quest_desc: [
		"Make long secateurs with a brass mechanism. They reach the high leaves where the nuts hide."
	]
	quest.1EBE873E5DBB12CD.quest_subtitle: "Nuts of the Wood, off \"Kitchen\""
	quest.1EBE873E5DBB12CD.title: "Long Secateurs"
	quest.1F3F85FE5B0041D8.quest_desc: ["Build a NASA workbench. Every rocket is assembled on it."]
	quest.1F3F85FE5B0041D8.title: "NASA Workbench"
	quest.1FD61E2A23294166.quest_desc: [
		"Keep 20 large and 36 medium fragments of spent fuel: twelve chaotic injectors, the chaotic core, the Singularity and the Coordinates."
	]
	quest.1FD61E2A23294166.title: "Chaos Fragments"
	quest.1FE13D3931164773.quest_desc: [
		"Add the Electric lens and forge Halo Steel from starsteel, blue steel, firmament crystal and aurora light. Two ingots go into the Data Matrix."
	]
	quest.1FE13D3931164773.title: "Halo Steel"
	quest.1FF70CA8C25C3519.quest_desc: [
		"Run inventory cable to a far chest and attach it with a cable connector. Distance stops mattering."
	]
	quest.1FF70CA8C25C3519.title: "Inventory Cable"
	quest.2028C22C75F61DE8.quest_desc: [
		"Wire the network with an ME coil. Cable crosses a valley like power does."
	]
	quest.2028C22C75F61DE8.title: "Network Wire"
	quest.203071592A4D660A.quest_desc: [
		"Cut tall grass with a stone knife for straw. Lay four on one block, sneak and right-click the pile: thatch, Dawn's one building block."
	]
	quest.203071592A4D660A.title: "Thatch"
	quest.2036F321608B520E.quest_desc: ["Patterns and assemblers craft on request."]
	quest.2036F321608B520E.title: "Molecular Assembler"
	quest.2039F59A2686202B.quest_desc: [
		"Fit a compression card in a cell. Stone and ore are stored as blocks, and the cell holds many more."
	]
	quest.2039F59A2686202B.title: "Compression Card"
	quest.206BCC87705BB466.quest_desc: [
		"Knap a javelin head (see \"Knapping Patterns\") and craft it with a stick on the ground. Throw it or stab with it."
	]
	quest.206BCC87705BB466.title: "A Stone Javelin"
	quest.2070B77706F2CB8E.quest_desc: [
		"Craft the Sky Disc from a bronze double sheet and gold sheets."
		""
		"Raise the Bronze Sanctum: rock bricks, four bronze blocks and a bronze bell. The heart shows what is missing. Lay the Disc on the new plinth, ring the bell and pray."
		""
		"Caelum keeps the Disc and opens the Iron Age."
	]
	quest.2070B77706F2CB8E.quest_subtitle: "Goal of the Bronze Age: Caelum opens the Iron Age"
	quest.2070B77706F2CB8E.title: "Offer the Sky Disc at the Shrine"
	quest.20986504959DC566.quest_desc: [
		"Knap and fire a crucible. Melt copper with tin in it, nine parts to one: bronze. Bismuth and black bronze serve for tools too."
	]
	quest.20986504959DC566.title: "Bronze"
	quest.20F0E7AB1C38C45A.quest_desc: [
		"Fit an advanced magnet upgrade. Loose goods fly to the pack from far off."
	]
	quest.20F0E7AB1C38C45A.title: "Advanced Magnet"
	quest.20F2DCAF2F99DDB6.quest_desc: [
		"Craft an extraction tome. It strips the enchantments from a worn blade and writes them into books."
	]
	quest.20F2DCAF2F99DDB6.title: "Extraction Tome"
	quest.21193CB7838FAC31.quest_desc: [
		"{image:firmages:textures/quests/ponder/portcullis.png width:128 height:128 align:center click_action:custom_event:firmages:ponder/create/rope_pulley text:Click%20to%20watch}"
		"Glue a bronze grate together and hang it in a wall slot under a rope pulley. Turn the pulley and the gate shuts."
	]
	quest.21193CB7838FAC31.title: "Portcullis"
	quest.214D6B55DD018CDF.quest_desc: [
		"Dig a cellar below ground: it stays cool. Fill large vessels and seal them."
	]
	quest.214D6B55DD018CDF.title: "Cellar Vessels"
	quest.216ADE120332EDCD.quest_desc: [
		"Blazes live in the Nether fortresses. A deployer sets one rod per pass."
	]
	quest.216ADE120332EDCD.title: "Blaze Rods"
	quest.2184B4EB21075F37.quest_desc: [
		"{image:firmages:textures/gui/quests/shrine/ring_5.png width:180 height:121 align:center click_action:open_quest:79D2D4E17FC9732D text:Open%20the%20build%20guide}"
		"Raise the Tesla Crown around the Foundry Nave: aluminium, red steel bases with HV capacitors, aluminium scaffolding and four floodlights. The heart shows every missing block."
	]
	quest.2184B4EB21075F37.quest_subtitle: "The shrine ring of this Age"
	quest.2184B4EB21075F37.title: "Raise the Tesla Crown"
	quest.21976C7EF3201112.quest_desc: [
		"Heat refinery kerosene in a mixer into aviation kerosene and fill a bucket. The engines burn it and nothing else."
	]
	quest.21976C7EF3201112.title: "Aviation Kerosene"
	quest.21B580750CD1579A.quest_desc: [
		"Afrits need an HV coil block for their book. They run the Dimensional Battlefield."
	]
	quest.21B580750CD1579A.title: "Bind an Afrit"
	quest.21C2AA41F93E700F.quest_desc: [
		"Fuse a dragon heart at wyvern level from a draconium block and core, pellets and ostrum. The Ender Dragon drops one too."
	]
	quest.21C2AA41F93E700F.title: "Dragon Heart"
	quest.21E4F24EBD59297F.quest_desc: [
		"Build a printer. It copies a written book as often as the ink and the experience last."
	]
	quest.21E4F24EBD59297F.title: "Printer"
	quest.21F5A752996C9586.quest_desc: [
		"Knap a knife blade and a hammer head (see \"Knapping Patterns\") and craft each with a stick. The knife cuts straw; the hammer splits logs."
	]
	quest.21F5A752996C9586.title: "Knife and Hammer"
	quest.220334E35F590E73.quest_desc: [
		"Fit a steering wheel on the deck. Hold right-click and turn it; its rotation steers the bearings it drives."
	]
	quest.220334E35F590E73.title: "Steering Wheel"
	quest.222144A9AFE56147.quest_desc: [
		"The pressurized reaction chamber makes HDPE from ethene. Lay up 64 sheets: the SPS casings of the Quantum Age take them."
	]
	quest.222144A9AFE56147.title: "HDPE"
	quest.2252A136E1B796AC.quest_desc: [
		"Build an armor-piercing shell in the mechanical crafter. It pierces blocks and bursts inside the walls behind them."
	]
	quest.2252A136E1B796AC.title: "Armor-Piercing Shell"
	quest.22B39386CC3DD54E.quest_desc: [
		"Take an egg from an emu. Boiled over the fire it makes a meal."
	]
	quest.22B39386CC3DD54E.title: "Emu Egg"
	quest.2303CB5F822C38B6.quest_desc: [
		"The apparatus on an arcane core with pedestals crafts the source items. It is the one magic pedestal crafting of this Age."
	]
	quest.2303CB5F822C38B6.title: "Enchanting Apparatus"
	quest.230D1D609551F243.quest_desc: [
		"Build a reaper and sit on it. It cuts the standing crop where the plow cut the rows."
	]
	quest.230D1D609551F243.title: "Reaper"
	quest.233A332A44850ABA.quest_desc: [
		"Assemble a CAD from an assembly, a core, a socket and a battery. Hold it and the spells answer."
	]
	quest.233A332A44850ABA.title: "CAD"
	quest.23536BC1524A5044.quest_desc: [
		"Fuse the Humming Core in the arc furnace: an HV capacitor, an Attuned Circuit, four aluminium plates, an Aurora Steel ingot and a Nether Star."
		""
		"Raise the Tesla Crown. Once your Tally Chutes have taken 512 aluminium ingots in this Age, lay the Core on the plinth, give the floodlights power and a signal, charge the capacitors with 1,000,000 FE and pray."
		""
		"Caelum opens the Information Age."
	]
	quest.23536BC1524A5044.quest_subtitle: "Goal of the Electric Age: Caelum opens the Information Age"
	quest.23536BC1524A5044.title: "Offer the Humming Core at the Shrine"
	quest.236E75C86B8075F7.quest_desc: [
		"Build a bulk cell. It stores a single kind of item in numbers no ordinary cell can hold."
	]
	quest.236E75C86B8075F7.quest_subtitle: "Mega Storage, off \"MEGA Cells\""
	quest.236E75C86B8075F7.title: "Bulk Cell"
	quest.238D92258CB69AD6.quest_desc: [
		"{image:firmages:textures/quests/build/silo_open.png width:128 height:128 align:center}"
		""
		"Sink a shaft 15 by 15 and nine deep. Shore its walls; the rock remembers every cut. Set the pad at the bottom."
	]
	quest.238D92258CB69AD6.title: "The Shaft"
	quest.23A2C7DF76F29DD2.quest_desc: [
		"Right-click fire bricks with blast furnace insulation. The chimney then needs no iron sheets around it."
	]
	quest.23A2C7DF76F29DD2.quest_subtitle: "Smith's Aids, off \"Blast Furnace\""
	quest.23A2C7DF76F29DD2.title: "Insulation"
	quest.23A4B5655F90BEFB.quest_desc: [
		"Raise an iron greenhouse. Bonsai fruit trees, bananas and berry trellises grow only under iron or better."
	]
	quest.23A4B5655F90BEFB.quest_subtitle: "Cellar and Glass, off \"Winter Stores\""
	quest.23A4B5655F90BEFB.title: "Iron Greenhouse"
	quest.23B75CB262B7C101.quest_desc: ["Mix clay with kaolinite and graphite powder into fire clay."]
	quest.23B75CB262B7C101.title: "Fireproof"
	quest.23B8CBEFB688315B.quest_desc: [
		"Cast the pig iron. Hammer it into high carbon steel, then into steel."
	]
	quest.23B8CBEFB688315B.title: "Pig Iron"
	quest.23BC6F4B7E13EC98.quest_desc: [
		"Bring home three raw hides of one size. Small, medium and large prey each give their own."
	]
	quest.23BC6F4B7E13EC98.title: "Hides"
	quest.23C92958F20BE038.quest_desc: ["A water wheel in flowing water gives rotational force."]
	quest.23C92958F20BE038.title: "Water Wheel"
	quest.23FDEA7AB60AEDAF.quest_desc: ["Gather greigite. It holds iron."]
	quest.23FDEA7AB60AEDAF.title: "Greigite"
	quest.2444E19A6383B59C.quest_desc: ["Hammer the bloom on an anvil until it becomes wrought iron."]
	quest.2444E19A6383B59C.title: "Wrought Iron"
	quest.24A9D87784D8AB92.quest_desc: [
		"Harvest insanium essence. Rare metals and the gems of the last tier are woven from it."
	]
	quest.24A9D87784D8AB92.title: "Insanium Essence"
	quest.24B73E0B6F871DEE.quest_desc: ["Spawn fluid turns into mobs, only those your Age allows."]
	quest.24B73E0B6F871DEE.title: "Mechanical Spawner"
	quest.24D85BC36ADF2596.quest_desc: [
		"Build the huge engine around a steam engine of the old Age. The old engine lives inside the new one."
	]
	quest.24D85BC36ADF2596.title: "Huge Engine"
	quest.2562E428698729A6.quest_desc: ["Land on Venus. Calorite lies under its clouds."]
	quest.2562E428698729A6.title: "Venus"
	quest.2636919E4AB2F40C.quest_desc: ["Build the tier 2 rocket from desh. It reaches Mars."]
	quest.2636919E4AB2F40C.title: "Tier 2 Rocket"
	quest.2640D22EE4D7FCF3.quest_desc: [
		"Set an advanced smelting factory and an advanced enriching factory on the osmium line, energy upgrades in both. Five stacks at once; the tally runs through them."
	]
	quest.2640D22EE4D7FCF3.title: "Factory Line"
	quest.26D594F0567CC39A.quest_desc: [
		"A bronze anvil forges bronze double sheets: the Sky Disc needs one."
	]
	quest.26D594F0567CC39A.title: "Bronze Anvil"
	quest.271B9FEFDBDBD98F.quest_desc: ["Weld two hot ingots into a double ingot on the stone anvil."]
	quest.271B9FEFDBDBD98F.title: "First Weld"
	quest.275B0719D6CB26D4.quest_desc: [
		"Set a jarring station by the vat. It fills lidded jars with jam and seals them by itself."
	]
	quest.275B0719D6CB26D4.title: "Jarring Station"
	quest.278ED51C30E57DC0.quest_desc: [
		"Build an advanced extended pattern provider. It holds many more patterns and sends each ingredient to the side you choose."
	]
	quest.278ED51C30E57DC0.title: "Advanced Pattern Provider"
	quest.27E68AB440FA98EB.quest_desc: [
		"Stitch envelopes into a balloon. The hot air inside lifts the hull above the clouds."
	]
	quest.27E68AB440FA98EB.title: "Envelope"
	quest.280FF1CBD99D0A4A.quest_desc: [
		"Dissolution, washing and crystallizing grow ore into crystals: five times the metal. Without energy upgrades it costs more power per ingot than injection."
	]
	quest.280FF1CBD99D0A4A.title: "Ore Times Five"
	quest.2871D429A8DFF9F5.quest_desc: [
		"Set a fluid hatch on a tank. Right-click it with a bucket to pour in or fill up, with no pipe needed."
	]
	quest.2871D429A8DFF9F5.title: "Fluid Hatch"
	quest.289281EB5946B550.quest_desc: [
		"Make 16 andesite alloy from andesite cobble and zinc nuggets, nine from an ingot. None nearby? Travel: the rock changes every few hundred blocks."
	]
	quest.289281EB5946B550.title: "Andesite Alloy"
	quest.28A963AA218A4EE4.quest_desc: [
		"Craft the Steel Heart from the Frontier Relic, a precision mechanism, a steel sheet and wrought iron double sheets."
		""
		"Raise the Iron Sanctum: four smooth rock pillars with wrought iron bars and four wrought iron lamps. Lay the Heart on the new plinth, light the lamps and pray."
		""
		"Caelum keeps the Heart and opens the Arcane Age."
	]
	quest.28A963AA218A4EE4.quest_subtitle: "Goal of the Iron Age: Caelum opens the Arcane Age"
	quest.28A963AA218A4EE4.title: "Offer the Steel Heart at the Shrine"
	quest.28C8DA2831BAE76D.quest_desc: [
		"Walk 1,000 blocks in all; sprinting does not count. Keep your eyes on the land as you go."
	]
	quest.28C8DA2831BAE76D.title: "Far from Home"
	quest.28D435DE48DE8B96.quest_desc: [
		"Set a splitter in the beam. It divides the light into up to four lines."
	]
	quest.28D435DE48DE8B96.title: "Laser Splitter"
	quest.28D6266AE2645300.quest_desc: [
		"Build a barrel packager. Liquid travels the package lines sealed in barrels."
	]
	quest.28D6266AE2645300.title: "Barrel Packager"
	quest.28EBCD46D69CDED4.quest_desc: [
		"Hunt a kangaroo on open, dry ground. Its hide is tough and warm."
	]
	quest.28EBCD46D69CDED4.quest_subtitle: "Strange Beasts, off \"Hunter\""
	quest.28EBCD46D69CDED4.title: "Kangaroo Hide"
	quest.29208AA5BC5ACFFC.quest_desc: [
		"Answer its attacks and the veil opens."
		"- First: hit the grounded keel or shoot the white node."
		"- Nine Lights: shoot the burning node, or strike as it pulls."
		"- Shatter: strike with an off-hand shard, or throw one."
	]
	quest.29208AA5BC5ACFFC.title: "The Primordial"
	quest.2921FAB6E716B68B.quest_desc: [
		"Roast acorns, chestnuts or hickory nuts at the fire. Raw, they are bitter."
	]
	quest.2921FAB6E716B68B.title: "Roasted Nuts"
	quest.294677522BA270B6.quest_desc: [
		"Set a gem cutter on the line. It cuts gems by machine where the table needed your hands."
	]
	quest.294677522BA270B6.title: "Gem Cutter"
	quest.29BB2D5846614E8A.quest_desc: [
		"Yellow brimstone crusts the rock beside open lava. Take it before the ground shakes again."
	]
	quest.29BB2D5846614E8A.title: "Brimstone"
	quest.29BB85F4AE1E4A82.quest_desc: [
		"Fusion power, the SPS, rockets to Venus and Glacio, awakened draconium and the Marid."
		""
		"Five strands lead to the Quantum Core: Fusion, Inner Planets, Awakened, Keystone and Sky. The Quantum Core is the last offering at the shrine."
		""
		"Caelum asks for proof of work this time: 3,584 calorite ingots fed into Tally Chutes in this Age."
	]
	quest.29BB85F4AE1E4A82.quest_subtitle: "The ninth Age"
	quest.29BB85F4AE1E4A82.title: "The Quantum Age Dawns"
	quest.29BF6EA4F2FCD8F4.quest_desc: [
		"Mine the tin and zinc veins you found and cast 16 tin and eight zinc: enough for the bronze anvil, the Sanctum and the brass of the Iron Age."
	]
	quest.29BF6EA4F2FCD8F4.title: "First Mine"
	quest.2A2E2D065C2E2DDD.quest_desc: [
		"Carry an altimeter and read your height. Below Y 0 the pale watcher walks."
	]
	quest.2A2E2D065C2E2DDD.title: "Altimeter"
	quest.2AA19A118F3D7E22.quest_desc: [
		"Metal can be worked or welded only while it is hot enough. Hover over it to read its heat."
	]
	quest.2AA19A118F3D7E22.title: "Working Heat"
	quest.2AA3E7314061B5F7.quest_desc: [
		"Launch a probe with a sampler module. It returns with voidglass, found nowhere else."
	]
	quest.2AA3E7314061B5F7.title: "Voidglass"
	quest.2AD10B433A5BEAFD.quest_desc: [
		"{image:firmages:textures/gui/quests/shrine/ring_2_build.apng.png width:220 height:155 align:center}"
		"Raise the Iron Sanctum round the Bronze Sanctum. 52 new blocks in four layers:"
		"- 39 smooth rock"
		"- eight iron bars"
		"- four iron lamps"
		"- the Offering Plinth"
		""
		"Right-click the heart with an empty hand: it shows every missing block as a ghost."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_2_layer_1.png width:220 height:155 align:center}"
		"Layer one of four, level with the heart: 31 smooth rock, the Offering Plinth."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_2_layer_2.png width:220 height:155 align:center}"
		"Layer two of four, one block up: eight iron bars, four smooth rock."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_2_layer_3.png width:220 height:155 align:center}"
		"Layer three of four, two blocks up: four smooth rock."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_2_layer_4.png width:220 height:155 align:center}"
		"Layer four of four, three blocks up: four iron lamps."
		"{@pagebreak}"
		"Lay the Steel Heart on the plinth."
		""
		"The rite:"
		"- Light the four lamps on the pillars."
		""
		"Then sneak and hold right-click on the heart with an empty hand. Caelum opens the Arcane Age."
	]
	quest.2AD10B433A5BEAFD.quest_subtitle: "The shrine ring of the Iron Age"
	quest.2AD10B433A5BEAFD.title: "Iron Sanctum"
	quest.2AD2DD3260EEBF7E.quest_desc: [
		"Upgrade the jetpack with netherite. It is the strongest the maker of air-wings gives."
	]
	quest.2AD2DD3260EEBF7E.title: "Netherite Jetpack"
	quest.2B261DA368AACAC7.quest_desc: [
		"Make 32 thatch, enough for walls and a roof. A hut of straw keeps the night out."
	]
	quest.2B261DA368AACAC7.title: "Walls of Straw"
	quest.2B9263D6A5FEA18B.quest_desc: [
		"Make eight energy upgrades for your ore machines. Without them the fourfold and fivefold ore lines cost more power than they gain."
	]
	quest.2B9263D6A5FEA18B.title: "Energy Upgrades"
	quest.2BBAAE526E05F938.quest_desc: [
		"Craft an insanium ingot from a prosperity ingot and insanium essence. It is the hardest metal the fields give."
	]
	quest.2BBAAE526E05F938.title: "Insanium Ingot"
	quest.2BE0D6CB6EF8C395.quest_desc: [
		"Lay up four buckets of diesel or kerosene by the pad. A tier 1 or 2 rocket in the silo waits full."
	]
	quest.2BE0D6CB6EF8C395.title: "Fuel Line"
	quest.2C29644013E0FBF2.quest_desc: [
		"Melt starsteel meteorite chunks in the arc furnace. The sky is its only source."
	]
	quest.2C29644013E0FBF2.title: "Starsteel"
	quest.2CB10148DF0C66A2.quest_desc: [
		"Forge a black steel drillhead. It bites rock that wrought iron cannot scratch."
	]
	quest.2CB10148DF0C66A2.title: "Black Steel Drillhead"
	quest.2CBD5C8E76F766A8.quest_desc: [
		"{image:firmages:textures/gui/quests/shrine/ring_3_build.apng.png width:220 height:149 align:center}"
		"Raise the Spirit Circle round the Iron Sanctum. 60 new blocks in four layers:"
		"- 35 gilded sourcestone"
		"- twelve otherstone"
		"- eight candles"
		"- four source gem blocks"
		"- the Offering Plinth"
		""
		"Right-click the heart with an empty hand: it shows every missing block as a ghost."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_3_layer_1.png width:220 height:149 align:center}"
		"Layer one of four, level with the heart: 35 gilded sourcestone, four otherstone, the Offering Plinth."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_3_layer_2.png width:220 height:149 align:center}"
		"Layer two of four, one block up: eight candles, four otherstone."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_3_layer_3.png width:220 height:149 align:center}"
		"Layer three of four, two blocks up: four otherstone."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_3_layer_4.png width:220 height:149 align:center}"
		"Layer four of four, three blocks up: four source gem blocks."
		"{@pagebreak}"
		"Lay the Arcane Keystone on the plinth."
		""
		"The rite:"
		"- Light the eight candles of the Spirit Circle."
		""
		"Then sneak and hold right-click on the heart with an empty hand. Caelum opens the Industrial Age."
	]
	quest.2CBD5C8E76F766A8.quest_subtitle: "The shrine ring of the Arcane Age"
	quest.2CBD5C8E76F766A8.title: "Spirit Circle"
	quest.2CBF6F7478F86FD5.quest_desc: [
		"Build a power loom from engineering blocks and form it with the Engineer's Hammer. It weaves cloth without a hand."
	]
	quest.2CBF6F7478F86FD5.title: "Power Loom"
	quest.2CDFC10C1482A709.quest_desc: ["The FE generator of this Age."]
	quest.2CDFC10C1482A709.title: "Gas-Burning Generator"
	quest.2CEDC0346E550CE6.quest_desc: [
		"The year has seasons. Crops stop growing in winter and it gets cold. Plan ahead."
	]
	quest.2CEDC0346E550CE6.title: "The First Winter"
	quest.2CF7A994345A2A94.quest_desc: [
		"Open the hatch and wake the pad with one signal. Ten heartbeats later the rocket rises through your own sky."
	]
	quest.2CF7A994345A2A94.quest_subtitle: "The sky opens from below"
	quest.2CF7A994345A2A94.title: "Launch from the Silo"
	quest.2D3669263769C21A.quest_desc: [
		"Set an experience hatch on a tank. Right-click to pour your own experience in; sneak and right-click to draw it back."
	]
	quest.2D3669263769C21A.quest_subtitle: "Industry of Enchantment, off \"Enchantment Industry\""
	quest.2D3669263769C21A.title: "Experience Hatch"
	quest.2D59040C3939B766.quest_desc: [
		"Wind a pirn with wool, fiber or silk. The loom weaves what the pirn carries."
	]
	quest.2D59040C3939B766.title: "Wound Pirn"
	quest.2DC5143776D7B7D7.quest_desc: [
		"Sixteen steel ingots. From here on, steel is a material, not a trophy."
	]
	quest.2DC5143776D7B7D7.title: "Steel Ingots"
	quest.2DE9049C7AF1B89F.quest_desc: [
		"Bake a blaze cake. A burner fed one runs superheated for a while without a fresh blaze."
	]
	quest.2DE9049C7AF1B89F.title: "Blaze Cake"
	quest.2E2C2CB5A88667ED.quest_desc: [
		"Set a propeller on a bearing at the stern. Turned by a shaft, it drives the ship forward."
	]
	quest.2E2C2CB5A88667ED.title: "Propeller Bearing"
	quest.2E30926B1075171A.quest_desc: [
		"Step through the gate. Gather, all of you, at the central altar to call the final battle. A gate on the arena dials home."
	]
	quest.2E30926B1075171A.title: "Into The Origin"
	quest.2EA26C8B23585E04.quest_desc: [
		"Hang a station clock on the platform wall. The schedule means little without a time to read."
	]
	quest.2EA26C8B23585E04.title: "Station Clock"
	quest.2EC89EF1F5DED2A1.quest_desc: [
		"Carry the rotation on shafts and cogwheels to a mechanical saw. It cuts logs into planks and lumber without a hand saw."
	]
	quest.2EC89EF1F5DED2A1.title: "Mechanical Saw"
	quest.2F3F6FA2AC454A70.quest_desc: [
		"Lay a platform at your station. Passengers and crates have somewhere to stand."
	]
	quest.2F3F6FA2AC454A70.title: "Station Platform"
	quest.2F40BC4F2411937D.quest_desc: ["Cassiterite pieces on the ground point to a tin vein below."]
	quest.2F40BC4F2411937D.title: "Tin on the Surface"
	quest.300C6E3765CDE12A.quest_desc: [
		"Set stoneshelves round the enchanting table. They lower Eterna and Arcana, for a weaker but surer enchantment."
	]
	quest.300C6E3765CDE12A.quest_subtitle: "Shelves of Power, off \"Enchantment Industry\""
	quest.300C6E3765CDE12A.title: "Stoneshelf"
	quest.3025445C8E744839.quest_desc: [
		"Raise ancient transport rings. Step inside, and they carry you to another set of rings nearby."
	]
	quest.3025445C8E744839.title: "Transport Rings"
	quest.30838230E7113E41.quest_desc: [
		"Add the Industrial lens and forge Aurora Steel from starsteel, red steel, storm glass and aurora light. The Humming Core needs it."
	]
	quest.30838230E7113E41.title: "Aurora Steel"
	quest.30A13F8701E9EF80.quest_desc: [
		"Build the Hearth Circle around the heart. Right-click the heart with an empty hand: it shows every missing block as a ghost."
		""
		"You need eight cobblestone, four log posts two high with thatch on top, and the Offering Plinth two blocks from the heart. Craft the plinth from four cobblestone (S):"
		"- S -"
		"S S S"
		""
		"When the circle is whole, the heart glows. Right-click it again to hear what Caelum asks for."
	]
	quest.30A13F8701E9EF80.title: "Raise the Shrine"
	quest.30B3B5086799C262.quest_desc: [
		"Build a drawer. Each front stores one kind of item in great number and gives a stack when you punch it."
	]
	quest.30B3B5086799C262.title: "Drawer"
	quest.31053371A45E76FF.quest_desc: [
		"Build a compost tumbler and turn it by axle. It takes bones, fish and sherds too, and asks for no exact mix."
	]
	quest.31053371A45E76FF.title: "Compost Tumbler"
	quest.3150B924AEF25965.quest_desc: [
		"Find a Hollow Keystone in a chest of a Nether fortress. A spout, two deployers and a press fill it in three passes: liquid experience, a blaze rod, Starlit Iron, the press."
	]
	quest.3150B924AEF25965.title: "Hollow Keystone"
	quest.318CB6D6673E6B76.quest_desc: [
		"Craft plastic blocks from HDPE and dye. They come in all 16 colors."
	]
	quest.318CB6D6673E6B76.quest_subtitle: "Refined Gear, off \"HDPE\""
	quest.318CB6D6673E6B76.title: "Plastic Blocks"
	quest.319CD4C9B74E8138.quest_desc: [
		"Chase a roadrunner across the flats and take its feather. It is quicker than you."
	]
	quest.319CD4C9B74E8138.title: "Roadrunner Feather"
	quest.31A4263D40A1EF78.quest_desc: [
		"Let the simulation run: 64 matrices are machine time, not hand work."
	]
	quest.31A4263D40A1EF78.title: "Prediction Matrices"
	quest.31AD386737065FFF.quest_desc: [
		"Build the fission reactor from 32 casings. Cool it well: a hot reactor melts down."
	]
	quest.31AD386737065FFF.title: "Fission Reactor"
	quest.31D8D96B76A155E7.quest_desc: [
		"Craft a draconic pickaxe straight from the awakened core. No lesser tool goes into it."
	]
	quest.31D8D96B76A155E7.title: "Draconic Tools"
	quest.3213BFEF5EB29C5C.quest_desc: [
		"Fire a small vessel, an ingot mold and a pickaxe head mold in one burn. The vessel melts ore; a firepit never gets hot enough. The molds take the liquid copper."
	]
	quest.3213BFEF5EB29C5C.title: "Pottery for Metal"
	quest.3240A673372AF11A.quest_desc: [
		"The offering of the Stone Age. Its build guide stands beside it."
	]
	quest.3240A673372AF11A.quest_subtitle: "Goal of the Stone Age"
	quest.3240A673372AF11A.title: "Hearthstone"
	quest.32B3BD93CA3C8CA0.quest_desc: [
		"Tap a hevea or a rubber fig for latex and boil it with sulfur into rubber bars. Three bars make four belts."
	]
	quest.32B3BD93CA3C8CA0.title: "Rubber"
	quest.32D33BE8EB20FCA6.quest_desc: [
		"The offering of the Electric Age. Its build guide stands beside it."
	]
	quest.32D33BE8EB20FCA6.quest_subtitle: "Goal of the Electric Age"
	quest.32D33BE8EB20FCA6.title: "Humming Core"
	quest.33112A95DBF89AC7.quest_desc: [
		"Hang a contraption on a chain pulley. It rides a chain where the rope pulley rides a rope."
	]
	quest.33112A95DBF89AC7.title: "Chain Pulley"
	quest.33195171B32CD51D.quest_desc: [
		"Brew wither spawn fluid if you dare. The star it bears is the one the Humming Core asks for."
	]
	quest.33195171B32CD51D.title: "Wither Fluid"
	quest.333133C7E32AE19D.quest_desc: [
		"Press 32 aluminium plates. Four go into the Humming Core, the rest into the machines of this Age."
	]
	quest.333133C7E32AE19D.title: "Aluminium Plates"
	quest.3358C99F9F19A863.quest_desc: [
		"Build a barrel press. Fermented grapes go in, and red, white or sparkling wine comes out."
	]
	quest.3358C99F9F19A863.title: "Barrel Press"
	quest.336329A8F7223BF0.quest_desc: [
		"Craft an inferium watering can. A splash on the field speeds every seed in its reach."
	]
	quest.336329A8F7223BF0.title: "Watering Can"
	quest.3379918EB4503611.quest_desc: [
		"Set a beehive among flowers and bring a queen in a skep. Its frames fill with honey; a full beekeeper suit stops the stings."
	]
	quest.3379918EB4503611.title: "Beehive"
	quest.33818E6B3089AF9E.quest_desc: [
		"The offering of the Space Age. Its build guide stands beside it."
	]
	quest.33818E6B3089AF9E.quest_subtitle: "Goal of the Space Age"
	quest.33818E6B3089AF9E.title: "Star Chart"
	quest.339049C0883429BA.quest_desc: [
		"Set it under the centre of a burning fusion reactor. Its neutrons turn nuclear waste into polonium and lithium into tritium, day and night."
	]
	quest.339049C0883429BA.title: "Fusion Neutron Activator"
	quest.33BEA94E7673D21D.quest_desc: [
		"No portal leads to the Nether in this land. It opens to a sacrifice:"
		"- Set at least seven offerings within five blocks of one spot: anvils, mob heads, gold or black steel blocks, or piles of gold, pig iron or black steel ingots."
		"- Kill a goat, pig or sheep there with a scythe."
		""
		"The ground bursts and a portal opens where you stand. Step through and look for iesnium."
	]
	quest.33BEA94E7673D21D.title: "The Way Below"
	quest.33C11901A7A16BA3.quest_desc: [
		"Open a ruin chest. Its goods follow your Age: flint, glue, yarn and charcoal at first."
	]
	quest.33C11901A7A16BA3.title: "What the Ruin Kept"
	quest.3439831B7895C627.quest_desc: [
		"Each magic function has one carrier: Starbuncles move items, Dimensional Storage stores them, spagyrics multiply ore, the Djinni crafts in pentacles."
	]
	quest.3439831B7895C627.title: "One Carrier per Function"
	quest.346CC5CACE990B24.quest_desc: [
		"{image:firmages:textures/gui/quests/shrine/ring_1_build.apng.png width:220 height:141 align:center}"
		"Raise the Bronze Sanctum round the Hearth Circle. 25 new blocks in two layers:"
		"- 19 rock bricks"
		"- four bronze blocks"
		"- one bell, bronze or brass"
		"- the Offering Plinth"
		""
		"Right-click the heart with an empty hand: it shows every missing block as a ghost."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_1_layer_1.png width:220 height:141 align:center}"
		"Layer one of two, level with the heart: 19 rock bricks, four bronze blocks, the Offering Plinth."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_1_layer_2.png width:220 height:141 align:center}"
		"Layer two of two, one block up: one bell, bronze or brass."
		"{@pagebreak}"
		"Lay the Sky Disc on the plinth."
		""
		"The rite:"
		"- Ring the bell of the sanctum."
		""
		"Then sneak and hold right-click on the heart with an empty hand. Caelum opens the Iron Age."
	]
	quest.346CC5CACE990B24.quest_subtitle: "The shrine ring of the Bronze Age"
	quest.346CC5CACE990B24.title: "Bronze Sanctum"
	quest.349C4476B51DAC16.quest_desc: [
		"Fill the bloomery with iron ore and charcoal and let it burn."
	]
	quest.349C4476B51DAC16.title: "In Bloom"
	quest.34A20DCC53F255CC.quest_desc: [
		"{image:firmages:textures/quests/device/blast_furnace.png width:128 height:128 align:center}"
		""
		"The blast furnace makes pig iron from iron ore, charcoal and flux."
	]
	quest.34A20DCC53F255CC.title: "Blast Furnace"
	quest.3544B98B44E7DD28.quest_desc: [
		"Leave a stand of trees beside a clearing. Their leaves seed saplings around them and the forest closes in. Dig one up."
	]
	quest.3544B98B44E7DD28.title: "Forests Close"
	quest.354A9C13E074B572.quest_desc: [
		"Datura seeds drop from grass. Plant them on Arcane Soil, dirt charged with amethyst; plain farmland will not hold them."
	]
	quest.354A9C13E074B572.title: "Datura"
	quest.35875349E1B00375.quest_desc: [
		"Make engine pistons from andesite alloy, a shaft and zinc. Every diesel engine is built around them."
	]
	quest.35875349E1B00375.quest_subtitle: "Diesel Engines, off \"Diesel Generator\""
	quest.35875349E1B00375.title: "Engine Piston"
	quest.35AFC9346F30C43A.quest_desc: [
		"Fly the tier 3 rocket to Mercury and mine 16 raw naquadah there with a digital miner. No other tool reaches it."
	]
	quest.35AFC9346F30C43A.title: "Naquadah"
	quest.35EA1200D7712B4C.quest_desc: [
		"Weld electrum into a double ingot. Gold and silver, tamed for the wire of the next Age."
	]
	quest.35EA1200D7712B4C.title: "Electrum Double Ingot"
	quest.360F8121259AAE75.quest_desc: [
		"Take a lump of jet from the rock beside lava. Each lava field grows its own mineral, so seek one that gives jet."
	]
	quest.360F8121259AAE75.title: "Black Jet"
	quest.369057F8A5EDCD0C.quest_desc: [
		"Craft the deep learner and a blank data model. The learner trains the model while you fight; a blank model learns one mob."
	]
	quest.369057F8A5EDCD0C.title: "Deep Learner"
	quest.369D6AB773B5893E.quest_desc: [
		"Fill a bucket with spawn fluid of the pig or the cow. The spawner turns it into living stock."
	]
	quest.369D6AB773B5893E.quest_subtitle: "Liquid Beasts, off \"Nether Star\""
	quest.369D6AB773B5893E.title: "Spawn Fluid"
	quest.36A59893ED5389B6.quest_desc: ["The imbuement chamber charges items with source."]
	quest.36A59893ED5389B6.title: "Imbuement Chamber"
	quest.36C48EC86A43AA92.quest_desc: [
		"Sequenced assembly on a brass base. Many Iron Age machines need it."
	]
	quest.36C48EC86A43AA92.title: "Precision Mechanism"
	quest.373193C62E3C9E35.quest_desc: [
		"Make the mercury catalyst, the proof of the Alchemy strand. The Arcane Keystone needs it. A divination rod points to the ore veins your Age has woken."
	]
	quest.373193C62E3C9E35.title: "Mercury Catalyst"
	quest.378FC88D44613059.quest_desc: [
		"Build a large gas-burning generator. It burns the gas of your lines in a single, bigger flame."
	]
	quest.378FC88D44613059.title: "Large Gas Generator"
	quest.3815DB396BBFB360.quest_desc: [
		"Feed 3,584 calorite ingots into Tally Chutes in this Age. They keep what they take; a chute or the heart shows the count."
	]
	quest.3815DB396BBFB360.title: "Proof of Work"
	quest.38790CD14A01A1C1.quest_desc: [
		"Move Source through a Source jar network or through the ME network. Machines carry magic, magic never carries machines."
	]
	quest.38790CD14A01A1C1.title: "Source Cell"
	quest.38BA8AD136589CDA.quest_desc: [
		"Build the draconic reactor and bring it online. Its spent fuel comes out as chaos fragments, and only it can power the Stargate."
	]
	quest.38BA8AD136589CDA.title: "Reactor Online"
	quest.38EE69E0921920DA.quest_desc: [
		"Fit a 128M quantum computer storage block. One job can grow as large as the plan of a whole factory."
	]
	quest.38EE69E0921920DA.title: "Quantum Storage"
	quest.38F34424874DA620.quest_desc: [
		"Place an inventory proxy. It lends its face to the chest it points at, so one terminal reaches farther."
	]
	quest.38F34424874DA620.title: "Inventory Proxy"
	quest.396E32528216E999.quest_desc: [
		"Shake a rattle at the totem. Sneak while you play to choose the ceremony."
	]
	quest.396E32528216E999.title: "Rattle"
	quest.398B809EEA8DDFB5.quest_desc: [
		"Make a 1M cell component. MEGA cells hold far more than the first cells."
	]
	quest.398B809EEA8DDFB5.title: "MEGA Cells"
	quest.39C04B4B6284AEE6.quest_desc: [
		"Build an extended interface. It exposes more slots to the machines around it."
	]
	quest.39C04B4B6284AEE6.title: "Extended Interface"
	quest.39CD760BC12D7E53.quest_desc: [
		"Build a schematic table. A schematic of an engineering machine lists its blocks, and the Hammer forms it."
	]
	quest.39CD760BC12D7E53.title: "Schematic Table"
	quest.3A12C121F4CA3C7A.quest_desc: [
		"Hang a rope from a beam or a bridge post. Climb it, lower a lamp on it, tie it to a post."
	]
	quest.3A12C121F4CA3C7A.quest_subtitle: "Hearth Odds, off \"The Bronze Age Dawns\""
	quest.3A12C121F4CA3C7A.title: "A Hanging Rope"
	quest.3A44A36D7EE32C9C.quest_desc: [
		"Fit an iris over the gate. It closes the horizon to what should not come through."
	]
	quest.3A44A36D7EE32C9C.title: "Iris"
	quest.3A4CC2E27A1A6B30.quest_desc: [
		"Stand a redstone pole and power it. Grab it and you slide up the shaft as the wooden pole let you down."
	]
	quest.3A4CC2E27A1A6B30.title: "Lift Pole"
	quest.3A5D0F3FAA56A074.quest_desc: ["Copper ore pieces lie on the surface above copper veins."]
	quest.3A5D0F3FAA56A074.title: "Native Copper"
	quest.3A926BAFE803B76E.quest_desc: [
		"Break a meteorite in a crater. On some clear nights a star falls a few thousand blocks away; old cold craters lie in new land."
	]
	quest.3A926BAFE803B76E.title: "A Falling Star"
	quest.3A9B2D0625634821.quest_desc: [
		"Place an open crate. The block in front of it becomes an inventory, and what falls in lies on the ground."
	]
	quest.3A9B2D0625634821.title: "Open Crate"
	quest.3AA65FA513DA3CEC.quest_desc: ["Coke burns hot and clean. The blast furnace needs it."]
	quest.3AA65FA513DA3CEC.title: "Coal Coke"
	quest.3AAA62DD08565D0D.quest_desc: [
		"Build a handcar and pump it along your track. It is a train for one while the locomotive waits."
	]
	quest.3AAA62DD08565D0D.quest_subtitle: "The Line, off \"Trains\""
	quest.3AAA62DD08565D0D.title: "Handcar"
	quest.3B249CF88F286E7D.quest_desc: [
		"Bind the Arcane Keystone in the Djinni's crafting pentacle from the proofs of the magic strands."
	]
	quest.3B249CF88F286E7D.title: "The Spirit Route"
	quest.3B35B4F1EAA55F1D.quest_desc: [
		"Add the Space lens and forge Quasar Alloy from voidglass, calorite, a deep-space sample and aurora light. The Quantum Core needs it."
	]
	quest.3B35B4F1EAA55F1D.title: "Quasar Alloy"
	quest.3B588CB49C0F4193.quest_desc: [
		"Knap two, five clay each, and fire them in a pit kiln. One becomes the heart of the shrine, the other the Hearthstone."
		""
		"{image:firmages:textures/quests/knapping/hearth_idol.png width:64 height:64 align:center}"
	]
	quest.3B588CB49C0F4193.title: "Hearth Idol"
	quest.3B636FCBEF145ABE.quest_desc: ["Smith any bronze tool."]
	quest.3B636FCBEF145ABE.title: "First Bronze Tool"
	quest.3B99EB35C7692364.quest_desc: ["Frogports send packages along chain conveyors."]
	quest.3B99EB35C7692364.title: "Frogport"
	quest.3BAC7E39FA05241C.quest_desc: [
		"{image:firmages:textures/quests/device/quern.png width:128 height:128 align:center}"
		""
		"Craft a quern and a handstone. Grind borax, lime or other flux stones in it. Welding needs flux."
	]
	quest.3BAC7E39FA05241C.title: "In Flux"
	quest.3BC6283B6C5CF1A4.quest_desc: [
		"Craft a logic gauge. It joins signals as AND or OR, and it can hold a factory gauge back until the rule is met."
	]
	quest.3BC6283B6C5CF1A4.title: "Logic Gauge"
	quest.3C03E230F16471D7.quest_desc: [
		"Launch a probe with a deep-space module. It brings back deep-space samples, found nowhere else."
	]
	quest.3C03E230F16471D7.title: "Deep-Space Sample"
	quest.3C20172D20B6628A.quest_desc: [
		"Fit a silencer to the exhaust. The engine stops roaring at your sleeping friends."
	]
	quest.3C20172D20B6628A.title: "Silencer"
	quest.3C29CE19D8BA12F8.quest_desc: [
		"The Foliot and Djinni binding books each take a precision mechanism. The machine line builds the miner of the spirits."
	]
	quest.3C29CE19D8BA12F8.title: "Bound by Gears"
	quest.3C30E69F299AB5D5.quest_desc: [
		"Gather eight bones from your kills. A bone serves as a tool shaft where sticks run short."
	]
	quest.3C30E69F299AB5D5.title: "Bones"
	quest.3C8510408C6A23D6.quest_desc: [
		"The offering of the Quantum Age. Its build guide stands beside it."
	]
	quest.3C8510408C6A23D6.quest_subtitle: "Goal of the Quantum Age"
	quest.3C8510408C6A23D6.title: "Quantum Core"
	quest.3C9D31349113519E.quest_desc: [
		"Build an energy store of casing and ports with cells inside. Each cell deepens the store, and its ports take and give power."
	]
	quest.3C9D31349113519E.title: "Energy Storage Cell"
	quest.3C9E8304B6F53808.quest_desc: [
		"Craft a wyvern necklace. Worn at the throat, it carries armor modules as a chestplate does."
	]
	quest.3C9E8304B6F53808.quest_subtitle: "Chain of Necklaces, off \"Chaos Fragments\""
	quest.3C9E8304B6F53808.title: "Wyvern Necklace"
	quest.3D162BE36B397E2B.quest_desc: [
		"Fit a turbine. It takes some of the burning back to drive the compressor."
	]
	quest.3D162BE36B397E2B.title: "Turbine"
	quest.3D192C0507660A42.quest_desc: [
		"Craft a mixing bowl. Dough and batter are mixed in it before they go into the oven."
	]
	quest.3D192C0507660A42.title: "Mixing Bowl"
	quest.3D1D49324454F634.quest_desc: ["Make a full space suit. Off-world it carries your air."]
	quest.3D1D49324454F634.title: "Space Suit"
	quest.3E3CE4C327FE1A6A.quest_desc: [
		"Load a program into a spell bullet and slot it in the CAD. Other bullets cast it as a shot, a mine or a loop."
	]
	quest.3E3CE4C327FE1A6A.title: "Spell Bullet"
	quest.3E966315791F2727.quest_desc: [
		"Make a mineral prospector. It searches a great cube around the blow, but only for ores that are not metal."
	]
	quest.3E966315791F2727.title: "Mineral Prospector"
	quest.3EAA8BE972DC58F9.quest_desc: [
		"Alloy copper and zinc into brass, by hand in the crucible or in a basin over a fuel heater."
	]
	quest.3EAA8BE972DC58F9.title: "Brass"
	quest.3ED002184582F3AB.quest_desc: [
		"Build a stone chimney over the forge. The smoke rises clear of the roof and harms nobody."
	]
	quest.3ED002184582F3AB.quest_subtitle: "Smoke and Poles, off \"Forging\""
	quest.3ED002184582F3AB.title: "A Chimney"
	quest.3EE6C5BD7624537B.quest_desc: [
		"Place an inventory connector. Every chest that touches it joins one list for the terminal."
	]
	quest.3EE6C5BD7624537B.quest_subtitle: "Terminals and Packs, off \"Stock Ticker\""
	quest.3EE6C5BD7624537B.title: "Inventory Connector"
	quest.3F05F326F8CF2577.quest_desc: [
		"{image:firmages:textures/quests/ponder/silo_hatch.png width:128 height:128 align:center click_action:custom_event:firmages:ponder/ad_astra/launch_pad text:Click%20to%20watch}"
		"Glue two leaves over the shaft. Each rides a gantry carriage and slides into a pocket under the rim."
	]
	quest.3F05F326F8CF2577.title: "The Hatch"
	quest.3F2796853AD668B5.quest_desc: [
		"Gather eight storm glass from your Storm Rods; they are its only source. With meteoric iron it becomes Starlit Iron under the Lens Crown, the first celestial alloy."
	]
	quest.3F2796853AD668B5.title: "Storm Glass"
	quest.3F3FE750CB712E39.quest_desc: [
		"Craft the sacrificial altar. It holds a ritual in place of the golden bowl and pays its cost in source from nearby jars."
	]
	quest.3F3FE750CB712E39.title: "The Joined Altar"
	quest.3F543B7459A71C09.quest_desc: [
		"Raise a copper greenhouse. Frost stays outside and crops grow through the cold months."
	]
	quest.3F543B7459A71C09.title: "Under Glass"
	quest.3F8D45ADF9515576.quest_desc: [
		"Tick this when your cellar holds sealed vessels with enough food for all of you. No food goes into any recipe or turn-in."
	]
	quest.3F8D45ADF9515576.title: "Winter Stores"
	quest.3F916E93EBA922A5.quest_desc: [
		"{image:firmages:textures/gui/quests/shrine/ring_4.png width:180 height:124 align:center click_action:open_quest:16D1C406E00151F0 text:Open%20the%20build%20guide}"
		"Raise the Foundry Nave around the Spirit Circle: coke bricks, heavy engineering block bases, steel scaffolding and four electric lanterns. The heart shows every missing block."
	]
	quest.3F916E93EBA922A5.quest_subtitle: "The shrine ring of this Age"
	quest.3F916E93EBA922A5.title: "Raise the Foundry Nave"
	quest.40280EBC4CC9F8F6.quest_desc: [
		"The offering of the Information Age. Its build guide stands beside it."
	]
	quest.40280EBC4CC9F8F6.quest_subtitle: "Goal of the Information Age"
	quest.40280EBC4CC9F8F6.title: "Data Matrix"
	quest.40B43DE8640EAB9B.quest_desc: ["Mining raw stone can collapse the ceiling."]
	quest.40B43DE8640EAB9B.title: "Cave-ins"
	quest.40BDDBC61D9D82C3.quest_desc: [
		"{image:firmages:textures/gui/quests/shrine/ring_8.png width:180 height:111 align:center click_action:open_quest:049DBB559FB718EA text:Open%20the%20build%20guide}"
		"Raise the Quantum Ring around the Star Spire: calorite blocks, SPS casings or fusion reactor frames, and awakened draconium pylons. The heart shows every missing block."
	]
	quest.40BDDBC61D9D82C3.quest_subtitle: "The shrine ring of this Age"
	quest.40BDDBC61D9D82C3.title: "Raise the Quantum Ring"
	quest.40FA4C9F6A00F51F.quest_desc: [
		"Bring 64 steel sheets from your press line through the package network."
	]
	quest.40FA4C9F6A00F51F.title: "Backfill Line"
	quest.410089BAECE00BB6.quest_desc: [
		"Make cart wheels. Every cart and contraption of the field rolls on them."
	]
	quest.410089BAECE00BB6.quest_subtitle: "Wheels of the Field, off \"Water Wheel\""
	quest.410089BAECE00BB6.title: "Cart Wheel"
	quest.41040BCCCFEF6572.quest_desc: [
		"Span a gap with girder struts. They run straight or at an angle between two anchor points."
	]
	quest.41040BCCCFEF6572.title: "Girder Strut"
	quest.4151345FA96F7BF6.quest_desc: [
		"Fill a big cartridge with powder. The charge decides how far the shell flies."
	]
	quest.4151345FA96F7BF6.title: "A Big Cartridge"
	quest.418C81DD568EB184.quest_desc: [
		"Set a laser fence source in a doorway. Light stands in the gap and holds back what is not welcome."
	]
	quest.418C81DD568EB184.title: "Laser Fence"
	quest.41B3251BB5EB3A3A.quest_desc: [
		"Destroy the crystals, then the dragon, and bottle four breaths of it. Brewers and enchanters want them."
	]
	quest.41B3251BB5EB3A3A.title: "Dragon's Breath"
	quest.41B46B0D9C0E8AB4.quest_desc: [
		"Sphalerite pieces point to a zinc vein. Kinetic machines need zinc."
	]
	quest.41B46B0D9C0E8AB4.title: "Zinc on the Surface"
	quest.41EB0942305C67D2.quest_desc: [
		"Craft fleshing blades now for the fleshing machine of the next Age. Fitted to it, they scrape hides with no hand on the knife."
	]
	quest.41EB0942305C67D2.title: "Fleshing Blades"
	quest.41F6B8884809B526.quest_desc: [
		"Craft the Dictionary of Spirits and white chalk. The book explains every pentacle and ritual; white chalk is enough for Foliot rituals."
	]
	quest.41F6B8884809B526.title: "White Chalk"
	quest.4207F8051EF451B3.quest_desc: [
		"Fire is tamed. Clay is yours now, and with it pottery, molds and copper."
		""
		"Four strands lead to the Hearthstone: Fire & Clay, First Metal, Camp, and Hearth & Shrine. The last one raises the shrine where the Hearthstone is offered to Caelum."
	]
	quest.4207F8051EF451B3.quest_subtitle: "The first Age"
	quest.4207F8051EF451B3.title: "The Stone Age Dawns"
	quest.426D09E37975EC57.quest_desc: [
		"A tool for everything, built directly from the chaotic core."
	]
	quest.426D09E37975EC57.title: "Chaotic Staff"
	quest.42BF4D07BA145527.quest_desc: [
		"Hydrogen chloride in the injection chamber breaks ore into shards: four times the metal. Without energy upgrades it costs more power per ingot than purification."
	]
	quest.42BF4D07BA145527.title: "Ore Times Four"
	quest.4304B6AA00C231E8.quest_desc: [
		"Hover over a machine in your inventory and hold W to watch it work."
	]
	quest.4304B6AA00C231E8.title: "Kinetics in the Bronze Age"
	quest.4343CC0402E9CAFA.quest_desc: [
		"Attach a network link to a threshold switch. A blaze burner is then fed only when it needs fuel."
	]
	quest.4343CC0402E9CAFA.quest_subtitle: "Gauges and Ledgers, off \"Factory Gauge\""
	quest.4343CC0402E9CAFA.title: "Network Link"
	quest.43C52E01ADB93C69.quest_desc: [
		"Craft a chaotic necklace, the last link of the chain, and fill it with your strongest modules."
	]
	quest.43C52E01ADB93C69.title: "Chaotic Necklace"
	quest.43EE716147A43CFE.quest_desc: [
		"Wire four lamps to a redstone link. One lever by the door lights the whole house."
	]
	quest.43EE716147A43CFE.title: "Lights on a Link"
	quest.43FC2CC39EF5EFE5.quest_desc: [
		"Make four elite control circuits. The reactor parts run on them."
	]
	quest.43FC2CC39EF5EFE5.title: "Elite Circuits"
	quest.4415ABCFC16542F5.quest_desc: [
		"Fit an engine compressor. It squeezes the air before it meets the fire."
	]
	quest.4415ABCFC16542F5.title: "Compressor"
	quest.4464DD1B66CAE62D.quest_desc: [
		"Set a wooden generator beside a wooden water wheel or windmill. Its turning becomes SU for your machines."
	]
	quest.4464DD1B66CAE62D.title: "Wooden Generator"
	quest.448BD3A078F6BB33.quest_desc: [
		"Hang a train door on the coach. It opens at the platform and shuts before the line moves."
	]
	quest.448BD3A078F6BB33.title: "Train Door"
	quest.44968B0BE887DA25.quest_desc: [
		"Hammer loose dacite or basalt into powder and wash it in a barrel of water. Welded to iron or zinc, it makes andesite alloy."
	]
	quest.44968B0BE887DA25.quest_subtitle: "Mechanical Odds, off \"Crushing Wheels\""
	quest.44968B0BE887DA25.title: "Andesite Powder"
	quest.44ABD64FACE0D764.quest_desc: [
		"{image:firmages:textures/gui/quests/shrine/complete.png width:200 height:147 align:center}"
		""
		"From the Stone Age on, every Age ends at the shrine. Raise the ring of the Age round the heart, lay the offering on the plinth and pray."
		""
		"The diamonds along the road are the build guides: the ring rising, every layer with its blocks, and the rite. Each appears when its Age dawns."
	]
	quest.44ABD64FACE0D764.title: "The Shrine of Caelum"
	quest.44B3F8C53C417220.quest_desc: [
		"MV and HV power, oil, the arc furnace and the excavator. Bauxite and osmium veins wake: the Information Age needs osmium at once."
		""
		"Five strands lead to the Humming Core: Power Grid, Oil, Aluminium & Excavator, Circuits and Sky."
		""
		"Caelum asks for proof of work this time: 512 aluminium ingots fed into Tally Chutes in this Age."
	]
	quest.44B3F8C53C417220.quest_subtitle: "The sixth Age"
	quest.44B3F8C53C417220.title: "The Electric Age Dawns"
	quest.44FB988268E119B4.quest_desc: [
		"Fuse the Star Chart at wyvern level: a polonium pellet in the middle, a desh plate, a Void Steel ingot, two ostrum plates, a wyvern core and the flight recorder from Mars."
		""
		"Raise the Star Spire. Once your Tally Chutes have taken 2,880 desh ingots in this Age, lay the Chart on the plinth and pray at night, under an open sky, without rain."
		""
		"Caelum opens the Quantum Age."
	]
	quest.44FB988268E119B4.quest_subtitle: "Goal of the Space Age: Caelum opens the Quantum Age"
	quest.44FB988268E119B4.title: "Offer the Star Chart at the Shrine"
	quest.4560A9137AF93A36.quest_desc: [
		"Set a cannon drill on the cast tube. It bores the barrel true, one block of steel at a time."
	]
	quest.4560A9137AF93A36.title: "Cannon Drill"
	quest.4581C5CB23AD4CD5.quest_desc: ["The first fire. It opens the Stone Age."]
	quest.4581C5CB23AD4CD5.quest_subtitle: "Goal of Dawn"
	quest.4581C5CB23AD4CD5.title: "The First Spark"
	quest.45A2C462480FC269.quest_desc: [
		"Build a mechanical grindstone. It wears the enchantments off old gear and gives their experience back."
	]
	quest.45A2C462480FC269.title: "Mechanical Grindstone"
	quest.46601FCDB82F1D6F.quest_desc: [
		"Boil maple or birch sap to syrup in a pot, then craft the syrup into sugar. Sweet food keeps a winter camp cheerful."
	]
	quest.46601FCDB82F1D6F.title: "Syrup and Sugar"
	quest.46A84ED2704A67FB.quest_desc: [
		"Carry a portable stock ticker. Order from your stores wherever you walk."
	]
	quest.46A84ED2704A67FB.title: "Portable Stock Ticker"
	quest.46DF21F2D2D5904C.quest_desc: [
		"Feed 384 steel ingots into Tally Chutes in this Age. They keep what they take; a chute or the heart shows the count."
	]
	quest.46DF21F2D2D5904C.title: "Proof of Work"
	quest.470272BFC8013E57.quest_desc: [
		"Bind horn, wing and spike of the Wilden with source in the enchanting apparatus, or take the tribute from the Wilden Chimera. Keep it: the Djinni ritual of the Arcane Keystone needs it."
	]
	quest.470272BFC8013E57.title: "Wilden Tribute"
	quest.47EADFDE57EAF836.quest_desc: [
		"{image:firmages:textures/gui/quests/shrine/ring_0_build.apng.png width:220 height:162 align:center}"
		"Craft the Shrine Heart from a fired Hearth Idol, cobblestone and charcoal (Stone Age, Hearth & Shrine). Set it where 21 by 21 blocks stay free: each Age adds a ring. The Offering Plinth is four cobblestone."
		""
		"Build the Hearth Circle round the Shrine Heart. 21 new blocks in three layers:"
		"- eight logs of any tree"
		"- eight cobblestone of any rock"
		"- four thatch"
		"- the Offering Plinth"
		""
		"Right-click the heart with an empty hand: it shows every missing block as a ghost."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_0_layer_1.png width:220 height:162 align:center}"
		"Layer one of three, level with the heart: eight cobblestone of any rock, four logs of any tree, the Offering Plinth."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_0_layer_2.png width:220 height:162 align:center}"
		"Layer two of three, one block up: four logs of any tree."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_0_layer_3.png width:220 height:162 align:center}"
		"Layer three of three, two blocks up: four thatch."
		"{@pagebreak}"
		"Lay the Hearthstone on the plinth."
		""
		"The rite:"
		"- The heart is cold. Kindle it with a firestarter."
		""
		"Then sneak and hold right-click on the heart with an empty hand. Caelum opens the Bronze Age."
	]
	quest.47EADFDE57EAF836.quest_subtitle: "The shrine ring of the Stone Age"
	quest.47EADFDE57EAF836.title: "Hearth Circle"
	quest.48005F99E5E4AF80.quest_desc: [
		"Search fortress and bastion chests for a caster tome of one element. It casts its written spell with no glyphs of your own."
	]
	quest.48005F99E5E4AF80.title: "An Element Tome"
	quest.48429F79B39E7C02.quest_desc: [
		"Find a blank tome in a fortress or bastion chest. Inscribed on an ancient altar with a cut gem, it carries one enchantment."
	]
	quest.48429F79B39E7C02.quest_subtitle: "The Hot Dark, off \"The Way Below\""
	quest.48429F79B39E7C02.title: "Book of the Deep"
	quest.484BD83C5FBABCE1.quest_desc: [
		"Any wood works:"
		"- Palisade: two logs side by side. Beam: two stripped logs stacked."
		"- Support: three planks in an L. Seat: a slab above a fence."
		"- Timber frame: four sticks in a diamond. Cross brace: a stick in each corner. Brace: sticks in two opposite corners and both sides. Daub in the middle: the daub version."
		"- Daub: two clay and two straw, crossed. Rope: three jute fiber stacked."
		"- Rope bridge: string in the top corners, three slabs below. Log bridge: the same with fences. Rail bridge: fences in the corners over fence, slab, fence. Pier: log, fence, log. Six bridges as a staircase: bridge stairs."
	]
	quest.484BD83C5FBABCE1.title: "A Home"
	quest.485FE6EFB6565F6E.quest_desc: [
		"Take the Arcane Keystone from its plinth (sneak and right-click the plinth with an empty hand), or make a second one. Awaken it by fusion at draconic level: the Keystone on the fusion core, four atomic alloys, a wyvern core and a subatomic alloy in the injectors. With magic, the Marid ritual does it with two atomic alloys."
		""
		"Lay the Awakened Keystone back on its plinth. It stays the relic of the Arcane Age and goes into the Ultimate Singularity."
	]
	quest.485FE6EFB6565F6E.title: "Awakened Keystone"
	quest.4868CA77D43496DE.quest_desc: [
		"Build the tier 1 rocket. It reaches the Moon and no further."
	]
	quest.4868CA77D43496DE.title: "Tier 1 Rocket"
	quest.486B7720D498A44B.quest_desc: [
		"Find a ruin: toppled walls and chests, in the open and on the beaches. Step inside."
	]
	quest.486B7720D498A44B.quest_subtitle: "Old Stones, off \"The Stone Age Dawns\""
	quest.486B7720D498A44B.title: "A Fallen House"
	quest.4873B8AFF7C2489F.quest_desc: [
		"Craft a keg, a barrel two blocks high and wide. It holds far more goods or fluid than a plain barrel."
	]
	quest.4873B8AFF7C2489F.title: "Keg"
	quest.48803AB38AE3E466.quest_desc: [
		"Press K to open the Chronicle. Sneak is Left Ctrl here; Left Shift sprints."
		""
		"Press V to lay the item in your hand on a block. Hold H to see the sign of your Age again."
	]
	quest.48803AB38AE3E466.title: "Hands and Keys"
	quest.48FEA2290AA48A7E.quest_desc: [
		"Seal curdled milk with cheesecloth in a barrel for curds, then age the wheel in a cellar. It keeps for seasons."
	]
	quest.48FEA2290AA48A7E.title: "A Wheel of Cheese"
	quest.48FECE3C222A44BF.quest_desc: [
		"Upgrade the pack with copper. It holds more, and it takes more upgrades."
	]
	quest.48FECE3C222A44BF.quest_subtitle: "Packs and Drawers, off \"Pack Mule\""
	quest.48FECE3C222A44BF.title: "Copper Pack"
	quest.4914DB06E3F96086.quest_desc: [
		"Bind a Djinni into a book of binding. A Djinni runs crafting rituals and the Mineshaft."
	]
	quest.4914DB06E3F96086.title: "Bind a Djinni"
	quest.49153BBE2AD958B7.quest_desc: [
		"Begin with stone, straw and the hunt."
		""
		"Five strands lead out of Dawn: Stone, Shelter, Hunt, Forage and Sky. Share them out. Read \"By Hand\" and \"Hands and Keys\" in The Firmament first."
		""
		"Nights are dark. Light a fire and make torches before the first one (see \"Before Dark\"). When all five strands are done, the first fire opens the Stone Age for all of you."
	]
	quest.49153BBE2AD958B7.quest_subtitle: "The prologue before the first Age"
	quest.49153BBE2AD958B7.title: "Welcome to the Wild"
	quest.493FDDDF33995C91.quest_desc: [
		"Set a target dummy in the yard. Strike it with your new blade and read the damage it shows."
	]
	quest.493FDDDF33995C91.title: "Target Dummy"
	quest.4954E2BC98921D04.quest_desc: [
		"Make two antimatter pellets in the SPS. Both go into the Quantum Core."
		""
		"Each pellet takes 100,000 mB polonium and 40,000,000,000 FE: about 40 minutes of a turbine-fed fusion plant."
	]
	quest.4954E2BC98921D04.title: "Antimatter Pellets"
	quest.498E3CB76B5E962C.quest_desc: [
		"Print 16 of each processor on an inscriber line. Each press is crafted from four blue steel sheets around what it prints."
	]
	quest.498E3CB76B5E962C.title: "Processors"
	quest.49AD8E5EC6FB24F9.quest_desc: [
		"Build four stabilizers and an injector at draconic level. They hold the reactor core in its field."
	]
	quest.49AD8E5EC6FB24F9.title: "Reactor Parts"
	quest.4A34D752E7A4B499.quest_desc: [
		"Fill a large vessel with food and seal it. Sealed, food rots far slower."
	]
	quest.4A34D752E7A4B499.title: "Stocked Camp"
	quest.4A4FF9DEC4240DF7.quest_desc: [
		"Mount an advanced display on the platform. It lists every train, its stop and its delay."
	]
	quest.4A4FF9DEC4240DF7.title: "Advanced Display"
	quest.4AD21CEABC66DCC2.quest_desc: [
		"{image:firmages:textures/quests/ponder/lens_crown.png width:128 height:128 align:center click_action:custom_event:firmages:ponder/firmages/star_anvil text:Click%20to%20watch}"
		""
		"Set a Star Anvil in a 9 by 9 stone ring with three lens mounts under open sky. The Lens Crown forges the celestial alloys."
		""
		"{image:firmages:textures/quests/ponder/chords.png width:128 height:128 align:center click_action:custom_event:firmages:ponder/firmages/lens_mount text:Click%20to%20watch}"
	]
	quest.4AD21CEABC66DCC2.title: "The Lens Crown"
	quest.4AD5DA22A64D9944.quest_desc: [
		"Set an energy transformer at the end of a beam. The light becomes FE again."
	]
	quest.4AD5DA22A64D9944.title: "Energy Transformer"
	quest.4B3E22FB31AA68AE.quest_desc: [
		"Fit a bronze drill head to two sticks. Strike a rock face and it reads a long, narrow column behind it."
	]
	quest.4B3E22FB31AA68AE.title: "Prospector Drill"
	quest.4B5686EB34477AC2.quest_desc: [
		"Fuse the chaotic core. It is the catalyst of the Ultimate Singularity."
	]
	quest.4B5686EB34477AC2.title: "Chaotic Core"
	quest.4BFBAC45968A80F5.quest_desc: [
		"{image:firmages:textures/gui/quests/shrine/ring_7.png width:180 height:116 align:center click_action:open_quest:589B89079D60A34B text:Open%20the%20build%20guide}"
		"Raise the Star Spire around the Data Nave: steel plating, desh block pillars and ostrum block caps. The heart shows every missing block."
	]
	quest.4BFBAC45968A80F5.quest_subtitle: "The shrine ring of this Age"
	quest.4BFBAC45968A80F5.title: "Raise the Star Spire"
	quest.4C78408E6835BC56.quest_desc: [
		"Hunt three animals; carry a knife to butcher them. Large prey drops the large hide that makes the thatch bed."
	]
	quest.4C78408E6835BC56.title: "Hunter"
	quest.4C9313FE2FCD30AD.quest_desc: [
		"A goblin of the veins trades in the Nether for silk, hides and cloth. Trade it for a shroomlight or a gleamflower seed."
	]
	quest.4C9313FE2FCD30AD.title: "The Vein Goblin"
	quest.4CA32185961FD920.quest_desc: [
		"Build the calcination oven and a sal ammoniac accumulator. Calcination turns minerals into alchemical salt; sal ammoniac is the solvent of every liquefaction."
	]
	quest.4CA32185961FD920.title: "Calcination Oven"
	quest.4CB0E2CEF90AD9CE.quest_desc: [
		"Mine eight ice shards on Glacio. Two go into the Quantum Core."
	]
	quest.4CB0E2CEF90AD9CE.title: "Ice Shards"
	quest.4CB43131B416FB17.quest_desc: [
		"Keep a store of 32 calorite plates. One goes into the Quantum Core; engines and tanks take the rest."
	]
	quest.4CB43131B416FB17.title: "Calorite Plates"
	quest.4CBDFA0CE2A9C85C.quest_desc: [
		"Build a thermoelectric boiler and an industrial turbine. Together they turn reactor heat into FE."
	]
	quest.4CBDFA0CE2A9C85C.title: "Industrial Turbine"
	quest.4CF21D31C1F4373A.quest_desc: [
		"Make a quantum alloy ingot. Every part of the next network is cast from it."
	]
	quest.4CF21D31C1F4373A.quest_subtitle: "Quantum Network, off \"Subatomic Alloy\""
	quest.4CF21D31C1F4373A.title: "Quantum Alloy"
	quest.4D42F86F954FD88C.quest_desc: [
		"Fusion through a turbine powers this Age. The next Age asks for more than fusion can give."
	]
	quest.4D42F86F954FD88C.title: "Power for the End"
	quest.4D478E63C575E42A.quest_desc: [
		"LV, MV and HV wire each take their own connectors. Transformers join the tiers. Wire that carries too much power burns."
	]
	quest.4D478E63C575E42A.title: "Voltage"
	quest.4D59CA22796434A3.quest_desc: [
		"Build the 3x3x3 coke oven from coke bricks and form it with the Engineer's Hammer. It cokes bituminous coal and lignite and gives creosote."
	]
	quest.4D59CA22796434A3.title: "Coke Oven"
	quest.4E069E7BCFBE1D68.quest_desc: [
		"An older smith worked these hills. Find the cold forge and bring back what its chest kept."
	]
	quest.4E069E7BCFBE1D68.title: "The Cold Forge"
	quest.4E67382814C86929.quest_desc: [
		"Bind a handy haversack to a chest. Right-click items onto it and they land in that chest from anywhere."
	]
	quest.4E67382814C86929.title: "Handy Haversack"
	quest.4E834A3270A36576.quest_desc: [
		"Craft a pirn. Wound with wool, fiber or silk, it feeds the power loom."
	]
	quest.4E834A3270A36576.quest_subtitle: "Hands Retired, off \"The Thresher\""
	quest.4E834A3270A36576.title: "Pirn"
	quest.4E8C4F9B5F83C9EA.quest_desc: [
		"Drive a tree tap into a living trunk. It fills with sap as the seasons turn."
	]
	quest.4E8C4F9B5F83C9EA.quest_subtitle: "Sap, Syrup and Latex, off \"Genuine Leather\""
	quest.4E8C4F9B5F83C9EA.title: "Tree Tap"
	quest.4EAD51182D51E618.quest_desc: [
		"Build the blast furnace. Coke and wrought iron go in, steel comes out, faster than any anvil."
	]
	quest.4EAD51182D51E618.title: "Engineer's Blast Furnace"
	quest.4EC4BBA27265C3E1.quest_desc: ["Hypertubes shoot players across the base."]
	quest.4EC4BBA27265C3E1.title: "Hypertubes"
	quest.4F3B6183484FD977.quest_desc: [
		"Raise an item silo, a vault standing upright. The line drops into it from above."
	]
	quest.4F3B6183484FD977.title: "Item Silo"
	quest.4F513B23D9320098.quest_desc: [
		"Forge the Ultimate Singularity from the nine relics, chaos fragments, the Firmament Alloy and the chaotic core in a chaotic fusion."
	]
	quest.4F513B23D9320098.title: "The Ultimate Singularity"
	quest.4F7A0CECA30BE9CE.quest_desc: [
		"Build a locometal boiler for the engine. It gives the locomotive its body; the train itself runs without fuel."
	]
	quest.4F7A0CECA30BE9CE.title: "Boiler"
	quest.4F807EAA363A03FC.quest_desc: [
		"Set an Aurora Net at height 140 or more under open sky in the cold north. Every clear night it catches aurora light."
	]
	quest.4F807EAA363A03FC.title: "Aurora Net"
	quest.4F85BB08A2142E6A.quest_desc: [
		"Carve a flute. Its music starts the ceremonies at a totem pole."
	]
	quest.4F85BB08A2142E6A.title: "A Flute"
	quest.4F89B63F08027F21.quest_desc: [
		"Set the simulation chamber and the loot fabricator. The chamber turns a trained model and FE into matrices, the fabricator matrices into drops."
	]
	quest.4F89B63F08027F21.title: "Simulation"
	quest.4FBD526C99D8B97C.quest_desc: [
		"Craft a wooden transformer. It hands the rotation of your shafts to wooden axles at the same speed."
	]
	quest.4FBD526C99D8B97C.title: "Wooden Transformer"
	quest.4FC3CDC1654522C0.quest_desc: [
		"Bind the Marid, the strongest of the spirits. Its ritual awakens the Keystone for half the alloy."
	]
	quest.4FC3CDC1654522C0.title: "Bind a Marid"
	quest.5032B9C3899A4044.quest_desc: [
		"Build a crafting table. The shrine is crafted in its 3x3 grid; the inventory grid is 2x2."
		""
		"- Knap a saw blade mold (see \"Clay Patterns\") and fire it. Right-click the glowing vessel and put the mold in the slot."
		"- Put the blade above a stick: a saw."
		"- A saw and a log make two planks. Four planks make a crafting table."
		"- A saw and planks make four lumber: barrels, chests and tool racks take lumber."
		""
		"Four loose rocks in the 2x2 grid make a cobblestone. The shrine takes many."
	]
	quest.5032B9C3899A4044.title: "Workbench"
	quest.50B16E3D332F89A1.quest_desc: [
		"Build an infusion altar with eight pedestals. Seeds of higher tiers are woven there from lesser ones."
	]
	quest.50B16E3D332F89A1.title: "Infusion Altar"
	quest.50B1CD95742F5B7B.quest_desc: [
		"Build a pumpjack over an oil reservoir and pump the first bucket of crude oil into a tank."
	]
	quest.50B1CD95742F5B7B.title: "Pumpjack"
	quest.513536825A512E7C.quest_desc: [
		"Imbue an essence of two elements fused, such as cinder from fire and air. It is the thread of every dual robe."
	]
	quest.513536825A512E7C.quest_subtitle: "Elemental Robes, off \"Bind an Afrit\""
	quest.513536825A512E7C.title: "Elemental Essence"
	quest.515B6E8052E75DC3.quest_desc: [
		"Apply an iron block to brass casing for reinforced casing. It is the wall stone of a spawner hall."
	]
	quest.515B6E8052E75DC3.quest_subtitle: "Mobs and Wings, off \"Mechanical Spawner\""
	quest.515B6E8052E75DC3.title: "Reinforced Casing"
	quest.51BC07FECD1154CB.quest_desc: [
		"Craft an empty pattern schematic and write a schematic to it at the table. The cannon then repeats the design side by side."
	]
	quest.51BC07FECD1154CB.title: "Pattern Schematic"
	quest.51D1F56529776258.quest_desc: [
		"{image:firmages:textures/gui/quests/shrine/ring_1.png width:180 height:115 align:center click_action:open_quest:346CC5CACE990B24 text:Open%20the%20build%20guide}"
		"Raise the Bronze Sanctum around the Hearth Circle: rock bricks, a bronze block on each corner and a bronze or brass bell opposite the plinth. The heart shows every missing block."
	]
	quest.51D1F56529776258.quest_subtitle: "The shrine ring of this Age"
	quest.51D1F56529776258.title: "Raise the Bronze Sanctum"
	quest.520291C80FF0223D.quest_desc: [
		"Build an engine casing. Every part of a jet sits inside one shell."
	]
	quest.520291C80FF0223D.title: "Engine Casing"
	quest.5209B9E49235822B.quest_desc: [
		"The last Age. Chaos, the Ultimate Singularity and a Stargate to The Origin."
		""
		"Three strands lead to the final battle: Chaos, Stargate and Sky."
	]
	quest.5209B9E49235822B.quest_subtitle: "The tenth and last Age"
	quest.5209B9E49235822B.title: "The Singularity Age Dawns"
	quest.5298B856BFEE50A2.quest_desc: [
		"Craft the Hearthstone from the fired Hearth Idol (H), copper ingots (K) and charcoal (C):"
		"- K -"
		"C H C"
		"- K -"
		""
		"Lay it on the plinth and kindle the heart with a firestarter. Then sneak and hold right-click on the heart with an empty hand. Friends who pray with you make it faster."
		""
		"Caelum keeps the Hearthstone and opens the Bronze Age."
	]
	quest.5298B856BFEE50A2.quest_subtitle: "Goal of the Stone Age: Caelum opens the Bronze Age"
	quest.5298B856BFEE50A2.title: "Offer the Hearthstone at the Shrine"
	quest.52E09F9B36BF8222.quest_desc: [
		"Carve a log with the totem knife. Sneak and right-click to change the carving; the pole is built from them."
	]
	quest.52E09F9B36BF8222.quest_subtitle: "Totem Ceremonies, off \"A Flute\""
	quest.52E09F9B36BF8222.title: "Whittling Knife"
	quest.531FCAC59D841C4F.quest_desc: [
		"Build a washing factory. It runs the washing line many times over for the cost of one machine."
	]
	quest.531FCAC59D841C4F.quest_subtitle: "Bigger Machines, off \"Factory Line\""
	quest.531FCAC59D841C4F.title: "Washing Factory"
	quest.53348C90243DE4F0.quest_desc: [
		"Everybody on this server is one fellowship. The Ages are shared by all of you. Split the strands between you: one friend smiths, one prospects, one builds."
		""
		"A keystone's supplies go to whoever claims them first. The gift of a side path and all experience come to each of you."
	]
	quest.53348C90243DE4F0.title: "One Fellowship"
	quest.5338C416BA1F348B.quest_desc: [
		"A hellshelf or a seashelf lifts the table past level 30. Quanta and Arcana grow with them."
	]
	quest.5338C416BA1F348B.title: "Hell and Sea"
	quest.533C7CC2EEA570E4.quest_desc: [
		"Purification gives three times the metal from every ore piece."
	]
	quest.533C7CC2EEA570E4.title: "Purification Chamber"
	quest.537152A2B78DB79F.quest_desc: [
		"Set a track switch where the line forks. A signal chooses the branch the train takes."
	]
	quest.537152A2B78DB79F.title: "Track Switch"
	quest.53B8E5C95AFF18F1.quest_desc: [
		"Hang a blackboard by the door. Chalk a note for those who come home after you."
	]
	quest.53B8E5C95AFF18F1.title: "Blackboard"
	quest.54432F5A30AE7695.quest_desc: [
		"For a tree's own wood, put eight class logs or planks around its sapling. Its own log turns back into the class log, its sapling into the class sapling."
		""
		"- Oak: oak, ash, maple, sycamore, beech, black oak"
		"- Birch: birch, aspen, eucalyptus, ginkgo, poplar, rainbow eucalyptus"
		"- Spruce: spruce, pine, douglas fir, white cedar, sequoia, cypress, araucaria, red cedar, kauri"
		"- Jungle: kapok, palm, teak, hevea, tualang, mahoe"
		"- Acacia: acacia, baobab, gum arabic"
		"- Dark oak: blackwood, hickory, chestnut, ironwood, ipe"
		"- Mangrove: mangrove, willow, mahogany"
		"- Cherry: rosewood, fig, rubber fig"
		""
		"Golden bamboo and bamboo turn into each other. Class saplings grow on any soil."
	]
	quest.54432F5A30AE7695.title: "Wood Classes"
	quest.549D57AE4E7A9202.quest_desc: [
		"On a red moon the dead rise armed. On a Firmament Night, after an Age dawns, fewer walk and fights pay more."
	]
	quest.549D57AE4E7A9202.quest_subtitle: "Red Moons, off \"The Iron Age Dawns\""
	quest.549D57AE4E7A9202.title: "Armed Dead"
	quest.55D1BCCE8D10146E.quest_desc: [
		"Set a draconic pattern provider by the fusion core. The network then sends fusion crafting jobs to it like any pattern."
	]
	quest.55D1BCCE8D10146E.title: "Draconic Patterns"
	quest.5628873FCDD13028.quest_desc: [
		"A Starbuncle carries items between chests: the item transport of the Arcane Age."
	]
	quest.5628873FCDD13028.title: "Starbuncle"
	quest.562F75E577567E32.quest_desc: [
		"Turn a mechanical pulverizer by shaft. It crushes whatever a crusher spirit can, with no spirit bound to it."
	]
	quest.562F75E577567E32.title: "Mechanical Pulverizer"
	quest.56540F254F25E020.quest_desc: [
		"Press a quantum processor. It is the brain of the next crafting computer."
	]
	quest.56540F254F25E020.title: "Quantum Processor"
	quest.56A17C9D31C86E04.quest_desc: [
		"Craft an exchanging gadget. It swaps a wall of blocks in one sweep, but never ore or the raw stone of the wild."
	]
	quest.56A17C9D31C86E04.title: "Exchanging Gadget"
	quest.571394917C105C6B.quest_desc: [
		"Build an extended pattern provider. It holds many more patterns than the plain one."
	]
	quest.571394917C105C6B.quest_subtitle: "Pattern Halls, off \"Molecular Assembler\""
	quest.571394917C105C6B.title: "Extended Pattern Provider"
	quest.5739BF626921BBC3.quest_desc: [
		"Lay inferium farmland. Crops planted on it often drop a second seed, more so crops of its own tier."
	]
	quest.5739BF626921BBC3.quest_subtitle: "Essence Farms, off \"Resource Crops\""
	quest.5739BF626921BBC3.title: "Inferium Farmland"
	quest.573FF798650E3338.quest_desc: [
		"You wake beneath a sky that watches. Your hands are empty."
		""
		"This is the Chronicle, the one record of your fellowship."
		""
		"The world is lived in Ages, from Dawn to the Singularity Age. What a later Age holds does not exist yet. Each Age ends with an offering at the shrine of Caelum, the sky itself, and its chapter appears here when it dawns."
	]
	quest.573FF798650E3338.quest_subtitle: "Read me first"
	quest.573FF798650E3338.title: "You Wake"
	quest.574F377D613986E5.quest_desc: [
		"Forge Starlit Iron under the crown from meteoric iron, storm glass and an Arcane gem. Both routes to the Arcane Keystone need it, and the Wayshrines want it as their offering."
	]
	quest.574F377D613986E5.title: "Starlit Iron"
	quest.575603B66E5D1028.quest_desc: [
		"Craft a drum. Its beat is another voice that the ceremonies listen for."
	]
	quest.575603B66E5D1028.title: "Totemist Drum"
	quest.57663DC8E013A906.quest_desc: ["The archmage spellbook needs an advanced control circuit."]
	quest.57663DC8E013A906.title: "Archmage"
	quest.57A450FE81B342F6.quest_desc: [
		"Cover a basin with a foundry lid and melt metal in it. Cannon parts are cast in sand moulds."
	]
	quest.57A450FE81B342F6.quest_subtitle: "Cannon Works, off \"Built-Up Chamber\""
	quest.57A450FE81B342F6.title: "Foundry Lid"
	quest.57F5B8C4363E589D.quest_desc: [
		"The Chaos Guardian waits on a Chaos Island in the End; its crystals drop chaos shards. Nine large fragments press into a shard too."
	]
	quest.57F5B8C4363E589D.title: "Chaos Guardian"
	quest.581F27EACB0B6A07.quest_desc: [
		"Fit a pickup upgrade. The pack gathers what lies at your feet and keeps your hands free."
	]
	quest.581F27EACB0B6A07.title: "Pickup Upgrade"
	quest.588683982E32ABBD.quest_desc: [
		"Set a full-block fence source in a wall. The door shows only when it is shut."
	]
	quest.588683982E32ABBD.title: "Hidden Door"
	quest.589B89079D60A34B.quest_desc: [
		"{image:firmages:textures/gui/quests/shrine/ring_7_build.apng.png width:220 height:142 align:center}"
		"Raise the Star Spire round the Data Nave. 88 new blocks in five layers:"
		"- 67 steel plating"
		"- 16 desh blocks"
		"- four ostrum blocks"
		"- the Offering Plinth"
		""
		"Right-click the heart with an empty hand: it shows every missing block as a ghost."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_7_layer_1.png width:220 height:142 align:center}"
		"Layer one of five, level with the heart: 67 steel plating, four desh blocks, the Offering Plinth."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_7_layer_2.png width:220 height:142 align:center}"
		"Layer two of five, one block up: four desh blocks."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_7_layer_3.png width:220 height:142 align:center}"
		"Layer three of five, two blocks up: four desh blocks."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_7_layer_4.png width:220 height:142 align:center}"
		"Layer four of five, three blocks up: four desh blocks."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_7_layer_5.png width:220 height:142 align:center}"
		"Layer five of five, four blocks up: four ostrum blocks."
		"{@pagebreak}"
		"Lay the Star Chart on the plinth. Your Tally Chutes must have taken 2,880 desh ingots in this Age."
		""
		"The rite:"
		"- Caelum wants to see the stars: pray at night, under an open sky, without rain."
		""
		"Then sneak and hold right-click on the heart with an empty hand. Caelum opens the Quantum Age."
	]
	quest.589B89079D60A34B.quest_subtitle: "The shrine ring of the Space Age"
	quest.589B89079D60A34B.title: "Star Spire"
	quest.58FF93CB8B9AA47F.quest_desc: [
		"Set a bee port and load a robo bee. It flies a parcel addressed to a friend straight to them."
	]
	quest.58FF93CB8B9AA47F.title: "Bee Port"
	quest.5959E93431484DD5.quest_desc: [
		"Set the Quantum lens and forge the Firmament Alloy under the full crown from the singular alloy and the sky materials of every Age. The Ultimate Singularity needs it."
	]
	quest.5959E93431484DD5.title: "Firmament Alloy"
	quest.598991B51FCE284F.quest_desc: [
		"Crystallize lithium from brine and smelt the dust into an ingot. The fusion fuel of the last Ages is bred from lithium."
	]
	quest.598991B51FCE284F.title: "Lithium"
	quest.598B671102148097.quest_desc: [
		"Build the launch control, a probe cradle and a gantry with a flame trench. Probes fly from it."
	]
	quest.598B671102148097.title: "Launch Complex"
	quest.59B152077A8E7D71.quest_desc: [
		"Mix iron with netherite powder over a superheated burner. The aviation alloy ingot stands the heat of a turbine."
	]
	quest.59B152077A8E7D71.quest_subtitle: "Jet Works, off \"Refined Diesel\""
	quest.59B152077A8E7D71.title: "Aviation Alloy"
	quest.5A0FF2D693DE411D.quest_desc: [
		"Glue a hull together and pull the lever of a physics assembler. The whole frame becomes one body with weight."
	]
	quest.5A0FF2D693DE411D.quest_subtitle: "Ships in the Sky, off \"Airship\""
	quest.5A0FF2D693DE411D.title: "Physics Assembler"
	quest.5AC856CDC2E185D7.quest_desc: [
		"Craft a building gadget. Mark a wall or a floor and it lays the blocks from your pack."
	]
	quest.5AC856CDC2E185D7.quest_subtitle: "Builder's Hand, off \"Assembler\""
	quest.5AC856CDC2E185D7.title: "Building Gadget"
	quest.5ACC660E88F7FC61.quest_desc: [
		"Make a steel casing around a heavy engineering block and the metallurgic infuser on it. Every machine stands on a casing; the infuser makes alloys."
	]
	quest.5ACC660E88F7FC61.title: "Steel Casing"
	quest.5AFB81560199F553.quest_desc: [
		"The induction matrix stores FE in its cells and gives it out through its ports."
	]
	quest.5AFB81560199F553.title: "Induction Matrix"
	quest.5B2A99417B6768D7.quest_desc: [
		"Bolt wheel mounts and tires to a frame. A buggy goes where a ship cannot."
	]
	quest.5B2A99417B6768D7.title: "Wheel Mount"
	quest.5B6333867B95EE20.quest_desc: [
		"Make a whistle from an eagle bone. Its call is the oldest signal in the wild."
	]
	quest.5B6333867B95EE20.title: "Eagle Whistle"
	quest.5B849EF8FE147622.quest_desc: ["Reinforced blast bricks and preheaters make steel faster."]
	quest.5B849EF8FE147622.title: "Improved Blast Furnace"
	quest.5BCEF3BCCD6A832E.quest_desc: [
		"Go below Y 0 into the deep caves. A pale thing hunts there until iron is yours. See it once."
	]
	quest.5BCEF3BCCD6A832E.title: "The Pale Watcher"
	quest.5C0BB2F0411B50A4.quest_desc: [
		"Cut belts from rubber bars. A belt carries items and turns shafts where gears cannot reach."
	]
	quest.5C0BB2F0411B50A4.title: "Rubber Belts"
	quest.5C0C8D3E5C081AA2.quest_desc: [
		"Assemble the Stargate from its base, chevron and ring blocks; the draconic reactor powers it through a flux gate."
		""
		"Its address, on the Coordinates of The Origin: 9, 16, 21, 33, 2, 37, then the point of origin."
		""
		"Dialing The Origin takes 1,000,000,000 FE stored in the gate and 50,000 FE/t while the wormhole stays open; a gate in your own system takes 10,000,000 FE. Fill the gate from the reactor before you dial. The gate in The Origin always keeps one trip home charged."
	]
	quest.5C0C8D3E5C081AA2.title: "Gate Online"
	quest.5C1872FCA111DFAA.quest_desc: ["Craft a launch pad. Rockets start only from one."]
	quest.5C1872FCA111DFAA.title: "Launch Pad"
	quest.5C1B3FA3E42205BB.quest_desc: [
		"Now and then a goblin carries rarer goods for silk or a large hide. Trade it for a saddle."
	]
	quest.5C1B3FA3E42205BB.title: "Rare Goods"
	quest.5C56E1A066E7C72A.quest_desc: [
		"Grow an energy crystal. Set in a device of the gate, it stores power and raises its energy target."
	]
	quest.5C56E1A066E7C72A.quest_subtitle: "Crystals and Rings, off \"Stargate Blocks\""
	quest.5C56E1A066E7C72A.title: "Energy Crystal"
	quest.5C65563268425F2A.quest_desc: [
		"Cut a coconut from palm leaves and crack it with a stone. Sneak and right-click a barrel with it for juice and meat."
	]
	quest.5C65563268425F2A.title: "Coconut"
	quest.5C703A0D82A3D9DA.quest_desc: [
		"Knap a drill head mold from clay and fire it. Cast the drill head in it."
	]
	quest.5C703A0D82A3D9DA.quest_subtitle: "Prospector's Kit, off \"Prospector\""
	quest.5C703A0D82A3D9DA.title: "Drill Head Mold"
	quest.5C8E39BBE00603BA.quest_desc: [
		"Nine offerings, one gate. Beyond it waits the last battle, and its end is the end of the road."
	]
	quest.5C8E39BBE00603BA.quest_subtitle: "Goal of the Singularity Age: the last battle"
	quest.5C8E39BBE00603BA.title: "Beyond the Firmament"
	quest.5CC2939838550FB5.quest_desc: [
		"Feed a wild animal to familiarize it. Tame animals are the start of a farm."
	]
	quest.5CC2939838550FB5.title: "A New Friend"
	quest.5D31E5FF6DE9E042.quest_desc: ["Lay 16 tracks. Trains bring ore home from distant mines."]
	quest.5D31E5FF6DE9E042.title: "Trains"
	quest.5D5A925A47A11BB0.quest_desc: [
		"Set an advanced prism in the path of a spell. It turns the cast and gives it a new course."
	]
	quest.5D5A925A47A11BB0.title: "Prism"
	quest.5D892EEB1185A237.quest_desc: [
		"Set a full-block laser source in a wall. The bridge starts from stone with no machine in sight."
	]
	quest.5D892EEB1185A237.title: "Full Source"
	quest.5E15ECD059F8730C.quest_desc: [
		"Stand a glass pole in a bright hall. It slides like the wooden one and shows the light through."
	]
	quest.5E15ECD059F8730C.title: "Glass Pole"
	quest.5E9A4477F8B0C84D.quest_desc: [
		"Set a stress converter on a shaft. Its turning drives axles of the old kind, and the quern turns without a hand."
	]
	quest.5E9A4477F8B0C84D.quest_subtitle: "Torque and Connect, off \"Mechanical Saw\""
	quest.5E9A4477F8B0C84D.title: "Torque"
	quest.5EE630041C685EFA.quest_desc: [
		"The assembler autocrafts grid recipes: the autocrafting of this Age."
	]
	quest.5EE630041C685EFA.title: "Assembler"
	quest.5EE99FD47DD299FC.quest_desc: [
		"Build the SPS from 16 casings and two supercharged coils. It turns polonium into antimatter."
	]
	quest.5EE99FD47DD299FC.title: "SPS"
	quest.5F244627F0825F5C.quest_desc: [
		"Raise a frame of assembler matrix walls and fill it with crafters, speed blocks and patterns. One cube replaces a hall."
	]
	quest.5F244627F0825F5C.title: "Assembler Matrix"
	quest.5F3D1DE20EF6632E.quest_desc: [
		"Off-world you need a space suit and oxygen. An oxygen distributor fills a sealed base."
	]
	quest.5F3D1DE20EF6632E.title: "Oxygen and Gravity"
	quest.5F4A609BCB040DE7.quest_desc: [
		"Open the anvil with two hot ingots and flux and press the weld button. It joins them in one press."
	]
	quest.5F4A609BCB040DE7.title: "Weld Button"
	quest.5F74A3FDB04E14F6.quest_desc: [
		"Coke ovens, blast furnaces, crushers, presses and the first FE."
		""
		"Five strands lead to the Pressure Core: Coke & Steel, Power, Ore Line, Logistics & Backfill and Sky."
		""
		"Caelum asks for proof of work this time: 384 steel ingots fed into Tally Chutes in this Age."
	]
	quest.5F74A3FDB04E14F6.quest_subtitle: "The fifth Age"
	quest.5F74A3FDB04E14F6.title: "The Industrial Age Dawns"
	quest.5F78BC82C07FA1BE.quest_desc: [
		"An umbrella slows a fall while you hold it, and it turns a blow like a shield. Hold it up when the sky opens."
	]
	quest.5F78BC82C07FA1BE.title: "Umbrella"
	quest.6001BDFB1A5EFECE.quest_desc: [
		"Set an adjustable burner under the envelope. Its heat fills the balloon."
	]
	quest.6001BDFB1A5EFECE.title: "Adjustable Burner"
	quest.60B5C7395FEA936B.quest_desc: [
		"Craft a crafting terminal. A crafting table is built in, and it takes from the whole network."
	]
	quest.60B5C7395FEA936B.title: "Crafting Terminal"
	quest.60E3F99CA819E486.quest_desc: [
		"Smith a bronze pickaxe, axe, saw, hammer and chisel. Bronze is a working metal, not a trophy; every one of you needs the kit."
	]
	quest.60E3F99CA819E486.title: "Bronze Kit"
	quest.612BEB27F9AD5018.quest_desc: ["Land on Mars. Ostrum lies in its red rock."]
	quest.612BEB27F9AD5018.title: "Mars"
	quest.617B394599496EE7.quest_desc: [
		"Build four fuel assemblies. They hold the fissile fuel inside the reactor."
	]
	quest.617B394599496EE7.title: "Fuel Assemblies"
	quest.61CA7DDBEC00EDEF.quest_desc: [
		"The Quantum Core is the ninth relic. The Singularity Age has no offering: it ends in battle."
	]
	quest.61CA7DDBEC00EDEF.title: "The Last Offering"
	quest.61D8A94B3B41AF71.quest_desc: [
		"Build a diesel engine. It turns a pipe of diesel into rotation in a small frame."
	]
	quest.61D8A94B3B41AF71.title: "Diesel Engine"
	quest.61EE57DC75EED266.quest_desc: [
		"Feed the bloomery by machine and collect 32 wrought iron ingots from the line."
	]
	quest.61EE57DC75EED266.title: "Automated Bloomery Line"
	quest.621572E49939AC7D.quest_desc: [
		"Raise quantum accelerators on a crafting computer. Jobs finish in a fraction of the time."
	]
	quest.621572E49939AC7D.title: "Quantum Accelerator"
	quest.62301EA77A69B720.quest_desc: [
		"Set a stone pump by a fire and give it a redstone signal. It draws the smoke away into the flue."
	]
	quest.62301EA77A69B720.title: "Stone Pump"
	quest.623C908B3CDF2E3E.quest_desc: [
		"Press 32 desh plates. The engine and the tanks of the rocket to Mars are made from them."
	]
	quest.623C908B3CDF2E3E.title: "Desh Plates"
	quest.6281CB502F09533D.quest_desc: [
		"{image:firmages:textures/gui/quests/shrine/ring_3.png width:180 height:122 align:center click_action:open_quest:2CBD5C8E76F766A8 text:Open%20the%20build%20guide}"
		"Raise the Spirit Circle around the Iron Sanctum: sourcestone, otherstone pillars capped with source gem blocks, and eight candles. The heart shows every missing block. When the ring stands, the heart waits for the Keystone."
	]
	quest.6281CB502F09533D.quest_subtitle: "The shrine ring of this Age"
	quest.6281CB502F09533D.title: "Raise the Spirit Circle"
	quest.62A084197680E977.quest_desc: [
		"Gather twelve of one wild crop's food. A full larder carries the fellowship into the Stone Age."
	]
	quest.62A084197680E977.title: "The Larder"
	quest.62D59DF66CF4320C.quest_desc: [
		"Set an accelerator on a long run. It gives the traveller speed on the way."
	]
	quest.62D59DF66CF4320C.title: "Tube Accelerator"
	quest.633F65E98FEA8DD2.quest_desc: [
		"Slot a copper storage upgrade into a drawer. Its capacity grows many times over."
	]
	quest.633F65E98FEA8DD2.title: "Copper Upgrade"
	quest.6362434FA320A007.quest_desc: [
		"Build a chemixer. It mixes chemicals and items in one stroke."
	]
	quest.6362434FA320A007.quest_subtitle: "Evolved Factories, off \"Subatomic Alloy\""
	quest.6362434FA320A007.title: "Chemixer"
	quest.63A1F4DCDC41DC00.quest_desc: [
		"Wear the robes of a single element. They suit casters of fire, air, earth or water."
	]
	quest.63A1F4DCDC41DC00.title: "Robes of One"
	quest.63A45BCAE3254E00.quest_desc: [
		"Fell a tree with your stone axe. With axe, knife, hammer and shovel you have a full stone kit."
	]
	quest.63A45BCAE3254E00.title: "Stone Kit"
	quest.63D5F1A42BB79A53.quest_desc: [
		"Cast steel layers, bore them, build them up and heat them into one chamber. It goes into the Pressure Core."
	]
	quest.63D5F1A42BB79A53.title: "Built-Up Chamber"
	quest.63F9623930B5DE46.quest_desc: [
		"Forge a pickaxe of refined obsidian. It is a tool of the factory age, tough and quick."
	]
	quest.63F9623930B5DE46.title: "Refined Obsidian Pickaxe"
	quest.64181B7811C2814E.quest_desc: [
		"Hold an item and press V to lay it on a block; up to four items fit on one block, one in each corner."
		""
		"Lay the parts together, then sneak and right-click the pile with an empty hand. If they make something, you get it. Where on the block each part lies does not matter."
		""
		"Four straw make thatch, two sticks a firestarter, a stone head and a stick a stone tool."
	]
	quest.64181B7811C2814E.title: "By Hand"
	quest.641FB17315FC626A.quest_desc: [
		"Hang two brass doors in your entrance. Sliding doors open by hand or on a redstone signal."
	]
	quest.641FB17315FC626A.title: "Doors That Slide"
	quest.645C0C2F787D0E66.quest_desc: [
		"Craft a grave. Should you fall, one rises where you died and keeps your goods; break it to take them back."
	]
	quest.645C0C2F787D0E66.title: "Grave"
	quest.647F6707C7F51449.quest_desc: [
		"Raise a semaphore by the line. Its arm shows stop or go to every driver."
	]
	quest.647F6707C7F51449.title: "Semaphore"
	quest.64BC23A64CDCB0FA.quest_desc: [
		"Craft a supremium apple from a golden apple and essence. It heals and shields you for a time."
	]
	quest.64BC23A64CDCB0FA.title: "Supremium Apple"
	quest.64CDFFD93C9CBDCE.quest_desc: [
		"Craft the Data Matrix from two blue steel sheets, two Halo Steel ingots, three advanced control circuits, a 64k storage component and a singularity from the matter condenser."
		""
		"Raise the Data Nave. Once your Tally Chutes have taken 1,024 osmium ingots in this Age, lay the Matrix on the plinth, feed the heart 10,000,000 FE and pray, together if two of you are online."
		""
		"Caelum opens the Space Age."
	]
	quest.64CDFFD93C9CBDCE.quest_subtitle: "Goal of the Information Age: Caelum opens the Space Age"
	quest.64CDFFD93C9CBDCE.title: "Offer the Data Matrix at the Shrine"
	quest.64E0D1AE8C5265E7.quest_desc: [
		"No stronghold stands here. Ring a 3 by 3 hole with twelve frames facing inwards, fill them with twelve eyes of ender and step through."
	]
	quest.64E0D1AE8C5265E7.title: "The End"
	quest.64EFA98C99BE41E9.quest_desc: [
		"Hang lamps at the yard and the walls before dusk. A lit house is quiet on the reddest night."
	]
	quest.64EFA98C99BE41E9.title: "Keeping the Door"
	quest.6522D484BFB67425.quest_desc: [
		"Right-click loose rocks with an empty hand; gather about ten of one kind."
		""
		"Hold two or more and right-click into the air. A 5x5 grid of stone opens."
		"- Click a square to knock it away. It does not come back."
		"- The first click uses one rock. Closing the grid early wastes it."
		"- When only the shape is left, take the head from the slot on the right."
		""
		"The axe head (light squares stay, dark squares are knocked away):"
		"{image:firmages:textures/quests/knapping/axe_head.png width:64 height:64 align:center}"
		""
		"Craft the head with a stick, a twig or a bone on the ground (see \"By Hand\"): a stone axe. The knife and the other heads: \"Knapping Patterns\"."
	]
	quest.6522D484BFB67425.title: "Stone Tools"
	quest.652657C4C5B8CAC5.quest_desc: [
		"The offering of the Iron Age. Its build guide stands beside it."
	]
	quest.652657C4C5B8CAC5.quest_subtitle: "Goal of the Iron Age"
	quest.652657C4C5B8CAC5.title: "Steel Heart"
	quest.6541A11C39B620C6.quest_desc: [
		"The distillation tower splits crude oil into diesel, lubricant and more. Lubricant through an automatic lubricator speeds up your machines."
	]
	quest.6541A11C39B620C6.title: "Distillation Tower"
	quest.6567773B43A82031.quest_desc: [
		"Set a Starbuncle in a wheel. It turns shafts without water or wind."
	]
	quest.6567773B43A82031.title: "Starbuncle Wheel"
	quest.659EBC46D8F70B24.quest_desc: [
		"Sourcelinks turn fuel, growth or life around them into source. Store it in source jars."
	]
	quest.659EBC46D8F70B24.title: "Sourcelink"
	quest.65AB28F927A1F740.quest_desc: [
		"Set a fluid gauge on a tank. It orders more when the level falls, as the item gauge does for crates."
	]
	quest.65AB28F927A1F740.title: "Fluid Gauge"
	quest.65CF4F6B3C437443.quest_desc: ["Kill a rattlesnake and take its rattle. It warns only once."]
	quest.65CF4F6B3C437443.title: "Rattle in the Sand"
	quest.65E696893D25C27D.quest_desc: [
		"Build the fusion reactor from 32 frames. Cool it with water and run the steam through an industrial turbine: about 840,000 FE/t, against fewer than 100,000 air-cooled."
		""
		"Keep injection at 20 or more, or it goes out."
	]
	quest.65E696893D25C27D.title: "Fusion Reactor"
	quest.661054914CDF7CFA.quest_desc: [
		"FE is the one unit of energy. The alternator turns SU into FE only from steam engines on a fired boiler or diesel engines; wind and water give none. The electric motor turns FE back into SU."
	]
	quest.661054914CDF7CFA.title: "FE and SU"
	quest.6617FD431A7EFA87.quest_desc: [
		"Add the Arcane lens to the crown and forge Cloudsteel from meteoric iron, black steel and firmament crystal. Two ingots go into the Pressure Core."
	]
	quest.6617FD431A7EFA87.title: "Cloudsteel"
	quest.6623ADA8B4009C1B.quest_desc: [
		"Open ruin chests until a trinket lies among the flint and yarn. Now and then a chest holds one."
	]
	quest.6623ADA8B4009C1B.quest_subtitle: "Ruin Trinkets, off \"The Bronze Age Dawns\""
	quest.6623ADA8B4009C1B.title: "A Trinket"
	quest.6630236A99A2E2D5.quest_desc: [
		"A stock link and a stock ticker show and request your stock from anywhere on the network."
	]
	quest.6630236A99A2E2D5.title: "Stock Ticker"
	quest.663A4EAE1B3FAF8C.quest_desc: [
		"The offering of the Industrial Age. Its build guide stands beside it."
	]
	quest.663A4EAE1B3FAF8C.quest_subtitle: "Goal of the Industrial Age"
	quest.663A4EAE1B3FAF8C.title: "Pressure Core"
	quest.664583FF7A5FA49E.quest_desc: [
		"Raise a tipi of hide or wool and poles. You can sleep in it out in the open field."
	]
	quest.664583FF7A5FA49E.title: "Tipi"
	quest.665C0FA04D3E6C59.quest_desc: [
		"Fit a bronze hammer head to a stick and strike the rock. It searches a small cube around the blow."
	]
	quest.665C0FA04D3E6C59.title: "Prospector Hammer"
	quest.66EB6D8730E3AB2D.quest_desc: [
		"Smith a blaze burner and an enchanting table with a blaze upgrade template from Nether chests. The enchanter and the Hollow Keystone drink liquid experience."
	]
	quest.66EB6D8730E3AB2D.title: "Enchantment Industry"
	quest.66EDA08DBD082046.quest_desc: [
		"Saw support beams and place them in your mine. They stop cave-ins nearby."
	]
	quest.66EDA08DBD082046.title: "Hold the Ceiling"
	quest.6717E94E673685F4.quest_desc: [
		"Feed 1,024 osmium ingots into Tally Chutes in this Age. They keep what they take; a chute or the heart shows the count."
	]
	quest.6717E94E673685F4.title: "Proof of Work"
	quest.67287569E0B4D9E1.quest_desc: [
		"Draw constantan wire for the flux coils. Its resistance stays steady when the load changes."
	]
	quest.67287569E0B4D9E1.title: "Constantan Wire"
	quest.67314514BDCA1DB3.quest_desc: [
		"Fuse the Quantum Core at draconic level: two antimatter pellets, a calorite plate, Quasar Alloy, two ice shards and a subatomic alloy."
		""
		"Raise the Quantum Ring and set the Awakened Keystone back. Once your Tally Chutes have taken 3,584 calorite ingots, lay the Core down, feed the heart 100,000,000 FE and pray at night under open sky, together if two are online."
		""
		"Caelum opens the Singularity Age."
	]
	quest.67314514BDCA1DB3.quest_subtitle: "Goal of the Quantum Age: Caelum opens the Singularity Age"
	quest.67314514BDCA1DB3.title: "Offer the Quantum Core at the Shrine"
	quest.67CA15BF14B359A8.quest_desc: [
		"Fusion crafting needs a core, injectors and FE. Every ingredient needs its own injector of the recipe's tier or better; the core shows what is missing. Tools and armor have direct recipes: no gear goes into better gear."
	]
	quest.67CA15BF14B359A8.title: "Fusion Crafting"
	quest.67D2B7F30B2F443D.quest_desc: [
		"Go deep and find a goblin trader below the surface. It walks the dark with a pack of goods and pays seed for fruit."
	]
	quest.67D2B7F30B2F443D.quest_subtitle: "Goblins Below, off \"Gatherer\""
	quest.67D2B7F30B2F443D.title: "Fruit for Seed"
	quest.680BF7D02202F292.quest_desc: [
		"Grow ghost pepper in the Nether. It is hot enough to be called a fruit of the dark."
	]
	quest.680BF7D02202F292.title: "Ghost Pepper"
	quest.68514035FFA8720F.quest_desc: [
		"Build a plow, fit a hoe in it and hitch it to a beast. It tills the ground in rows as it walks."
	]
	quest.68514035FFA8720F.title: "Plow"
	quest.687CBF7A7AA65BF4.quest_desc: [
		"{image:firmages:textures/gui/quests/works/living_house.png width:200 height:183 align:center click_action:custom_event:firmages:ponder/create/elevator_pulley text:Watch%20a%20lift%20built}"
		"Build a house that moves for you: doors that slide, a lift between floors, lamps on a link, a board that speaks and a clock in the gable. The hearth stays its heart."
		"{@pagebreak}"
		"{image:firmages:textures/quests/build/living_house.png width:128 height:128 align:center}"
		""
		"The plan: doors, lamps, board, lift and clock."
	]
	quest.687CBF7A7AA65BF4.quest_subtitle: "A Great Work of the Iron Age"
	quest.687CBF7A7AA65BF4.title: "The Living House"
	quest.68A4B5AC4EBE2085.quest_desc: [
		"Craft the Pressure Core from two black steel double sheets, a heavy engineering block, two Cloudsteel ingots, the Arcane Gearbox and a built-up steel chamber."
		""
		"Raise the Foundry Nave; the heart shows what is missing. Once your Tally Chutes have taken 384 steel ingots in this Age, lay the Core on the new plinth, power the four electric lanterns and pray."
		""
		"Caelum keeps the Core and opens the Electric Age."
	]
	quest.68A4B5AC4EBE2085.quest_subtitle: "Goal of the Industrial Age: Caelum opens the Electric Age"
	quest.68A4B5AC4EBE2085.title: "Offer the Pressure Core at the Shrine"
	quest.68B8F92E23663113.quest_desc: [
		"Power a laser source on a ledge. A bridge of hard light crosses the gap, and a stronger signal reaches farther."
	]
	quest.68B8F92E23663113.quest_subtitle: "Light Bridges, off \"Launch Pad\""
	quest.68B8F92E23663113.title: "Laser Source"
	quest.68C9F9F5A0410703.quest_desc: [
		"Run 64 ore pieces through the chamber and keep the clumps. Three clumps from a piece: this is the ore step of your Age."
	]
	quest.68C9F9F5A0410703.title: "Ore Tripling"
	quest.692BE6A196CEF07F.quest_desc: ["Land on the Moon. Desh lies in its rock."]
	quest.692BE6A196CEF07F.title: "The Moon"
	quest.692D420F38A7CC69.quest_desc: [
		"Craft an Akashic Tome and craft your handbooks into it. Sneak and right-click to turn it to the one you need."
	]
	quest.692D420F38A7CC69.quest_subtitle: "Elemental Arts, off \"Apprentice Spellbook\""
	quest.692D420F38A7CC69.title: "One Book"
	quest.6932FDCAADC46220.quest_desc: [
		"Fill the Hollow Keystone on your machine line. No spirit, source or alchemy is needed."
	]
	quest.6932FDCAADC46220.title: "The Machine Route"
	quest.695266C0097AFA59.quest_desc: [
		"Prospect for inferium in any rock, prosperity deep in igneous and metamorphic rock and soulstone in basalt. Then grow the seeds your Age allows."
	]
	quest.695266C0097AFA59.title: "Resource Crops"
	quest.69CB2309855D14E1.quest_desc: [
		"The novice spellbook casts the first spells and opens the worn notebook."
	]
	quest.69CB2309855D14E1.title: "Novice Spellbook"
	quest.69CE34B2CF154EE3.quest_desc: [
		"Alloy steel, nickel and chromium into stainless steel. It never takes the taste of what it holds."
	]
	quest.69CE34B2CF154EE3.title: "Stainless Steel"
	quest.69FBE953FD290F68.quest_desc: [
		"Mine 16 raw calorite on Venus. It builds the rocket to Glacio."
	]
	quest.69FBE953FD290F68.title: "Calorite"
	quest.6A0550CA8D053A1A.quest_desc: [
		"Snowshoes carry you over powder snow and quicken your step on snow. Winter stops being a wall."
	]
	quest.6A0550CA8D053A1A.title: "Snowshoes"
	quest.6A1C715211FCA0FB.quest_desc: ["Two black steel double sheets for the Pressure Core."]
	quest.6A1C715211FCA0FB.title: "Black Steel Double Sheets"
	quest.6A272A1F4193488A.quest_desc: [
		"Hold five clay and right-click into the air. Knock squares away as with stone. Light squares stay, dark squares are knocked away. Mirrored shapes work too."
		""
		"Small vessel, melts ore:"
		"{image:firmages:textures/quests/knapping/small_vessel.png width:64 height:64 align:center}"
		""
		"Ingot molds, two at once:"
		"{image:firmages:textures/quests/knapping/ingot_molds.png width:64 height:64 align:center}"
		""
		"Pickaxe head mold:"
		"{image:firmages:textures/quests/knapping/pickaxe_head_mold.png width:64 height:64 align:center}"
		""
		"Saw blade mold, for the workbench:"
		"{image:firmages:textures/quests/knapping/saw_blade_mold.png width:64 height:64 align:center}"
		""
		"Jug, carries water:"
		"{image:firmages:textures/quests/knapping/jug.png width:64 height:64 align:center}"
		""
		"Pot, cooks soup on the firepit:"
		"{image:firmages:textures/quests/knapping/pot.png width:64 height:64 align:center}"
		""
		"Bowls, four at once:"
		"{image:firmages:textures/quests/knapping/bowls.png width:64 height:64 align:center}"
		""
		"Large vessel, keeps food when sealed:"
		"{image:firmages:textures/quests/knapping/large_vessel.png width:64 height:64 align:center}"
	]
	quest.6A272A1F4193488A.title: "Clay Patterns"
	quest.6A2C745F47AF776B.quest_desc: [
		"Set magnetite in wrought iron and right-click with the compass. It names the way to the nearest cold forge."
	]
	quest.6A2C745F47AF776B.title: "Frontier Compass"
	quest.6A84AF4A8D4A7FBA.quest_desc: [
		"Lay ducts to lead smoke sideways. They join chimneys round corners, so many fires share one stack."
	]
	quest.6A84AF4A8D4A7FBA.title: "Smoke Duct"
	quest.6ADB4DA20F502E35.quest_desc: [
		"Assemble a bare CAD from an iron assembly and cast it at redstone dust on the ground. The burst makes psidust."
	]
	quest.6ADB4DA20F502E35.title: "Psidust"
	quest.6B502DAD3EAE52D5.quest_desc: [
		"The apprentice spellbook holds the stronger glyphs you need against the Wilden Chimera."
	]
	quest.6B502DAD3EAE52D5.title: "Apprentice Spellbook"
	quest.6B60917A5984A799.quest_desc: [
		"Fuse the awakened core. It is the catalyst of the Quantum Core."
	]
	quest.6B60917A5984A799.title: "Awakened Core"
	quest.6C112D72835F57BD.quest_desc: [
		"Crushing wheels turn ore pieces into dust for more metal per ore."
	]
	quest.6C112D72835F57BD.title: "Crushing Wheels"
	quest.6C6305FDB2594599.quest_desc: [
		"Craft a wireless pattern access terminal. Encode patterns anywhere, without a walk back to the base."
	]
	quest.6C6305FDB2594599.title: "Wireless Patterns"
	quest.6C6E95AB6ABD2B3E.quest_desc: ["The packager boxes items for the package network."]
	quest.6C6E95AB6ABD2B3E.title: "Packager"
	quest.6C89D8CCD3EEFE88.quest_desc: [
		"A gearbox with steel and precision mechanisms from the mechanical crafter, or with source gems by magic. Reinforced blast bricks and Pressure Cores need it."
	]
	quest.6C89D8CCD3EEFE88.title: "Arcane Gearbox"
	quest.6CB4ABCF94DB39FA.quest_desc: [
		"Add the Information lens and forge Void Steel from voidglass, desh, starsteel and aurora light. The Star Chart needs it."
	]
	quest.6CB4ABCF94DB39FA.title: "Void Steel"
	quest.6CBAA83920DDC925.quest_desc: [
		"Build the tier 3 rocket from ostrum. It reaches Venus and Mercury and burns liquid hydrogen from a rotary condensentrator or cryo fuel, not diesel."
	]
	quest.6CBAA83920DDC925.title: "Tier 3 Rocket"
	quest.6D4DA2C8219A6722.quest_desc: [
		"Smelt chromium from the ore. It is hard and bright and rusts no more than glass."
	]
	quest.6D4DA2C8219A6722.title: "Chromium"
	quest.6DC5BE16C605C596.quest_desc: [
		"Make blue steel, the metal of the Information Age. Two sheets go into the Data Matrix, the rest into the inscriber presses."
	]
	quest.6DC5BE16C605C596.title: "Blue Steel"
	quest.6DE0808A3F92C2E7.quest_desc: [
		"Cast axe, hammer, knife, shovel and saw heads in their molds and haft them: about 50 small ore pieces. The Bronze Age smiths with this kit."
		""
		"Axe, hammer, knife and shovel molds:"
		"{image:firmages:textures/quests/knapping/axe_head_mold.png width:64 height:64 align:center}"
		"{image:firmages:textures/quests/knapping/hammer_head_mold.png width:64 height:64 align:center}"
		"{image:firmages:textures/quests/knapping/knife_blade_mold.png width:64 height:64 align:center}"
		"{image:firmages:textures/quests/knapping/shovel_head_mold.png width:64 height:64 align:center}"
	]
	quest.6DE0808A3F92C2E7.title: "Copper Kit"
	quest.6DE17D691978916D.quest_desc: [
		"{image:firmages:textures/quests/device/barrel.png width:128 height:128 align:center}"
		""
		"Build a barrel with a saw and lumber; barrels brine, pickle and tan. Soak a hide in limewater, scrape it, then soak it in tannin."
	]
	quest.6DE17D691978916D.title: "Genuine Leather"
	quest.6DE8A1BD2FFF457F.quest_desc: [
		"Build a mid-size chemical tank. A factory line drinks gas faster than a basic tank can fill."
	]
	quest.6DE8A1BD2FFF457F.title: "Chemical Tank"
	quest.6E4438CCF1A5BF3D.quest_desc: [
		"Finish the shard on the deployer and the press. The Steel Heart needs the relic."
	]
	quest.6E4438CCF1A5BF3D.title: "Frontier Relic"
	quest.6EBC0FF61E331733.quest_desc: [
		"Build a gem cutting table. A gem, gem dust and a rarity material go in, and the gem comes out of higher purity."
	]
	quest.6EBC0FF61E331733.quest_subtitle: "Gems and Sigils, off \"Enchanting Apparatus\""
	quest.6EBC0FF61E331733.title: "Gem Cutting Table"
	quest.6F0E9B4D0BD4227A.quest_desc: [
		"Build a crusher and feed it ore pieces. It returns two and a half times the metal as powder and dust, plus a by-product."
	]
	quest.6F0E9B4D0BD4227A.title: "Crusher"
	quest.6F139F7492B36C1B.quest_desc: [
		"Metal essence gives ore pieces, not ingots. Run them through the ore lines like any mined piece."
	]
	quest.6F139F7492B36C1B.title: "Metal Essence"
	quest.6F9493CFB1887C79.quest_desc: [
		"Mine 16 raw desh on the Moon. It is the metal of the next rocket."
	]
	quest.6F9493CFB1887C79.title: "Desh"
	quest.6FA1F440AF152046.quest_desc: [
		"Fill a bucket with liquid experience. It feeds the enchanting machines and heals no wound."
	]
	quest.6FA1F440AF152046.title: "Liquid Experience"
	quest.6FBF7C800CAD422B.quest_desc: [
		"{image:firmages:textures/quests/ponder/display_link.png width:128 height:128 align:center click_action:custom_event:firmages:ponder/create/display_link text:Click%20to%20watch}"
		"Show the time and your stores on a display board by the door."
	]
	quest.6FBF7C800CAD422B.title: "The House Speaks"
	quest.71013FE9F62EC68E.quest_desc: [
		"Craft twelve chaotic injectors from fragments and antimatter. Chaotic fusion, the highest tier, needs them: the Ultimate Singularity fills all twelve."
	]
	quest.71013FE9F62EC68E.title: "Chaotic Injectors"
	quest.7124AA6401C814BF.quest_desc: [
		"Build the Dial Home Device around a communication crystal. It dials the gate."
	]
	quest.7124AA6401C814BF.title: "Dial Home Device"
	quest.713ED981D14D9A4D.quest_desc: [
		"Build a fusion crafting core. It is the one pedestal crafting of the tech Ages."
	]
	quest.713ED981D14D9A4D.title: "Fusion Crafting Core"
	quest.714CFD10B16BAA23.quest_desc: [
		"Lay insanium farmland. The highest tier of crop grows only on it."
	]
	quest.714CFD10B16BAA23.quest_subtitle: "Insanium Fields, off \"Ore Times Five\""
	quest.714CFD10B16BAA23.title: "Insanium Farmland"
	quest.716420BDBE218479.quest_desc: [
		"Fuse 16 awakened draconium from draconium blocks, a dragon heart and the four Nether Stars the fabricator printed. Draconic gear and the reactor take it."
	]
	quest.716420BDBE218479.title: "Awakened Draconium"
	quest.716D0A3D8C64B407.quest_desc: [
		"Feed the Ore Processor ore pieces, hydrofluoric acid and kerosene: six times the metal as dust, 150,000 FE each. Lubricant doubles its speed."
	]
	quest.716D0A3D8C64B407.title: "Ore Times Six"
	quest.71A054B30C7FB195.quest_desc: [
		"Train a data model to tier 3 (Superior) and keep it running in a simulation chamber."
	]
	quest.71A054B30C7FB195.title: "Data Model: Tier 3"
	quest.71A369D7D8CDD428.quest_desc: [
		"Fit a cannon loader behind the breech. It pushes powder and shell home without a hand in the way."
	]
	quest.71A369D7D8CDD428.title: "Cannon Loader"
	quest.71AC4F9CCF7E6538.quest_desc: ["Certus quartz comes from its own vein."]
	quest.71AC4F9CCF7E6538.title: "Certus Quartz"
	quest.71B6B8FAE5353DAB.quest_desc: [
		"{image:firmages:textures/quests/device/forge_anvil.png width:128 height:128 align:center}"
		""
		"Build a charcoal forge:"
		"- Make a hole one block deep, lined with stone on its four sides and below."
		"- Right-click into it with charcoal until the pile is seven or eight layers high."
		"- Keep the sky open above it and light it with a firestarter."
		""
		"Right-click the forge: fuel goes below, the metal to heat above. Right-click raw igneous rock with a stone hammer: a stone anvil."
	]
	quest.71B6B8FAE5353DAB.title: "Forging"
	quest.71C01B7FCAA1DFB4.quest_desc: [
		"Heat the chunks and work them on the anvil. Meteoric iron falls only from the sky."
	]
	quest.71C01B7FCAA1DFB4.title: "Meteoric Iron"
	quest.7208936F94C2E0A7.quest_desc: [
		"Pick shiitake, chanterelle or parasol and eat only what you can name. The death cap kills quietly."
	]
	quest.7208936F94C2E0A7.title: "Fungus Supper"
	quest.724BED62EE9DF8FB.quest_desc: [
		"Lay two sticks on one block and sneak and right-click the pile: a firestarter. Throw a log, three sticks and some straw on one block and hold right-click on it with the firestarter until the firepit lights."
		""
		"Fire opens the Stone Age for all of you."
	]
	quest.724BED62EE9DF8FB.quest_subtitle: "Goal of Dawn: grants the Stone Age"
	quest.724BED62EE9DF8FB.title: "The First Spark"
	quest.72A754A7D51FBA06.quest_desc: ["Galena veins wake. Lead goes into capacitors."]
	quest.72A754A7D51FBA06.title: "Lead"
	quest.72DBAB3B1C9E0AD4.quest_desc: ["Electrum wire carries medium voltage."]
	quest.72DBAB3B1C9E0AD4.title: "MV Wire"
	quest.72E155A942A5A2F6.quest_desc: [
		"Make vacuum tubes, the first electronics, and the circuit boards that carry them, both at the engineer's workbench."
	]
	quest.72E155A942A5A2F6.title: "Electronics"
	quest.72F6DBF63A22264B.quest_desc: [
		"Craft a trash can. It destroys what you drop in, and its filter can limit it to the junk you name."
	]
	quest.72F6DBF63A22264B.title: "Trash Can"
	quest.7317EE63A824831B.quest_desc: ["Craft a jetpack. It flies on compressed air from its tank."]
	quest.7317EE63A824831B.title: "Air Jetpack"
	quest.73672407CE508AF9.quest_desc: [
		"Trade for rice, sugarcane or papyrus seed. The stock is random; ask again when it refills."
	]
	quest.73672407CE508AF9.title: "Strange Seed"
	quest.73CDE4A02F764C5D.quest_desc: [
		"Make 16 draconium ingots. The ore lies deep in granite, diorite and gabbro. Every fusion part is made of it."
	]
	quest.73CDE4A02F764C5D.title: "Draconium"
	quest.73D3949D8DE47C1A.quest_desc: [
		"Make four awakened draconium blocks. They are the reactor's first fuel."
	]
	quest.73D3949D8DE47C1A.title: "Reactor Fuel"
	quest.7437CB9426CFA902.quest_desc: [
		"Fit a smokestack for wood, coal or oil. It puffs the smoke of its kind while the train runs."
	]
	quest.7437CB9426CFA902.title: "Smokestack"
	quest.7448E77754C5FDAD.quest_desc: [
		"Till soil with a hoe and plant the seeds. Crops need water and time."
	]
	quest.7448E77754C5FDAD.title: "First Field"
	quest.7479AAADAC50C431.quest_desc: [
		"Write the Marid's name into a book of binding. Without it the Marid will not come."
	]
	quest.7479AAADAC50C431.title: "Book of Binding: Marid"
	quest.750293899E6D4B62.quest_desc: ["Silicon is printed into every processor."]
	quest.750293899E6D4B62.title: "Silicon"
	quest.752212025823169C.quest_desc: [
		"Build a seed drill. It plants seed on tilled ground in a line, as far as the beast walks."
	]
	quest.752212025823169C.title: "Seed Drill"
	quest.7544B0CD7D29A814.quest_desc: ["Build the tier 4 rocket from calorite. It reaches Glacio."]
	quest.7544B0CD7D29A814.title: "Tier 4 Rocket"
	quest.7594B03DF7F3FE55.quest_desc: [
		"{image:firmages:textures/quests/device/bloomery.png width:128 height:128 align:center}"
		""
		"Build a bloomery from bronze double sheets and stone bricks."
	]
	quest.7594B03DF7F3FE55.title: "Ironworks"
	quest.759550A45990B3C8.quest_desc: [
		"Take the vessel out while it glows and right-click it. Put a fired mold in the slot; the copper pours in. Ten small pieces make one ingot."
		""
		"When the mold has cooled, right-click it to take the ingot out."
	]
	quest.759550A45990B3C8.title: "Copper Ingot"
	quest.75B30357728E8618.quest_desc: [
		"{image:firmages:textures/gui/quests/works/silo_open.png width:200 height:159 align:center click_action:custom_event:firmages:ponder/ad_astra/launch_pad text:Watch%20the%20hatch%20built}"
		"Sink a silo for your rocket: a shaft 15 by 15, a hatch of two leaves that slide apart, and one signal that opens the sky."
		""
		"Click the picture to watch the hatch built."
		"{@pagebreak}"
		"{image:firmages:textures/quests/build/silo_closed.png width:128 height:128 align:center}"
		""
		"The plan: the shaft, the pad at its foot and the two leaves over the rim."
	]
	quest.75B30357728E8618.quest_subtitle: "A Great Work of the Space Age"
	quest.75B30357728E8618.title: "The Silo"
	quest.76010923C9CC9B00.quest_desc: [
		"Build a filing cabinet. It shelves goods in a small space, and the terminal reads it like a chest."
	]
	quest.76010923C9CC9B00.title: "Filing Cabinet"
	quest.7633534E257B8AD8.quest_desc: [
		"The alternator turns rotation into FE, the only bridge from SU to FE. Drive it with a steam engine on a fired boiler."
	]
	quest.7633534E257B8AD8.title: "Alternator"
	quest.7667B0006A9F5393.quest_desc: [
		"Set a hydroponic planter over a sprinkler pipe. Rice and cranberries grow in it with no watering can."
	]
	quest.7667B0006A9F5393.title: "Hydroponic Planter"
	quest.76AD68F8436EBAC0.quest_desc: [
		"Fit a combustor behind it. Kerosene burns here, and the burning is the thrust."
	]
	quest.76AD68F8436EBAC0.title: "Combustor"
	quest.77217628E2664B69.quest_desc: ["A black steel anvil works black steel double sheets."]
	quest.77217628E2664B69.title: "Black Steel Anvil"
	quest.772B64FC091E11AB.quest_desc: [
		"Two HV capacitors: one buffers your grid, one goes into the Humming Core."
	]
	quest.772B64FC091E11AB.title: "Grid Online"
	quest.774C554B16ACE98C.quest_desc: [
		"Infuse naquadah with refined obsidian, cast a base block, nine chevrons and 14 ring blocks. Chevrons take three crystals, the base four and the Singularity."
	]
	quest.774C554B16ACE98C.title: "Stargate Blocks"
	quest.774CB8EF94856508.quest_desc: [
		"Add a quantum multi-threader. The computer then runs many jobs side by side."
	]
	quest.774CB8EF94856508.title: "Multi-Threader"
	quest.7755ECDE0FFE3821.quest_desc: [
		"Craft it from a Hearth Idol (H), cobblestone (S) and charcoal (C):"
		"- C -"
		"S H S"
		"- S -"
		""
		"Leave 21 by 21 blocks free: each Age adds a ring."
	]
	quest.7755ECDE0FFE3821.title: "The Shrine Heart"
	quest.7790A6723360B877.quest_desc: [
		"Purify ore pieces in oxygen into clumps of nickel or zinc. Shards and crystals of the old metals follow in the Space and Quantum Ages."
	]
	quest.7790A6723360B877.quest_subtitle: "More Metals, off \"Purification Chamber\""
	quest.7790A6723360B877.title: "Clumps"
	quest.7794323527566501.quest_desc: [
		"Fire a jug and fill it at a river. Put a fired ceramic pot on the firepit, pour the water in and cook a soup."
	]
	quest.7794323527566501.title: "A Pot of Soup"
	quest.785E11655A4373F7.quest_desc: [
		"White needles crust the rim of some hot springs. Gather saltpeter where they grow."
	]
	quest.785E11655A4373F7.title: "Saltpeter"
	quest.7862543503C7427F.quest_desc: [
		"Cast an infusion spell at a gold ingot to turn it into psimetal. Its tools and exosuit hold spells in the metal itself."
	]
	quest.7862543503C7427F.title: "Psimetal"
	quest.7883DC5AF7968152.quest_desc: [
		"Feed 1,000,000,000 FE into the heart, then pray at the complete shrine with your fellowship. Caelum gives back the nine relics for the chaotic fusion."
	]
	quest.7883DC5AF7968152.title: "The Gathering"
	quest.788DBBB6DC2F675A.quest_desc: [
		"A snorkel lengthens your breath and flippers quicken your stroke. Wear both before you cross deep water."
	]
	quest.788DBBB6DC2F675A.title: "Snorkel and Flippers"
	quest.78BC50AA2EA84FAF.quest_desc: [
		"Set a stainless steel vat on an oven. It boils sugar water, jam and sauces in great measure."
	]
	quest.78BC50AA2EA84FAF.title: "Vat"
	quest.78BCBA6ED2298E76.quest_desc: [
		"Craft an advanced wireless terminal. Open your storage from the field, within its reach."
	]
	quest.78BCBA6ED2298E76.title: "Wireless Terminal"
	quest.78D15026ED1ED0B2.quest_desc: [
		"A Sky Anchor carries the shrine's blessings within 24 blocks, on the Moon and Mars too. Set blessing shards into it."
	]
	quest.78D15026ED1ED0B2.title: "Sky Anchor"
	quest.797C5C3C4D56A1A7.quest_desc: [
		"Build a programmer. A spell is a small program of pieces you set in a grid."
	]
	quest.797C5C3C4D56A1A7.title: "Programmer"
	quest.7997DC1DFF73EA36.quest_desc: [
		"{image:firmages:textures/quests/device/log_pile.png width:128 height:128 align:center}"
		"{image:firmages:textures/quests/device/charcoal_pit.png width:128 height:128 align:center}"
		""
		"Make 32 charcoal in a charcoal pit; a bigger pile burns in the same time:"
		"- Sneak and right-click the ground with logs: a log pile. Right-click it with more logs."
		"- Cover every side with dirt, leave the top open and light it with a firestarter."
		"- Close the gap with dirt."
		""
		"When the smoke stops, dig the charcoal out with a shovel. The forge, the casting and the Hearthstone burn it."
	]
	quest.7997DC1DFF73EA36.title: "A Better Fuel"
	quest.79BD86B5CD663079.quest_desc: ["The alloy kiln alloys two metals in the right ratios."]
	quest.79BD86B5CD663079.title: "Alloy Kiln"
	quest.79D2D4E17FC9732D.quest_desc: [
		"{image:firmages:textures/gui/quests/shrine/ring_5_build.apng.png width:220 height:148 align:center}"
		"Raise the Tesla Crown round the Foundry Nave. 72 new blocks in five layers:"
		"- 51 aluminium blocks"
		"- eight aluminium scaffolding"
		"- four floodlights"
		"- four HV capacitors"
		"- four red steel blocks"
		"- the Offering Plinth"
		""
		"Right-click the heart with an empty hand: it shows every missing block as a ghost."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_5_layer_1.png width:220 height:148 align:center}"
		"Layer one of five, level with the heart: 51 aluminium blocks, four red steel blocks, the Offering Plinth."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_5_layer_2.png width:220 height:148 align:center}"
		"Layer two of five, one block up: four HV capacitors."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_5_layer_3.png width:220 height:148 align:center}"
		"Layer three of five, two blocks up: four aluminium scaffolding."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_5_layer_4.png width:220 height:148 align:center}"
		"Layer four of five, three blocks up: four aluminium scaffolding."
		"{@pagebreak}"
		"{image:firmages:textures/gui/quests/shrine/ring_5_layer_5.png width:220 height:148 align:center}"
		"Layer five of five, four blocks up: four floodlights."
		"{@pagebreak}"
		"Lay the Humming Core on the plinth. Your Tally Chutes must have taken 512 aluminium ingots in this Age."
		""
		"The rite:"
		"- Light the four floodlights of the crown: they need power and a redstone signal."
		"- Charge the four capacitors of the crown with 1,000,000 FE together."
		""
		"Then sneak and hold right-click on the heart with an empty hand. Caelum opens the Information Age."
	]
	quest.79D2D4E17FC9732D.quest_subtitle: "The shrine ring of the Electric Age"
	quest.79D2D4E17FC9732D.title: "Tesla Crown"
	quest.79DA4E6D4518762C.quest_desc: [
		"Mix deuterium and tritium into fusion fuel and fill a hohlraum with it. A laser fires the hohlraum to ignite the reactor."
	]
	quest.79DA4E6D4518762C.title: "Fusion Fuel"
	quest.79F8E831F68430F0.quest_desc: [
		"{image:firmages:textures/quests/ponder/elevator.png width:128 height:128 align:center click_action:custom_event:firmages:ponder/create/elevator_pulley text:Click%20to%20watch}"
		"Run an elevator pulley through the floors. A redstone contact on each floor turns into an elevator contact once the lift works."
	]
	quest.79F8E831F68430F0.title: "A Lift"
	quest.7A112170DDA4569A.quest_desc: [
		"Carry a mobile packager. It wraps and addresses parcels in your hands, wherever you stand."
	]
	quest.7A112170DDA4569A.title: "Mobile Packager"
	quest.7A1EFBE16BED1D0E.quest_desc: [
		"Craft a Tally Chute. It takes only the metal Caelum asks as proof of work, counts it and keeps it."
	]
	quest.7A1EFBE16BED1D0E.title: "Tally Chute"
	quest.7A8400A11F9672D2.quest_desc: [
		"Write a schedule and hand it to the driver. Stops, waits and signals follow in order."
	]
	quest.7A8400A11F9672D2.title: "Schedule"
	quest.7AA47D3B7EF4F22D.quest_desc: [
		"Carry a charm of second wind. When the last blow lands, it keeps death at the door while its charge lasts."
	]
	quest.7AA47D3B7EF4F22D.title: "Second Wind"
	quest.7AB56731725A5ABE.quest_desc: [
		"Keep a shard from The Primordial's last phase: they lie a minute and never come again. Four glass and a shard make four Firmament Glass."
	]
	quest.7AB56731725A5ABE.title: "A Piece of the Sky"
	quest.7AD930D88D608D2B.quest_desc: [
		"Craft a destruction gadget. It clears a marked cube of blocks at the cost of power."
	]
	quest.7AD930D88D608D2B.title: "Destruction Gadget"
	quest.7B0276B3AACDABA7.quest_desc: [
		"Craft twelve awakened injectors. Fusion at draconic level needs them: the chaotic core and the reactor parts fill all twelve."
	]
	quest.7B0276B3AACDABA7.title: "Awakened Injectors"
	quest.7B69D13D449B33FD.quest_desc: [
		"Break wild crops for their seeds. Seeds of two different crops are the start of a field."
	]
	quest.7B69D13D449B33FD.title: "Seeds of the Wild"
	quest.7BC89A40B08037A9.quest_desc: [
		"Carry a navigator. Choose a station and it shows the way, line by line."
	]
	quest.7BC89A40B08037A9.title: "Navigator"
	quest.7C878DBD5BA844AA.quest_desc: [
		"Build a small brick chimney for the house fire. It fits a narrow roof and a small hearth."
	]
	quest.7C878DBD5BA844AA.title: "Brick Chimney"
	quest.7CAFD457060E1D38.quest_desc: [
		"Craft a nether star shard from the essence of its crop. Three shards make a star, and the Wither can rest."
	]
	quest.7CAFD457060E1D38.title: "Nether Star Shard"
	quest.7CBAA4C9C912A97A.quest_desc: [
		"Set a mechanical extruder on a spinning shaft. What lies at its sides and below decides the block it makes."
	]
	quest.7CBAA4C9C912A97A.title: "Extruder"
	quest.7CDF23C64D3D4961.quest_desc: [
		"Food rots. Sealed large vessels, salting, drying and cooking slow it down. Eat from every food group: grain, fruit, vegetables, protein and dairy."
	]
	quest.7CDF23C64D3D4961.title: "Food Decay and Nutrition"
	quest.7D3E0B16F1ABA0F0.quest_desc: [
		"Fill a bucket with dragon breath. Fans and mixers use it where fire and water will not do."
	]
	quest.7D3E0B16F1ABA0F0.title: "Dragon Breath"
	quest.7D4E607C9802B193.quest_desc: [
		"Place a cell dock. A cell can be slid in and out without a drive or a wall."
	]
	quest.7D4E607C9802B193.title: "Cell Dock"
	quest.7D63696AE5DD4462.quest_desc: [
		"Build a simple reforging table. It rolls the affixes of a piece anew for rarity materials and sigils of rebirth."
	]
	quest.7D63696AE5DD4462.title: "Reforging"
	quest.7D7123962985F669.quest_desc: [
		"Raise a MEGA crafting unit, the frame of a greater crafting computer. Its storage blocks hold jobs too big for the old one."
	]
	quest.7D7123962985F669.title: "MEGA Crafting Unit"
	quest.7D79D0CCA81D025B.quest_desc: [
		"{image:firmages:textures/quests/ponder/mechanical_bearing.png width:128 height:128 align:center click_action:custom_event:firmages:ponder/create/mechanical_bearing text:Click%20to%20watch}"
		"Glue the bridge deck to a mechanical bearing at the gate. Turn it up at night and the ditch is open again."
	]
	quest.7D79D0CCA81D025B.title: "Drawbridge"
	quest.7E170B2C5BDCD664.quest_desc: [
		"Craft a counter gauge. It counts redstone pulses and gives a signal when the count is reached."
	]
	quest.7E170B2C5BDCD664.title: "Counter Gauge"
	quest.7E2D0099177BFBE8.quest_desc: [
		"Every head is laid with a stick on one block and crafted on the ground (see \"By Hand\"). Light squares stay, dark squares are knocked away. Mirrored shapes work too."
		""
		"Knife blades, two from one rock:"
		"{image:firmages:textures/quests/knapping/knife_blades.png width:64 height:64 align:center}"
		""
		"Hammer head, breaks logs into sticks:"
		"{image:firmages:textures/quests/knapping/hammer_head.png width:64 height:64 align:center}"
		""
		"Shovel head, digs faster:"
		"{image:firmages:textures/quests/knapping/shovel_head.png width:64 height:64 align:center}"
		""
		"Hoe heads, two from one rock:"
		"{image:firmages:textures/quests/knapping/hoe_heads.png width:64 height:64 align:center}"
		""
		"Javelin head, for the hunt:"
		"{image:firmages:textures/quests/knapping/javelin_head.png width:64 height:64 align:center}"
		""
		"There is no stone pickaxe. The first pickaxe is cast in copper in the Stone Age."
	]
	quest.7E2D0099177BFBE8.title: "Knapping Patterns"
	quest.7E8F9975B89F863C.quest_desc: [
		"Set an inventory hopper on the network. Right-click an item on it to choose what it takes or gives."
	]
	quest.7E8F9975B89F863C.quest_subtitle: "Terminal Habits, off \"Storage Terminal\""
	quest.7E8F9975B89F863C.title: "Inventory Hopper"
	quest.7ECFFB6EEDF1B9FB.quest_desc: ["Steel wire carries high voltage over long distances."]
	quest.7ECFFB6EEDF1B9FB.title: "HV Wire"
	quest.7F2A6271CA52B219.quest_desc: [
		"Raise a cannon mount and fit the tube. It aims by turning shafts and holds against the recoil."
	]
	quest.7F2A6271CA52B219.title: "Cannon Mount"
	quest.7F4BB9218EAC60EC.quest_desc: [
		"Crush clumps into dirty dust and clean it in the enrichment chamber. Dust is the last rung."
	]
	quest.7F4BB9218EAC60EC.title: "Dirty Dust"
	quest.7F7FDC6BE3F8FE9F.quest_desc: [
		"Find the ruined shrine of Caelum that stands 300 to 800 blocks from where you woke. A faint beam rises from it. Look at its core."
	]
	quest.7F7FDC6BE3F8FE9F.title: "A Shrine on the Road"
