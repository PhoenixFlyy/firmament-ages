// JourneyMap server configuration file. Modify at your own risk!
// To restore the default settings, simply delete this file before starting Minecraft server
// For more information, go to: http://journeymap.info/JourneyMapServer
//
// Global Server Configuration : Applies to all dimensions unless overridden.
// Firmament Ages (round G1, Felix M1A 2026-10-17): no radar (players, villagers, animals, mobs) and no player
// tracking beyond render distance; no death points (GraveStone marks a death, and a death beacon before the Iron Age
// would be a map feature before its Age). Every other value is JourneyMap 6.0.9's default, written in the form and
// order JourneyMap writes this file, with configVersion, so it is read as current and not rewritten.
// The map itself waits for the Iron Age on each client (firmages-core, firmages-client.toml [ui] mapFromAge).
{
  "journeymapEnabled": "true",
  "useWorldId": "true",
  "viewOnlyServerProperties": "true",
  "allowMultiplayerSettings": "ALL",
  "worldPlayerRadar": "NONE",
  "worldPlayerRadarUpdateTime": "5",
  "seeUndergroundPlayers": "ALL",
  "hideOps": "false",
  "opsSeeHiddenPlayers": "true",
  "hideSpectators": "false",
  "allowDeathPoints": "false",
  "showInGameBeacons": "true",
  "allowWaypoints": "true",
  "waypointTeleportOnly": "false",
  "radarLateralDistance": "512",
  "radarVerticalDistance": "320",
  "maxAnimalsData": "128",
  "maxAmbientCreaturesData": "128",
  "maxMobsData": "128",
  "maxPlayersData": "128",
  "maxVillagersData": "128",
  "minimapEnabled": "true",
  "hideCoordinates": "false",
  "globalWaypointsOnly": "false",
  "teleport": "OPS",
  "teleportEnabled": "false",
  "crossDimTeleport": "true",
  "surfaceRenderRange": "0",
  "caveRenderRange": "0",
  "surfaceMapping": "ALL",
  "topoMapping": "ALL",
  "biomeMapping": "ALL",
  "caveMapping": "ALL",
  "radarEnabled": "NONE",
  "playerRadarEnabled": "false",
  "playerRadarNamesEnabled": "false",
  "villagerRadarEnabled": "false",
  "animalRadarEnabled": "false",
  "mobRadarEnabled": "false",
  "configVersion": "6.0.9"
}
