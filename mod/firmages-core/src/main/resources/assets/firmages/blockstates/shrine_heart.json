{
  "multipart": [
    {
      "when": {
        "lit": "false"
      },
      "apply": {
        "model": "firmages:block/shrine_heart"
      }
    },
    {
      "when": {
        "lit": "true"
      },
      "apply": {
        "model": "firmages:block/shrine_heart_lit"
      }
    },
    {
      "when": {
        "maintenance": "true"
      },
      "apply": {
        "model": "firmages:block/shrine_heart_maintenance"
      }
    }
  ]
}
