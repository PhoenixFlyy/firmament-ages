	quest.0A81ED2F8A5BB2AE.quest_subtitle: "Age 1"
	quest.0A81ED2F8A5BB2AE.title: "Welcome to the Bronze Age"
	quest.0ABF4F27145CD228.quest_desc: [
		"Sticks lie on the forest floor and drop from leaves. You need them for every tool shaft."
	]
	quest.0ABF4F27145CD228.title: "A Bundle of Sticks"
	quest.0AD1277F0C750FBC.quest_desc: [
		"The TFCreate fuel heater heats a basin: heated mixing and compacting."
	]
	quest.0AD1277F0C750FBC.title: "Fuel Heater"
	quest.0AF4168528180400.quest_desc: ["Rocket fuel is refined from your oil. EMI shows the route."]
	quest.0AF4168528180400.title: "Rocket Fuel"
	quest.0B2B6BE451DD1912.quest_desc: ["Sixteen buckets of diesel from your own refinery."]
	quest.0B2B6BE451DD1912.title: "Refined Diesel"
	quest.0B2CE763E15475FA.quest_desc: [
		"Clay grows under grass near water. Look for the clay indicator plants."
	]
	quest.0B2CE763E15475FA.title: "Locating Clay"
	quest.0BA4D1B6A66D0C59.quest_desc: [
		"Imbue TFC amethyst or lapis lazuli. Source gems are the base of every Ars recipe."
	]
	quest.0BA4D1B6A66D0C59.title: "Source Gems"
	quest.0C271F72FE0B4376.quest_desc: ["Bauxite veins are visible from this Age."]
	quest.0C271F72FE0B4376.title: "Bauxite"
	quest.0C379E8319A22836.quest_desc: [
