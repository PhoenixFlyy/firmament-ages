	quest.0C379E8319A22836.title: "Chunk Claims"
	quest.0C522194B14B71CC.quest_desc: ["A backpack carries a second inventory."]
	quest.0C522194B14B71CC.title: "Pack Mule"
	quest.0D0AB1CA40800F5A.quest_desc: ["Break a wild crop to get its seeds."]
	quest.0D0AB1CA40800F5A.title: "Gatherer"
	quest.0D99128B070FE166.quest_desc: [
		"The chaotic chestpiece has a direct recipe. Wear it into the final battle."
	]
	quest.0D99128B070FE166.title: "Chaotic Armor"
	quest.0E48C0E43D256E7D.quest_desc: [
		"Summon the Wither and defeat it. The Humming Core needs its Nether Star."
	]
	quest.0E48C0E43D256E7D.title: "The Wither"
	quest.0F1AE784BF392A25.quest_desc: [
		"Mekanism triples ore, AE2 stores and crafts everything, and the End can be reached."
		"Osmium and certus quartz veins are visible now."
		""
		"Four strands lead to the Data Matrix: Digital, Mekanism, Mob Data and The End."
	]
	quest.0F1AE784BF392A25.quest_subtitle: "Age 6"
	quest.0F1AE784BF392A25.title: "Welcome to the Information Age"
	quest.0F76089092EB0D28.quest_desc: ["Injectors around the core hold the ingredients."]
	quest.0F76089092EB0D28.title: "Injectors"
	quest.0F97073C5BDEA813.quest_desc: ["Transformers step the voltage between wire tiers."]
	quest.0F97073C5BDEA813.title: "Transformers"
	quest.0FBE04E270216ADA.quest_desc: [
		"The cauldron dissolves RICH TFC ore pieces into alchemical sulfur."
	]
	quest.0FBE04E270216ADA.title: "Liquefaction Cauldron"
	quest.0FF697E3625FD70E.quest_desc: [
		"IE machines are multiblocks: build the shape from the Engineer's Manual, then hit the marked"
