	quest.0FF697E3625FD70E.title: "Multiblocks"
	quest.102A4D2C50AB6948.quest_desc: ["A jetpack on hydrogen."]
	quest.102A4D2C50AB6948.title: "Mekanism Jetpack"
	quest.10708C5D853308E7.quest_desc: ["The controller sits in the top of the reactor."]
	quest.10708C5D853308E7.title: "Reactor Controller"
