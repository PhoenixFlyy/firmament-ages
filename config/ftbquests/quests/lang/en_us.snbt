	quest.10D18EB5418E22F1.title: "Constantan"
	quest.10E81DCA65CCD6C7.quest_desc: ["Thirty-two ostrum plates."]
	quest.10E81DCA65CCD6C7.title: "Ostrum Plates"
	quest.10F7B6A8850E3BCE.quest_desc: ["Mine ostrum on Mars."]
	quest.10F7B6A8850E3BCE.title: "Ostrum"
