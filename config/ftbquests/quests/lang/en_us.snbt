{
	chapter.1D01936AE318F34B.chapter_subtitle: ["The map opens. Iron veins become visible."]
	chapter.1D01936AE318F34B.title: "Age 2: Iron Age"
	chapter.1ECA2119E26A0A06.chapter_subtitle: ["Clay, pit kilns and the first cast copper."]
	chapter.1ECA2119E26A0A06.title: "Age 0: Stone Age"
	chapter.2F7890D901468DC7.chapter_subtitle: ["How Firmament Ages works. Press K to open this screen."]
	chapter.2F7890D901468DC7.title: "Welcome"
	chapter.544197C921D77FCB.chapter_subtitle: ["Prologue: stone, straw and the first spark."]
	chapter.544197C921D77FCB.title: "Dawn"
	chapter.5546E96FD2574ABB.chapter_subtitle: ["The first alloys. New veins can be found."]
	chapter.5546E96FD2574ABB.title: "Age 1: Bronze Age"
	chapter.7D0742BC787AAFAC.chapter_subtitle: [
		"Every Age ends with one signature item. This is the whole road, from the first spark"
		"to the final gate."
	]
	chapter.7D0742BC787AAFAC.title: "The Firmament"
	chapter_group.7E67E59034114849.title: "Ages"
	file.0000000000000001.title: "Firmament Ages"
	quest.0025DE3687DD8D07.quest_desc: [
		"Build a barrel with a saw and lumber. Barrels brine, pickle and tan."
	]
	quest.0025DE3687DD8D07.title: "Do a Barrel Roll!"
	quest.00276F8FDCF146F5.quest_desc: [
		"A storage terminal shows every connected chest in one screen."
	]
	quest.00276F8FDCF146F5.title: "Tom's Storage"
	quest.04AB34FB1FD2E8B6.quest_desc: [
		"Every Age chapter has one entry quest, three or four required strands and one goal."
		"Each strand ends in a keystone (the larger quests). The goal needs every keystone."
		"Round quests are side missions: optional, with a comfort reward."
		"Gears are explanations: tick them once you have read them."
	]
	quest.04AB34FB1FD2E8B6.title: "Reading a Chapter"
	quest.04DAC1D51AABFF20.quest_desc: [
		"The signature item of Age 1: Bronze Age. Details appear when the Age before it is done."
	]
	quest.04DAC1D51AABFF20.quest_subtitle: "Goal of Age 1: Bronze Age"
	quest.04DAC1D51AABFF20.title: "Sky Disc"
	quest.05C4B3AE61613A9B.quest_desc: [
		"Iron veins are visible now, the map opens and the Twilight Forest can be reached."
		""
		"Four strands lead to the Steel Heart: Metallurgy, Power & Motion, Survival and Frontier."
	]
	quest.05C4B3AE61613A9B.quest_subtitle: "Age 2"
	quest.05C4B3AE61613A9B.title: "Welcome to the Iron Age"
	quest.063F1A5EA37B6B16.quest_desc: [
		"Smith a prospector's pick on an anvil (Smithing strand). It finds ore through stone."
	]
	quest.063F1A5EA37B6B16.title: "Prospector"
	quest.0672AC049845AEE4.quest_desc: [
		"Your own tanned leather makes the first armor. Wear it before the first winter trip."
	]
	quest.0672AC049845AEE4.title: "Leather Armor"
	quest.077BFA2D599B1A4B.quest_desc: [
		"The signature item of Age 3: Arcane Age. Details appear when the Age before it is done."
	]
	quest.077BFA2D599B1A4B.quest_subtitle: "Goal of Age 3: Arcane Age"
	quest.077BFA2D599B1A4B.title: "Arcane Keystone"
	quest.07D42ECD95337D7C.quest_desc: [
		"Power a millstone from a water wheel. It grinds what the quern grinds by hand."
	]
	quest.07D42ECD95337D7C.title: "First Mill"
	quest.0A55EE1E0335D077.quest_desc: [
		"Use a stone hammer on raw igneous rock to make a stone anvil."
	]
	quest.0A55EE1E0335D077.title: "Hammer Time"
	quest.0A81ED2F8A5BB2AE.quest_desc: [
		"Tin and zinc veins are visible now. Anvils, alloys and the first Create machines follow."
		""
		"Four strands lead to the Sky Disc: Smithing, Prospecting, Alloys and Kinetics."
	]
	quest.0A81ED2F8A5BB2AE.quest_subtitle: "Age 1"
	quest.0A81ED2F8A5BB2AE.title: "Welcome to the Bronze Age"
	quest.0ABF4F27145CD228.quest_desc: [
		"Sticks lie on the forest floor and drop from leaves. You need them for every tool shaft."
	]
	quest.0ABF4F27145CD228.title: "A Bundle of Sticks"
	quest.0AD1277F0C750FBC.quest_desc: [
		"The TFCreate fuel heater heats a basin: heated mixing and compacting."
	]
	quest.0AD1277F0C750FBC.title: "Fuel Heater"
	quest.0B2CE763E15475FA.quest_desc: [
		"Clay grows under grass near water. Look for the clay indicator plants."
	]
	quest.0B2CE763E15475FA.title: "Locating Clay"
	quest.0C522194B14B71CC.quest_desc: ["A backpack carries a second inventory."]
	quest.0C522194B14B71CC.title: "Pack Mule"
	quest.0D0AB1CA40800F5A.quest_desc: ["Break a wild crop to get its seeds."]
	quest.0D0AB1CA40800F5A.title: "Gatherer"
	quest.11D75C261FA24AE3.quest_desc: ["A wrought iron anvil can work steel."]
	quest.11D75C261FA24AE3.title: "Iron Anvil"
	quest.136A6DB3C34D16EB.quest_desc: [
		"Steam engines on a boiler give far more force than water wheels."
	]
	quest.136A6DB3C34D16EB.title: "Steam Engine"
	quest.153E204EC2BA3ACA.quest_desc: [
		"Place two thatch blocks side by side and use a large raw hide on them."
		"The thatch bed sets your spawn point. You cannot sleep through the night in it."
		"Large hides come from large animals: the Hunt strand gets them."
	]
	quest.153E204EC2BA3ACA.title: "Shelter"
	quest.157E197DE71E5ECA.quest_desc: [
		"Weld copper double ingots into a copper anvil. Tools and sheets are smithed on it."
	]
	quest.157E197DE71E5ECA.title: "Copper Anvil"
	quest.166C4569CC75A30A.quest_desc: [
		"Firmalife adds ovens, cheese, drying and more. A drying mat is the first step."
	]
	quest.166C4569CC75A30A.title: "Kitchen"
	quest.16708A1C39158F9C.quest_desc: [
		"In Dawn you cannot dig clay, build pit kilns or use metal."
		"The crafting grid only makes stone tool shafts, the firestarter, straw, thatch, sticks and rope."
		"Everything else opens with the Stone Age."
	]
	quest.16708A1C39158F9C.title: "What Dawn Locks"
	quest.1AFE479E5402BCCB.quest_desc: ["Grottols hide in caves and flee. Catch one if you can."]
	quest.1AFE479E5402BCCB.title: "Grottol Hunt"
	quest.1BC2A62B4D301274.quest_desc: [
		"Hot items glow. The tooltip shows the temperature; metal melts at its own heat."
	]
	quest.1BC2A62B4D301274.title: "Heat Colors"
	quest.1C3849490BE7F034.quest_desc: ["Defeat the Naga in its courtyard."]
	quest.1C3849490BE7F034.title: "The Naga"
	quest.1CC29E163A94FCE6.quest_desc: [
		"Place unfired pottery, cover it with straw and logs and set it on fire: a pit kiln."
	]
	quest.1CC29E163A94FCE6.title: "Potter"
	quest.1CEE5246AF1BDCB2.quest_desc: [
		"Render fat into tallow and make candles. Light without fire hazards."
	]
	quest.1CEE5246AF1BDCB2.title: "Tallow and Candles"
	quest.2004E11B844D1C4B.quest_desc: [
		"Each Age has its own chapter. A chapter appears when your team reaches its Age."
		"Recipes of a later Age do not exist yet, anywhere: not in the crafting grid, not in machines."
		"EMI shows them once their Age is unlocked."
		""
		"Ores of later Ages look like plain stone until their Age."
	]
	quest.2004E11B844D1C4B.title: "The Ages"
	quest.203071592A4D660A.quest_desc: [
		"Four straw make one block of thatch. It is the only building block of Dawn."
	]
	quest.203071592A4D660A.title: "Thatch"
	quest.206BCC87705BB466.quest_desc: ["Knap a javelin head and shaft it. Throw it or stab with it."]
	quest.206BCC87705BB466.title: "A Stone Javelin"
	quest.2070B77706F2CB8E.quest_desc: [
		"Craft the Sky Disc: a bronze double sheet from the bronze anvil and gold sheets."
		""
		"Grow the shrine by its second ring, the Bronze Sanctum: rock bricks, four bronze blocks and"
		"a bronze bell. Use the heart with an empty hand to see the missing blocks."
		"Lay the Sky Disc on the new plinth, ring the bell and pray at the heart."
		""
		"Caelum keeps the Sky Disc as a relic and opens the Iron Age for the whole team."
	]
	quest.2070B77706F2CB8E.quest_subtitle: "Goal of the Bronze Age: Caelum opens the Iron Age"
	quest.2070B77706F2CB8E.title: "Offer the Sky Disc at the Shrine"
	quest.20986504959DC566.quest_desc: [
		"Melt copper with tin, bismuth or gold and silver in the right ratio."
	]
	quest.20986504959DC566.title: "Bronze"
	quest.214D6B55DD018CDF.quest_desc: [
		"Dig a cellar below ground: it stays cool. Fill large vessels and seal them."
	]
	quest.214D6B55DD018CDF.title: "Cellar Vessels"
	quest.23B75CB262B7C101.quest_desc: ["Mix clay with kaolinite and graphite powder into fire clay."]
	quest.23B75CB262B7C101.title: "Fireproof"
	quest.23B8CBEFB688315B.quest_desc: [
		"Cast the pig iron. Hammer it into high carbon steel, then into steel."
	]
	quest.23B8CBEFB688315B.title: "Pig Iron"
	quest.23C92958F20BE038.quest_desc: ["A water wheel in flowing water gives rotational force."]
	quest.23C92958F20BE038.title: "Water Wheel"
	quest.2444E19A6383B59C.quest_desc: ["Hammer the bloom on an anvil until it becomes wrought iron."]
	quest.2444E19A6383B59C.title: "The Iron Age"
	quest.24E7968E14C34C9C.quest_desc: ["Cut tall grass with a stone knife to get straw."]
	quest.24E7968E14C34C9C.title: "Grasping at Straws"
	quest.26D594F0567CC39A.quest_desc: [
		"A bronze anvil forges bronze double sheets: the Sky Disc needs one."
	]
	quest.26D594F0567CC39A.title: "Bronze Anvil"
	quest.271B9FEFDBDBD98F.quest_desc: ["Weld two hot ingots into a double ingot on the stone anvil."]
	quest.271B9FEFDBDBD98F.title: "Double Trouble"
	quest.289281EB5946B550.quest_desc: [
		"Andesite alloy is TFC andesite cobble and zinc nuggets. It is the base of Create."
	]
	quest.289281EB5946B550.title: "Andesite Alloy"
	quest.28A963AA218A4EE4.quest_desc: [
		"Craft the Steel Heart: a steel sheet, a precision mechanism, wrought iron double sheets"
		"and the Lich trophy."
		""
		"Grow the shrine by its third ring, the Iron Sanctum: four pillars of smooth rock with"
		"wrought iron bars and four wrought iron lamps. Use the heart to see the missing blocks."
		"Lay the Steel Heart on the new plinth, light the four lamps and pray at the heart."
		""
		"Caelum keeps the Steel Heart as a relic and opens the Arcane Age for the whole team."
	]
	quest.28A963AA218A4EE4.quest_subtitle: "Goal of the Iron Age: Caelum opens the Arcane Age"
	quest.28A963AA218A4EE4.title: "Offer the Steel Heart at the Shrine"
	quest.29BF6EA4F2FCD8F4.quest_desc: [
		"Mine the tin and zinc veins you found and cast their ingots."
	]
	quest.29BF6EA4F2FCD8F4.title: "First Mine"
	quest.2AA19A118F3D7E22.quest_desc: [
		"Metal can only be worked or welded while it is hot enough. Check the tooltip color."
	]
	quest.2AA19A118F3D7E22.title: "Working Heat"
	quest.2CEDC0346E550CE6.quest_desc: [
		"A TFC year has seasons. Crops stop growing in winter and it gets cold. Plan ahead."
	]
	quest.2CEDC0346E550CE6.title: "The First Winter"
	quest.2DC5143776D7B7D7.quest_desc: [
		"Sixteen steel ingots. From here on, steel is a material, not a trophy."
	]
	quest.2DC5143776D7B7D7.title: "Steel Ingots"
	quest.2EC89EF1F5DED2A1.quest_desc: ["The saw cuts TFC logs into lumber."]
	quest.2EC89EF1F5DED2A1.title: "Mechanical Saw"
	quest.2F40BC4F2411937D.quest_desc: ["Cassiterite pieces on the ground point to a tin vein below."]
	quest.2F40BC4F2411937D.title: "Tin on the Surface"
	quest.2F5F52EBC70FEF35.quest_desc: [
		"The fired small vessel melts ore when it sits in a fire or a pit kiln."
	]
	quest.2F5F52EBC70FEF35.title: "Small Vessel"
	quest.30A13F8701E9EF80.quest_desc: [
		"Build the Hearth Circle around the heart: eight cobblestone of any rock around it, four log"
		"posts two blocks high on the corners of a 5x5 square with thatch on top, and an Offering Plinth"
		"(four cobblestone) two blocks from the heart."
		"Use the heart with an empty hand to see the missing blocks in place."
		""
		"When the circle is complete, the heart glows. Use it again: it names the offering Caelum asks for."
	]
	quest.30A13F8701E9EF80.title: "Raise the Shrine"
	quest.3213BFEF5EB29C5C.quest_desc: [
		"Fire an ingot mold and a pickaxe head mold. They take liquid copper."
	]
	quest.3213BFEF5EB29C5C.title: "Mold Set"
	quest.3240A673372AF11A.quest_desc: [
		"The signature item of Age 0: Stone Age. Details appear when the Age before it is done."
	]
	quest.3240A673372AF11A.quest_subtitle: "Goal of Age 0: Stone Age"
	quest.3240A673372AF11A.title: "Hearthstone"
	quest.32C8626D60896E8F.quest_desc: [
		"Pick up a loose rock from the ground. Rocks are knapped by using them in hand."
	]
	quest.32C8626D60896E8F.title: "Just a Rock"
	quest.32D33BE8EB20FCA6.quest_desc: [
		"The signature item of Age 5: Electric Age. Details appear when the Age before it is done."
	]
	quest.32D33BE8EB20FCA6.quest_subtitle: "Goal of Age 5: Electric Age"
	quest.32D33BE8EB20FCA6.title: "Humming Core"
	quest.33818E6B3089AF9E.quest_desc: [
		"The signature item of Age 7: Space Age. Details appear when the Age before it is done."
	]
	quest.33818E6B3089AF9E.quest_subtitle: "Goal of Age 7: Space Age"
	quest.33818E6B3089AF9E.title: "Star Chart"
	quest.349C4476B51DAC16.quest_desc: [
		"Fill the bloomery with iron ore and charcoal and let it burn."
	]
	quest.349C4476B51DAC16.title: "In Bloom"
	quest.34A20DCC53F255CC.quest_desc: [
		"The blast furnace makes pig iron from iron ore, charcoal and flux."
	]
	quest.34A20DCC53F255CC.title: "Blast Off!"
	quest.35ADF495118E2323.quest_desc: [
		"Split a TFC zinc ingot into nine zinc nuggets in the crafting grid."
	]
	quest.35ADF495118E2323.title: "Zinc Nuggets"
	quest.36C48EC86A43AA92.quest_desc: [
		"Sequenced assembly on a brass base. Many Iron Age machines need it."
	]
	quest.36C48EC86A43AA92.title: "Precision Mechanism"
	quest.3A5D0F3FAA56A074.quest_desc: ["Copper ore pieces lie on the surface above copper veins."]
	quest.3A5D0F3FAA56A074.title: "Native Copper"
	quest.3AD1F9C2C23677C5.quest_desc: ["Gather wild berries. Fruit is a nutrition group of its own."]
	quest.3AD1F9C2C23677C5.title: "Berries and Herbs"
	quest.3B588CB49C0F4193.quest_desc: [
		"Fire the idol in a pit kiln, like any other pottery. It becomes the Hearthstone."
	]
	quest.3B588CB49C0F4193.title: "Hearth Idol"
	quest.3B636FCBEF145ABE.quest_desc: ["Smith any bronze tool."]
	quest.3B636FCBEF145ABE.title: "The Bronze Age"
	quest.3BAC7E39FA05241C.quest_desc: [
		"Grind borax, lime or other flux stones in the quern. Welding needs flux."
	]
	quest.3BAC7E39FA05241C.title: "In Flux"
	quest.3C3FF2D0079C4F17.quest_desc: [
		"Food decays and tools wear out as in plain TerraFirmaCraft. Nothing is softened."
		"Everything you need in quantity can be automated later. Hand work comes first."
	]
	quest.3C3FF2D0079C4F17.title: "Survival Notes"
	quest.3C8510408C6A23D6.quest_desc: [
		"The signature item of Age 8: Quantum Age. Details appear when the Age before it is done."
	]
	quest.3C8510408C6A23D6.quest_subtitle: "Goal of Age 8: Quantum Age"
	quest.3C8510408C6A23D6.title: "Quantum Core"
	quest.3EAA8BE972DC58F9.quest_desc: [
		"Alloy copper and zinc into brass, by hand in the crucible or heated in a Create basin."
	]
	quest.3EAA8BE972DC58F9.title: "Brass"
	quest.3F8D45ADF9515576.quest_desc: [
		"Confirm when your cellar holds sealed vessels with enough food for the whole team."
		"No food goes into any recipe or quest turn-in."
	]
	quest.3F8D45ADF9515576.title: "Winter Stores"
	quest.40280EBC4CC9F8F6.quest_desc: [
		"The signature item of Age 6: Information Age. Details appear when the Age before it is done."
	]
	quest.40280EBC4CC9F8F6.quest_subtitle: "Goal of Age 6: Information Age"
	quest.40280EBC4CC9F8F6.title: "Data Matrix"
	quest.40B43DE8640EAB9B.quest_desc: [
		"Mining raw stone can collapse the ceiling. Support beams come with the Bronze Age."
	]
	quest.40B43DE8640EAB9B.title: "Cave-ins"
	quest.41B46B0D9C0E8AB4.quest_desc: ["Sphalerite pieces point to a zinc vein. Create needs zinc."]
	quest.41B46B0D9C0E8AB4.title: "Zinc on the Surface"
	quest.4207F8051EF451B3.quest_desc: [
		"Fire is tamed. Clay is yours now, and with it pottery, molds and copper."
		""
		"Four strands lead to the Hearthstone: Fire & Clay, First Metal, Camp, and Hearth & Shrine."
		"The last one raises the shrine where the Hearthstone is offered to Caelum."
	]
	quest.4207F8051EF451B3.quest_subtitle: "Age 0"
	quest.4207F8051EF451B3.title: "Welcome to the Stone Age"
	quest.420FA4D7877D2196.quest_desc: ["Pour copper into the pickaxe head mold."]
	quest.420FA4D7877D2196.title: "Pickaxe Head"
	quest.4304B6AA00C231E8.quest_desc: [
		"Only the andesite tier of Create exists now: water wheels, saws, presses, fans and mills."
		"Crushing wheels, deployers and brass machines come with the Iron Age."
	]
	quest.4304B6AA00C231E8.title: "Create in the Bronze Age"
	quest.4573A3F0CD529A5B.quest_desc: ["Knap clay into the shape of the hearth idol."]
	quest.4573A3F0CD529A5B.title: "Unfired Hearth Idol"
	quest.4581C5CB23AD4CD5.quest_desc: [
		"The signature item of Dawn. Details appear when the Age before it is done."
	]
	quest.4581C5CB23AD4CD5.quest_subtitle: "Goal of Dawn"
	quest.4581C5CB23AD4CD5.title: "The First Spark"
	quest.4901966F799B2493.quest_desc: [
		"Lanterns float over swamps at night. Look, then decide whether to hunt them."
	]
	quest.4901966F799B2493.title: "Lights in the Swamp"
	quest.49153BBE2AD958B7.quest_desc: [
		"You wake up with nothing. No pickaxe, no clay, no fire."
		""
		"Dawn has three strands: Stone, Shelter and Hunt. Split them between you."
		"When all three keystones are done, light the first fire. That is the goal of Dawn,"
		"and it opens the Stone Age for the whole team."
	]
	quest.49153BBE2AD958B7.quest_subtitle: "The prologue before the first Age"
	quest.49153BBE2AD958B7.title: "Welcome to the Wild"
	quest.492F1E68565B651C.quest_desc: [
		"Precision Prospecting shows the direction and size of a vein."
	]
	quest.492F1E68565B651C.title: "Mineral Prospector"
	quest.4A34D752E7A4B499.quest_desc: [
		"A large vessel stores food. Sealed, it slows decay. Food decay is real in this pack."
	]
	quest.4A34D752E7A4B499.title: "Stocked Camp"
	quest.4C78408E6835BC56.quest_desc: [
		"Hunt an animal. Large prey drops large hides; carry a knife to butcher it."
	]
	quest.4C78408E6835BC56.title: "Hunter"
	quest.4D29DE0763D2A602.quest_desc: [
		"A fired jug carries fresh water. Drink from it when you are away from rivers."
	]
	quest.4D29DE0763D2A602.title: "Fresh Water"
	quest.4F85BB08A2142E6A.quest_desc: [
		"Carve a flute. Totemic ceremonies and totem poles give the camp some flair."
	]
	quest.4F85BB08A2142E6A.title: "Totemic"
	quest.50299FDC54036A8A.quest_desc: ["Craft a quern and a handstone."]
	quest.50299FDC54036A8A.title: "The Grind"
	quest.5298B856BFEE50A2.quest_desc: [
		"Craft the Hearthstone: the fired hearth idol, copper ingots and charcoal."
		""
		"Lay it on the plinth of the Hearth Circle (use it on the plinth or on the heart)."
		"Kindle the heart with a firestarter. Then sneak and hold use on the heart with an empty hand"
		"and pray until Caelum answers. Friends who pray with you make it faster."
		""
		"Caelum keeps the Hearthstone as a relic and opens the Bronze Age for the whole team."
	]
	quest.5298B856BFEE50A2.quest_subtitle: "Goal of the Stone Age: Caelum opens the Bronze Age"
	quest.5298B856BFEE50A2.title: "Offer the Hearthstone at the Shrine"
	quest.53348C90243DE4F0.quest_desc: [
		"Everybody on the server is in the same FTB team. Quest progress, Ages and rewards are shared."
		"Split the strands between you: one friend smiths, one prospects, one builds."
	]
	quest.53348C90243DE4F0.title: "One Team"
	quest.55D7F2DF060D309F.quest_desc: ["Carry the rotation to your machines."]
	quest.55D7F2DF060D309F.title: "Shafts and Cogs"
	quest.573FF798650E3338.quest_desc: [
		"Firmament Ages is a TerraFirmaCraft pack in Ages: Dawn, then Age 0 to Age 9."
		"The whole server is one team with one shared progress."
		""
		"Press K to open this quest screen at any time. There is no quest book item."
	]
	quest.573FF798650E3338.quest_subtitle: "Read me first"
	quest.573FF798650E3338.title: "Welcome to Firmament Ages"
	quest.586717CB0F9BF963.quest_desc: [
		"In the Stone Age your team raises one shrine: a heart of fired clay in a circle of stone,"
		"logs and thatch. It is the hearth of the whole server and the altar of Caelum, the Firmament:"
		"the sky that watches every fire lit beneath it, and opens one layer for every gift."
		""
		"Every Age from the Stone Age on ends at the shrine. Add the Age's ring, lay its signature item"
		"on the new plinth and pray. Caelum answers with light and a word, keeps the gift as a relic"
		"and opens the next Age for everyone."
	]
	quest.586717CB0F9BF963.title: "The Shrine and Caelum"
	quest.5C8E39BBE00603BA.quest_desc: [
		"Nine signature items, one Singularity, one gate. The end of the road."
	]
	quest.5C8E39BBE00603BA.quest_subtitle: "Defeat the final boss beyond the Stargate"
	quest.5C8E39BBE00603BA.title: "Beyond the Firmament"
	quest.5CC2939838550FB5.quest_desc: [
		"Feed a wild animal to familiarize it. Tame animals are the start of a farm."
	]
	quest.5CC2939838550FB5.title: "A New Friend"
	quest.5D192D80646308F9.quest_desc: ["Bring home a raw hide. A large one makes the thatch bed."]
	quest.5D192D80646308F9.title: "Raw Hide"
	quest.5D31E5FF6DE9E042.quest_desc: ["Create trains and Steam 'n' Rails connect distant mines."]
	quest.5D31E5FF6DE9E042.title: "Trains"
	quest.5DB9500F2C943C21.quest_desc: ["A metal giant waits in a deep chamber. Strike its back."]
	quest.5DB9500F2C943C21.title: "Ferrous Wroughtnaut"
	quest.61EE57DC75EED266.quest_desc: [
		"Feed the bloomery by machine and collect 32 wrought iron ingots from the line."
	]
	quest.61EE57DC75EED266.title: "Automated Bloomery Line"
	quest.63A45BCAE3254E00.quest_desc: [
		"Fell a tree with your stone axe. With axe, knife, hammer and shovel you have a full stone kit."
	]
	quest.63A45BCAE3254E00.title: "Stone Kit"
	quest.640D444A5C7F6051.quest_desc: [
		"From the Iron Age the FTB Chunks map and minimap work. Claims and chunk loading come later."
	]
	quest.640D444A5C7F6051.title: "The Map Opens"
	quest.6522D484BFB67425.quest_desc: [
		"Knap a tool head from two rocks and put it on a stick in the crafting grid."
		"An axe comes first. A knife, a hammer and a shovel follow the same way."
	]
	quest.6522D484BFB67425.title: "Paleolithic!"
	quest.652657C4C5B8CAC5.quest_desc: [
		"The signature item of Age 2: Iron Age. Details appear when the Age before it is done."
	]
	quest.652657C4C5B8CAC5.quest_subtitle: "Goal of Age 2: Iron Age"
	quest.652657C4C5B8CAC5.title: "Steel Heart"
	quest.663A4EAE1B3FAF8C.quest_desc: [
		"The signature item of Age 4: Industrial Age. Details appear when the Age before it is done."
	]
	quest.663A4EAE1B3FAF8C.quest_subtitle: "Goal of Age 4: Industrial Age"
	quest.663A4EAE1B3FAF8C.title: "Pressure Core"
	quest.66EDA08DBD082046.quest_desc: [
		"Saw support beams and place them in your mine. They stop cave-ins nearby."
	]
	quest.66EDA08DBD082046.title: "Hold the Ceiling"
	quest.6A80066F26918539.quest_desc: [
		"Dig a 2x2 pool of water ringed by grass or dirt, put flowers around it and throw polished quartz into"
		"the water. Polished quartz comes from the quartz veins of the Iron Age, polished with sandpaper."
		"Step through."
	]
	quest.6A80066F26918539.title: "Into the Twilight"
	quest.6ABCB02049FE872B.quest_desc: ["Knap and fire a crucible. It mixes metals into alloys."]
	quest.6ABCB02049FE872B.title: "The Crucible"
	quest.6C112D72835F57BD.quest_desc: [
		"Crushing wheels turn ore pieces into dust for more metal per ore."
	]
	quest.6C112D72835F57BD.title: "Crushing Wheels"
	quest.6DE0808A3F92C2E7.quest_desc: [
		"Put the head on a stick. Your first pickaxe: now you can mine."
	]
	quest.6DE0808A3F92C2E7.title: "Copper Pickaxe"
	quest.6DE17D691978916D.quest_desc: [
		"Soak a hide in limewater, scrape it, then soak it in tannin."
	]
	quest.6DE17D691978916D.title: "Genuine Leather"
	quest.6E4438CCF1A5BF3D.quest_desc: ["The Lich drops its trophy. The Steel Heart needs it."]
	quest.6E4438CCF1A5BF3D.title: "Lich Trophy"
	quest.70CBE25D834EEF9F.quest_desc: ["Climb the Lich tower and defeat the Lich."]
	quest.70CBE25D834EEF9F.title: "The Lich"
	quest.71B6B8FAE5353DAB.quest_desc: [
		"Build a charcoal forge: charcoal on the ground, surrounded by stone."
	]
	quest.71B6B8FAE5353DAB.title: "Forging"
	quest.724BED62EE9DF8FB.quest_desc: [
		"Craft a firestarter from two sticks. Throw a log, three sticks and some straw on one block"
		"and hold use on it with the firestarter until the firepit lights."
		""
		"Fire opens the Stone Age for the whole team: clay, pit kilns and the first copper."
	]
	quest.724BED62EE9DF8FB.quest_subtitle: "Goal of Dawn: grants the Stone Age"
	quest.724BED62EE9DF8FB.title: "The First Spark"
	quest.72FDA51E1B8B0984.quest_desc: [
		"Some rocks on the surface are ore. Remember where you found them."
	]
	quest.72FDA51E1B8B0984.title: "A Weird Rock"
	quest.7448E77754C5FDAD.quest_desc: [
		"Till soil with a hoe and plant the seeds. Crops need water and time."
	]
	quest.7448E77754C5FDAD.title: "First Field"
	quest.7594B03DF7F3FE55.quest_desc: [
		"Build a bloomery from bronze double sheets and stone bricks."
	]
	quest.7594B03DF7F3FE55.title: "Ironworks"
	quest.759550A45990B3C8.quest_desc: [
		"Fill the small vessel with copper ore, heat it until the copper melts,"
		"then pour it into the ingot mold."
	]
	quest.759550A45990B3C8.title: "Copper Ingot"
	quest.7755ECDE0FFE3821.quest_desc: [
		"Fire a second Hearth Idol and set it in four cobblestone under a charcoal:"
		"that is the Shrine Heart."
		"Place it where your team wants its shrine. There is only one shrine in the world,"
		"and every later Age adds a ring around it, so leave room: about 21 by 21 blocks."
	]
	quest.7755ECDE0FFE3821.title: "The Shrine Heart"
	quest.7794323527566501.quest_desc: ["Put a fired ceramic pot on the firepit and cook a soup."]
	quest.7794323527566501.title: "Pot Head"
	quest.7997DC1DFF73EA36.quest_desc: [
		"Stack logs in a log pile, cover it with earth and light it: a charcoal pit."
		"Charcoal burns hot enough for copper."
	]
	quest.7997DC1DFF73EA36.title: "A Better Fuel"
	quest.7CDF23C64D3D4961.quest_desc: [
		"Food rots. Sealed large vessels, salting, drying and cooking slow it down."
		"Eat from every food group: grain, fruit, vegetables, protein and dairy."
	]
	quest.7CDF23C64D3D4961.title: "Food Decay and Nutrition"
	quest.7E4228F48F8BE9EF.quest_desc: ["Knap five clay into a vessel, a jug, a bowl or a mold."]
	quest.7E4228F48F8BE9EF.title: "Clay Forming"
