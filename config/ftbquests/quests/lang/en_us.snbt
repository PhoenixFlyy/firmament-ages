	quest.1129C4816E846CCC.title: "Copper Wire"
	quest.11D75C261FA24AE3.quest_desc: ["A wrought iron anvil can work steel."]
	quest.11D75C261FA24AE3.title: "Iron Anvil"
	quest.124DDC9853158E78.quest_desc: [
		"Thresher, grist mill, beamhouse, fleshing machine and power loom take over the TFC hand work."
	]
	quest.124DDC9853158E78.title: "Advanced TFC Tech"
	quest.12AA975B971EC62B.quest_desc: ["Native osmium is a TFC-style vein from this Age."]
	quest.12AA975B971EC62B.title: "Osmium"
	quest.12F2B758B0EC78AC.quest_desc: [
		"The arc furnace melts, alloys and makes steel with graphite electrodes."
		"It takes over from the alloy kiln."
	]
	quest.12F2B758B0EC78AC.title: "Arc Furnace"
	quest.136A6DB3C34D16EB.quest_desc: [
		"Steam engines on a boiler give far more force than water wheels."
	]
	quest.136A6DB3C34D16EB.title: "Steam Engine"
	quest.139C6E2EB6E5944E.quest_desc: ["A blank model learns one mob."]
	quest.139C6E2EB6E5944E.title: "Data Model"
	quest.15070FF77006AFB6.quest_desc: [
		"Polonium from your reactor waste: two pellets. One is the catalyst of the Star Chart."
	]
	quest.15070FF77006AFB6.title: "Reactor Online"
	quest.153E204EC2BA3ACA.quest_desc: [
		"Place two thatch blocks side by side and use a large raw hide on them."
		"The thatch bed sets your spawn point. You cannot sleep through the night in it."
		"Large hides come from large animals: the Hunt strand gets them."
	]
	quest.153E204EC2BA3ACA.title: "Shelter"
	quest.155AA2A2258BDD49.quest_desc: ["Test yourself against Ignis before the final battle."]
	quest.155AA2A2258BDD49.title: "Ignis"
	quest.15673B5A9807871D.quest_desc: [
		"The excavator digs the mineral mixes of a chunk forever: an endless ore source."
	]
	quest.15673B5A9807871D.title: "Excavator"
	quest.156E48BCD0889C5E.quest_desc: [
		"Lubricant speeds up IE machines through the automatic lubricator."
	]
	quest.156E48BCD0889C5E.title: "Lubricant"
	quest.157E197DE71E5ECA.quest_desc: [
		"Weld copper double ingots into a copper anvil. Tools and sheets are smithed on it."
	]
	quest.157E197DE71E5ECA.title: "Copper Anvil"
	quest.15AD3FABD5A6F24F.quest_desc: [
		"Uraninite veins are visible now. Process the ore into yellow cake."
	]
	quest.15AD3FABD5A6F24F.title: "Yellow Cake"
	quest.15E3FB7395A86F61.quest_desc: [
		"Soak planks in creosote. Treated wood is the frame of every IE machine."
	]
	quest.15E3FB7395A86F61.title: "Treated Wood"
	quest.1628C003B7759E11.quest_desc: ["Land on Glacio."]
	quest.1628C003B7759E11.title: "Glacio"
	quest.1661C5530B8C2FE2.quest_desc: [
		"The Umvuthana chief rules a grove in hot biomes. Defeat Umvuthi for the Sol Visage."
	]
	quest.1661C5530B8C2FE2.title: "Umvuthi"
	quest.16669304CEE25FCB.quest_desc: [
		"Defeat the Harbinger. Its witherite block goes into the Star Chart."
	]
	quest.16669304CEE25FCB.title: "The Harbinger"
	quest.166C4569CC75A30A.quest_desc: [
		"Firmalife adds ovens, cheese, drying and more. A drying mat is the first step."
	]
	quest.166C4569CC75A30A.title: "Kitchen"
	quest.16708A1C39158F9C.quest_desc: [
		"In Dawn you cannot dig clay, build pit kilns or use metal."
